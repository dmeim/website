---
import ContactTile from "./bento/ContactTile.astro";
import IntroTile from "./bento/IntroTile.astro";
import KeysTile from "./bento/KeysTile.astro";
import NowTile from "./bento/NowTile.astro";
import PortraitTile from "./bento/PortraitTile.astro";
import StackTile from "./bento/StackTile.astro";
import StatsTile from "./bento/StatsTile.astro";
import ToolsMarqueeTile from "./bento/ToolsMarqueeTile.astro";
---

<div class="container hero">
  <div class="bento" data-reveal-group>
    <IntroTile />
    <PortraitTile />
    <NowTile />
    <StatsTile />
    <KeysTile />
    <StackTile />
    <ContactTile />
    <ToolsMarqueeTile />
  </div>
</div>

<script>
  import { initSpotlight } from "./scripts/interactions";
  initSpotlight();
</script>

<style>
  .hero {
    padding-top: var(--s-4);
  }

  @media (min-width: 720px) {
    .hero {
      padding-top: var(--s-6);
    }
  }

  /* Mobile: one column in reading order. */
  .bento {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      "intro"
      "portrait"
      "stats"
      "now"
      "tools"
      "keys"
      "stack"
      "contact";
    gap: var(--s-3);
  }

  .bento :global(.bento__intro) {
    grid-area: intro;
  }
  .bento :global(.bento__portrait) {
    grid-area: portrait;
  }
  .bento :global(.bento__now) {
    grid-area: now;
  }
  .bento :global(.bento__stats) {
    grid-area: stats;
  }
  .bento :global(.bento__keys) {
    grid-area: keys;
  }
  .bento :global(.bento__stack) {
    grid-area: stack;
  }
  .bento :global(.bento__contact) {
    grid-area: contact;
  }
  .bento :global(.bento__tools) {
    grid-area: tools;
  }

  /* Tablet: six columns, portrait beside the intro. */
  @media (min-width: 720px) {
    .bento {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-template-areas:
        "intro intro intro intro portrait portrait"
        "intro intro intro intro portrait portrait"
        "now now now stats stats stats"
        "tools tools tools tools tools tools"
        "keys keys keys keys keys keys"
        "stack stack stack contact contact contact";
      grid-template-rows: auto minmax(160px, auto);
      gap: var(--s-4);
    }
  }

  /* Desktop: twelve columns. */
  @media (min-width: 1100px) {
    .bento {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-areas:
        "intro intro intro intro intro intro intro portrait portrait portrait portrait portrait"
        "intro intro intro intro intro intro intro portrait portrait portrait portrait portrait"
        "now now now now stats stats stats portrait portrait portrait portrait portrait"
        "keys keys keys keys keys stack stack stack contact contact contact contact"
        "tools tools tools tools tools tools tools tools tools tools tools tools";
      grid-template-rows: auto auto auto auto auto;
    }
  }
</style>
