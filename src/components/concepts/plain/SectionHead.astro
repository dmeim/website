---
import { ArrowRight } from "@lucide/astro";

interface Props {
  id: string;
  title: string;
  intro?: string;
  link?: { label: string; href: string };
}

const { id, title, intro, link } = Astro.props;
---

<div class="pl-head" data-reveal>
  <div>
    <h2 id={id}>{title}</h2>
    {intro && <p>{intro}</p>}
  </div>
  {
    link && (
      <a class="pl-link" href={link.href}>
        {link.label}
        <ArrowRight aria-hidden="true" />
      </a>
    )
  }
</div>
