---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  id: string;
  lede?: string;
}

const { index, eyebrow, title, id, lede } = Astro.props;
---

<header class="section-head" data-reveal>
  <div>
    <p class="eyebrow"><span class="index-num">{index}</span> — {eyebrow}</p>
    <h2 class="display section-head__title" id={id}>{title}</h2>
    {lede && <p class="section-head__lede">{lede}</p>}
  </div>
  {Astro.slots.has("default") && <div class="section-head__aside"><slot /></div>}
</header>
