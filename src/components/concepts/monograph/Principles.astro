---
import { mentorQuote, pedagogy } from "../../../content/site";
import AccordionItem from "./AccordionItem.astro";
---

<section class="mg-principles mg-section" id="principles" aria-labelledby="mg-principles-title">
  <div class="mg-container">
    <div class="mg-principles__grid">
    <header class="mg-section-head mg-principles__head" data-reveal-group>
      <p class="mg-label" data-reveal><span class="mg-label__num">04</span>Principles</p>
      <h2 class="mg-display mg-display--md" id="mg-principles-title" data-reveal>
        How the work <em>is made</em>
      </h2>
    </header>

    <div class="mg-principles__list" data-reveal>
      {
        pedagogy.map((item, i) => (
          <AccordionItem
            id={`mg-principle-${i}`}
            index={String(i + 1).padStart(2, "0")}
            title={item.title}
            open={i === 0}
          >
            <p>{item.body}</p>
          </AccordionItem>
        ))
      }
    </div>
    </div>

    <figure class="mg-quote" data-reveal>
      <span class="mg-rule mg-quote__rule" aria-hidden="true"></span>
      <blockquote>
        <p>“{mentorQuote.text}”</p>
      </blockquote>
      {mentorQuote.attribution && <figcaption class="mg-label mg-label--gold">{mentorQuote.attribution}</figcaption>}
      <span class="mg-rule mg-quote__rule" aria-hidden="true"></span>
    </figure>
  </div>
</section>

<style>
  .mg-principles__head h2 {
    max-width: 9ch;
  }

  @media (min-width: 1000px) {
    .mg-principles__grid {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: clamp(48px, 6vw, 120px);
      align-items: start;
    }

    .mg-principles__head {
      position: sticky;
      top: calc(var(--mg-header-h) + 32px);
      margin-bottom: 0;
    }
  }

  .mg-principles__list {
    border-top: 1px solid var(--mg-line);
  }

  .mg-quote {
    display: grid;
    justify-items: center;
    gap: clamp(28px, 3vw, 40px);
    margin: clamp(120px, 16vw, 220px) auto 0;
    max-width: 1100px;
    text-align: center;
  }

  .mg-quote__rule {
    width: min(160px, 30vw);
  }

  .mg-quote blockquote {
    font-family: var(--mg-font-display);
    font-style: italic;
    font-size: clamp(1.875rem, 1.1rem + 3vw, 4rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
</style>
