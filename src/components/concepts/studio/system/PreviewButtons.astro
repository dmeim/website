---
import { ArrowRight, ArrowUpRight, Check, Download, Plus, Settings2 } from "@lucide/astro";
import PreviewPanel from "./PreviewPanel.astro";
---

<PreviewPanel title="Button" note="pill · 44 / 36px">
  <div class="row">
    <button type="button" class="btn btn--primary">
      Primary <ArrowRight class="btn__arrow" aria-hidden="true" />
    </button>
    <button type="button" class="btn btn--secondary">
      Secondary <ArrowUpRight class="btn__arrow--diag" aria-hidden="true" />
    </button>
    <button type="button" class="btn btn--ghost">Ghost</button>
  </div>
  <div class="row">
    <button type="button" class="btn btn--gold">
      <Plus aria-hidden="true" /> Gold accent
    </button>
    <button type="button" class="btn btn--secondary btn--icon" aria-label="Settings">
      <Settings2 aria-hidden="true" />
    </button>
    <button type="button" class="btn btn--primary" disabled>Disabled</button>
  </div>
  <div class="row">
    <button type="button" class="btn btn--primary btn--sm loading-demo" data-loading-demo>
      <span class="loading-demo__idle"><Download aria-hidden="true" /> Export keys</span>
      <span class="loading-demo__busy" aria-hidden="true"><span class="spinner"></span> Exporting…</span>
      <span class="loading-demo__done" aria-hidden="true"><Check aria-hidden="true" /> Exported</span>
    </button>
    <span class="mono hint">← click for loading state</span>
  </div>
</PreviewPanel>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-loading-demo]").forEach((button) => {
    button.addEventListener("click", () => {
      if (button.dataset.state) return;
      button.dataset.state = "busy";
      button.setAttribute("aria-busy", "true");
      window.setTimeout(() => {
        button.dataset.state = "done";
        button.removeAttribute("aria-busy");
        window.setTimeout(() => delete button.dataset.state, 1400);
      }, 1600);
    });
  });
</script>

<style>
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
  }

  .hint {
    font-size: 11.5px;
    color: var(--ink-faint);
  }

  .loading-demo {
    display: inline-grid;
    min-width: 150px;
  }

  .loading-demo > span {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    transition:
      opacity var(--dur-fast) var(--ease),
      translate var(--dur) var(--ease);
  }

  .loading-demo__busy,
  .loading-demo__done,
  .loading-demo[data-state] .loading-demo__idle {
    opacity: 0;
    translate: 0 6px;
  }

  .loading-demo[data-state="busy"] .loading-demo__busy,
  .loading-demo[data-state="done"] .loading-demo__done {
    opacity: 1;
    translate: 0 0;
  }

  .loading-demo[data-state="busy"] {
    cursor: progress;
  }
</style>
