---
import type { HTMLAttributes } from "astro/types";
import Stat from "./Stat.astro";

type StatProps = {
  label: string;
  value: string | number;
  size?: "md" | "lg" | "xl";
  mono?: boolean;
  hint?: string;
  live?: boolean;
};

interface Props extends HTMLAttributes<"div"> {
  items?: StatProps[];
  columns?: "auto" | 2 | 3 | 4;
}

const { items, columns = "auto", class: className, ...rest } = Astro.props;
---

<div {...rest} class:list={["ui-stat-grid", className]} data-columns={columns}>
  {items ? items.map((item) => <Stat {...item} />) : <slot />}
</div>
