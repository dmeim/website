---
/**
 * Mono tag. `tone` maps project status to a marker; plain tags have none.
 */
type Tone = "plain" | "live" | "wip" | "archived";

interface Props {
  tone?: Tone;
}

const { tone = "plain" } = Astro.props;
---

<span class:list={["tag", `tag--${tone}`]}>
  {tone !== "plain" && <span class="tag__mark" aria-hidden="true"></span>}
  <slot />
</span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 1.5rem;
    padding: 0 0.5rem;
    border: 1px solid var(--l-line-strong);
    font-family: var(--l-mono);
    font-size: var(--l-text-2xs);
    letter-spacing: var(--l-track-mono);
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--l-ink-muted);
  }

  .tag__mark {
    width: 6px;
    height: 6px;
    flex: none;
  }

  .tag--live {
    color: var(--l-ink);
    border-color: var(--l-ink);
  }

  .tag--live .tag__mark {
    background: var(--l-gold);
  }

  .tag--wip .tag__mark {
    border: 1px solid var(--l-gold);
    background: linear-gradient(90deg, var(--l-gold) 50%, transparent 50%);
  }

  .tag--archived {
    border-style: dashed;
  }

  .tag--archived .tag__mark {
    border: 1px solid var(--l-ink-muted);
  }
</style>
