---
/** About and Now: the only prose on the page, kept to a few sentences. */
import { currentChapter, shortBio } from "../../../content/site";
import Section from "./Section.astro";
import Row from "./Row.astro";

const sentences = shortBio.split(/(?<=\.)\s+/);
const lead = sentences.slice(0, 2).join(" ");
const follow = sentences[2] ?? "";
// Only the first sentence of the chapter body is current; the rest is stale.
const nowLine = currentChapter.body.split(/(?<=\.)\s+/)[0];
---

<Section id="about" title="About" spy="now">
  <div class="p-about">
    <p class="p-about__lead" data-reveal>{lead}</p>
    {follow && <p class="p-about__more" data-reveal>{follow}</p>}
  </div>
</Section>

<Section id="now" title="Now" spy="now">
  <ul class="p-list">
    <Row label="Current" title={currentChapter.title} desc={nowLine} />
  </ul>
</Section>

<style>
  .p-about {
    display: grid;
    gap: 1rem;
    max-width: 36rem;
  }

  .p-about__lead {
    font-size: 1.125rem;
    line-height: 1.6;
    letter-spacing: -0.005em;
  }

  .p-about__more {
    color: var(--p-muted);
  }
</style>
