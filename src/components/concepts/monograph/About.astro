---
import { Image } from "astro:assets";
import portrait from "../../../../assets/images/photoshoot/gpt-sitting-transparent.png";
import { currentChapter, venues } from "../../../content/site";
---

<section class="mg-about mg-invert" id="about" data-band="invert" data-mg-about aria-labelledby="mg-about-title">
  <div class="mg-container mg-about__grid">
    <figure class="mg-about__plate" data-reveal>
      <div class="mg-about__photo" data-mg-about-photo>
        <Image
          src={portrait}
          alt="Dimitri seated on a stool, in a black suit, smiling at the camera"
          widths={[400, 640, 900]}
          sizes="(min-width: 900px) 38vw, 92vw"
        />
      </div>
      <figcaption class="mg-label">Plate II <span aria-hidden="true">—</span> Dimitri</figcaption>
    </figure>

    <div class="mg-about__copy" data-reveal-group>
      <p class="mg-label" data-reveal><span class="mg-label__num">03</span>{currentChapter.eyebrow}</p>
      <h2 class="mg-display mg-display--md" id="mg-about-title" data-reveal>
        Building <em>dmeim.com</em> in public
      </h2>
      <span class="mg-rule mg-about__rule" data-reveal aria-hidden="true"></span>
      <p class="mg-about__body" data-reveal>{currentChapter.body}</p>

      <dl class="mg-about__list" data-reveal>
        {
          venues.map((v) => (
            <div>
              <dt>{v.name}</dt>
              <dd class="mg-label">{v.place}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .mg-about {
    --c: 0;
    position: relative;
    padding-block: clamp(96px, 12vw, 180px);
    clip-path: inset(calc(var(--c) * 12svh) calc(var(--c) * 7vw) 0);
  }

  .mg-about__grid {
    display: grid;
    gap: clamp(48px, 6vw, 96px);
    align-items: center;
  }

  .mg-about__plate {
    display: grid;
    gap: 14px;
  }

  .mg-about__photo {
    position: relative;
    overflow: clip;
    aspect-ratio: 4 / 5;
    background: var(--mg-plate);
  }

  .mg-about__photo :global(img) {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 92%;
    height: auto;
    transform: translate3d(-50%, calc(var(--c) * 10%), 0);
  }

  .mg-about__copy {
    display: grid;
    gap: 28px;
    align-content: center;
  }

  .mg-about__rule {
    width: 72px;
  }

  .mg-about__body {
    font-size: var(--mg-text-lg);
    line-height: 1.65;
    color: var(--mg-ink-muted);
    max-width: 52ch;
    text-wrap: pretty;
  }

  .mg-about__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--mg-line);
    margin-top: 12px;
  }

  .mg-about__list > div {
    display: grid;
    gap: 4px;
    padding: 18px 16px 18px 0;
    border-bottom: 1px solid var(--mg-line);
  }

  .mg-about__list dt {
    font-family: var(--mg-font-display);
    font-size: 1.625rem;
    line-height: 1.1;
  }

  @media (min-width: 900px) {
    .mg-about__grid {
      grid-template-columns: 5fr 6fr;
    }

    .mg-about__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .mg-about__list > div + div {
      padding-left: 16px;
      border-left: 1px solid var(--mg-line);
    }
  }
</style>

<script>
  import { clamp, motionAllowed, onScrollFrame } from "./monograph-scroll";

  const band = document.querySelector<HTMLElement>("[data-mg-about]");
  if (band && motionAllowed()) {
    let last = -1;
    onScrollFrame(() => {
      const top = band.getBoundingClientRect().top;
      const vh = window.innerHeight;
      // 1 while the band's top is at the bottom edge, 0 once it reaches the top fifth.
      const c = clamp((top - vh * 0.2) / (vh * 0.8));
      if (Math.abs(c - last) < 0.001) return;
      last = c;
      band.style.setProperty("--c", c.toFixed(4));
    });
  }
</script>
