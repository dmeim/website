---
/**
 * Flat card: hairline frame, mono kicker, title, text, footer row.
 * The whole card is one link; the frame turns ink on hover.
 */
import { ArrowRight } from "@lucide/astro";

interface Props {
  href: string;
  kicker: string;
  title: string;
}

const { href, kicker, title } = Astro.props;
---

<a class="card" href={href}>
  <p class="card__kicker l-mono l-muted">{kicker}</p>
  <h3 class="card__title">{title}</h3>
  <div class="card__text l-muted"><slot /></div>
  <div class="card__foot">
    <slot name="meta" />
    <ArrowRight class="card__arrow" size={18} stroke-width={1.5} aria-hidden="true" />
  </div>
</a>

<style>
  .card {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--l-space-3);
    min-height: 16rem;
    padding: var(--l-space-5);
    border: 1px solid var(--l-line-strong);
    background: var(--l-ground);
    transition:
      border-color var(--l-dur) var(--l-ease),
      background-color var(--l-dur) var(--l-ease);
  }

  .card:hover {
    border-color: var(--l-ink);
    background: var(--l-surface);
  }

  .card__title {
    font-size: var(--l-text-lg);
    letter-spacing: -0.02em;
  }

  .card__text {
    font-size: var(--l-text-sm);
  }

  .card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--l-space-4);
    border-top: 1px solid var(--l-line);
  }

  .card :global(.card__arrow) {
    transition: transform var(--l-dur) var(--l-ease);
  }

  .card:hover :global(.card__arrow) {
    transform: translateX(4px);
  }
</style>
