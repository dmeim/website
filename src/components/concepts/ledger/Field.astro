---
/**
 * Labelled text field (input or textarea) with optional hint and error.
 * Hint and error are wired through aria-describedby.
 */
interface Props {
  id: string;
  label: string;
  hint?: string;
  error?: string;
  type?: "text" | "email";
  multiline?: boolean;
  placeholder?: string;
  value?: string;
  optional?: boolean;
}

const { id, label, hint, error, type = "text", multiline = false, placeholder, value, optional } = Astro.props;
const hintId = hint ? `${id}-hint` : undefined;
const errorId = error ? `${id}-error` : undefined;
const describedBy = [hintId, errorId].filter(Boolean).join(" ") || undefined;
---

<div class:list={["field", { "field--error": error }]}>
  <label class="field__label l-mono" for={id}>
    {label}
    {optional && <span class="l-muted">Optional</span>}
  </label>
  {
    multiline ? (
      <textarea
        class="field__control"
        id={id}
        rows="4"
        placeholder={placeholder}
        aria-describedby={describedBy}
        aria-invalid={error ? "true" : undefined}
      >{value}</textarea>
    ) : (
      <input
        class="field__control"
        id={id}
        type={type}
        placeholder={placeholder}
        value={value}
        aria-describedby={describedBy}
        aria-invalid={error ? "true" : undefined}
      />
    )
  }
  {hint && <p class="field__hint" id={hintId}>{hint}</p>}
  {error && <p class="field__error" id={errorId}>{error}</p>}
</div>

<style>
  .field {
    display: grid;
    gap: var(--l-space-2);
  }

  .field__label {
    display: flex;
    justify-content: space-between;
  }

  .field__control {
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--l-line-strong);
    border-radius: var(--l-radius);
    background: var(--l-ground);
    font-size: var(--l-text-base);
    line-height: 1.4;
    transition:
      border-color var(--l-dur-fast) var(--l-ease),
      background-color var(--l-dur-fast) var(--l-ease);
  }

  textarea.field__control {
    resize: vertical;
  }

  .field__control::placeholder {
    color: var(--l-ink-muted);
    opacity: 0.8;
  }

  .field__control:hover {
    border-color: var(--l-ink-muted);
  }

  .field__control:focus-visible {
    outline: 2px solid var(--l-gold);
    outline-offset: -1px;
    border-color: var(--l-gold);
  }

  .field__hint,
  .field__error {
    font-size: var(--l-text-xs);
    color: var(--l-ink-muted);
  }

  .field--error .field__control {
    border-color: var(--l-danger);
    box-shadow: inset 2px 0 0 var(--l-danger);
  }

  .field__error {
    color: var(--l-danger);
  }

  .field__error::before {
    content: "! ";
    font-family: var(--l-mono);
  }
</style>
