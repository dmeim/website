---
import QRCode from "qrcode";
import { cryptoWallets } from "@/content/site";
import { CopyButton, Dialog } from "@/ui/components";
import Icon from "@/ui/icons/Icon.astro";
import "./wallets.css";

/** One dialog per wallet, opened by `[data-ui-dialog-open="wallet-<id>"]`. QR SVGs render at build time. */
const wallets = await Promise.all(
  cryptoWallets.map(async (wallet) => ({
    ...wallet,
    qr: await QRCode.toString(wallet.address, {
      type: "svg",
      margin: 0,
      errorCorrectionLevel: "M",
      color: { dark: "#111110", light: "#00000000" },
    }),
  })),
);
---

{
  wallets.map(({ id, name, icon, address, alsoAccepts, qr }) => (
    <Dialog id={`wallet-${id}`} title={name} titleIcon={icon} size="sm" class="wallet-dialog">
      <div class="wallet-dialog__qr" role="img" aria-label={`QR code for the ${name} address`} set:html={qr} />
      <div class="wallet-dialog__address">
        <code>{address}</code>
        <CopyButton value={address} size="sm" label="Copy address" />
      </div>
      {
        alsoAccepts && (
          <p class="wallet-dialog__also">
            {alsoAccepts.map((token, i) => (
              <>
                {i > 0 && (i < alsoAccepts.length - 1 ? ", " : alsoAccepts.length > 2 ? ", and " : " and ")}
                <span class="wallet-dialog__token">
                  <Icon name={token.icon} />
                  {token.ticker} ({name})
                </span>
              </>
            ))}{" "}
            also accepted
          </p>
        )
      }
    </Dialog>
  ))
}
