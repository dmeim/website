---
/**
 * Concept 5 — "Profile": a calm two-pane professional profile. Sticky
 * identity column, list-based content column. Review-only route.
 */
import ConceptLayout from "../layouts/ConceptLayout.astro";
import "../components/concepts/profile/profile.css";
import Identity from "../components/concepts/profile/Identity.astro";
import Intro from "../components/concepts/profile/Intro.astro";
import Work from "../components/concepts/profile/Work.astro";
import Tools from "../components/concepts/profile/Tools.astro";
import Principles from "../components/concepts/profile/Principles.astro";
import Keys from "../components/concepts/profile/Keys.astro";
import Contact from "../components/concepts/profile/Contact.astro";
import SystemPreview from "../components/concepts/profile/SystemPreview.astro";
---

<ConceptLayout
  title="Profile"
  description="Concept 5 for dmeim.com — a calm two-pane professional profile."
  concept={5}
  fontsHref="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400..600;1,14..32,400&display=swap"
>
  <a class="p-skip" href="#main">Skip to content</a>
  <div class="p-shell">
    <Identity />
    <main class="p-main" id="main">
      <Intro />
      <Work />
      <Tools />
      <Principles />
      <Keys />
      <Contact />
      <SystemPreview />
    </main>
  </div>
</ConceptLayout>
