---
import { ArrowRight } from "@lucide/astro";
import type { ProjectItem } from "../../../content/site";
import StatusBadge from "./StatusBadge.astro";
import Tile from "./Tile.astro";

interface Props {
  project: ProjectItem;
  reveal?: boolean;
}

const { project, reveal = true } = Astro.props;
const external = project.href?.startsWith("http");
---

<Tile
  as={project.href ? "a" : "article"}
  href={project.href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class="project-card"
  pressable={Boolean(project.href)}
  reveal={reveal}
  data-status={project.status}
>
  <div class="project-card__top">
    <StatusBadge status={project.status} />
    {
      project.href ? (
        <span class="project-card__arrow" aria-hidden="true">
          <ArrowRight />
        </span>
      ) : (
        <span class="project-card__soon mono">Write-up soon</span>
      )
    }
  </div>
  <h3 class="display project-card__title">
    {project.title}
    {external && <span class="sr-only">(opens in a new tab)</span>}
  </h3>
  <p class="project-card__summary">{project.summary}</p>
  <ul class="project-card__tags" aria-label="Tags">
    {project.tags.map((tag) => <li class="chip chip--sm">{tag}</li>)}
  </ul>
</Tile>

<style>
  :global(.tile.project-card) {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    min-height: 240px;
  }

  .project-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--s-6);
  }

  .project-card__arrow {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--ink-muted);
    transition:
      rotate var(--dur) var(--ease-spring),
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .project-card__arrow :global(svg) {
    width: 16px;
    height: 16px;
  }

  :global(.project-card:hover) .project-card__arrow,
  :global(.project-card:focus-visible) .project-card__arrow {
    rotate: -45deg;
    border-color: transparent;
    background: var(--gold);
    color: var(--on-gold);
  }

  .project-card__soon {
    font-size: 11.5px;
    color: var(--ink-faint);
  }

  .project-card__title {
    font-size: 22px;
    letter-spacing: -0.025em;
  }

  .project-card__summary {
    max-width: 52ch;
    color: var(--ink-muted);
    font-size: 14.5px;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    padding-top: var(--s-4);
  }
</style>
