---
import { Check, Copy } from "@lucide/astro";

interface Props {
  value: string;
  /** Names what is copied for assistive tech, e.g. "Copy SSH fingerprint". */
  label?: string;
}

const { value, label = "Copy" } = Astro.props;
---

<button type="button" class="pl-btn pl-btn--sm pl-copy" data-pl-copy={value} aria-label={label}>
  <span class="pl-copy__icons" aria-hidden="true">
    <Copy class="pl-copy__icon pl-copy__icon--copy" />
    <Check class="pl-copy__icon pl-copy__icon--check" />
  </span>
  <span class="pl-copy__text" aria-hidden="true" data-pl-copy-text>Copy</span>
  <span class="pl-sr-only" role="status" data-pl-copy-status></span>
</button>

<style>
  .pl-copy {
    gap: 8px;
  }

  .pl-copy__icons {
    position: relative;
    width: 16px;
    height: 16px;
  }

  .pl-copy :global(.pl-copy__icon) {
    position: absolute;
    inset: 0;
    transition:
      opacity var(--pl-fast) var(--pl-ease),
      transform var(--pl-fast) var(--pl-ease);
  }

  .pl-copy :global(.pl-copy__icon--check) {
    opacity: 0;
    transform: scale(0.6);
    color: var(--pl-gold);
  }

  .pl-copy[data-state="copied"] :global(.pl-copy__icon--copy) {
    opacity: 0;
    transform: scale(0.6);
  }

  .pl-copy[data-state="copied"] :global(.pl-copy__icon--check) {
    opacity: 1;
    transform: none;
  }

  /* Width stays put while the label swaps so neighbours never shift. */
  .pl-copy__text {
    display: inline-block;
    min-width: 3.4em;
    text-align: left;
  }
</style>

<script>
  const RESET_MS = 1800;

  document.querySelectorAll<HTMLButtonElement>("[data-pl-copy]").forEach((button) => {
    const text = button.querySelector<HTMLElement>("[data-pl-copy-text]");
    const status = button.querySelector<HTMLElement>("[data-pl-copy-status]");
    let timer = 0;

    const show = (state: "copied" | "failed"): void => {
      button.dataset.state = state;
      if (text) text.textContent = state === "copied" ? "Copied" : "Failed";
      if (status) {
        status.textContent =
          state === "copied" ? "Copied to clipboard" : "Copy failed. Select the text and copy it manually.";
      }
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        delete button.dataset.state;
        if (text) text.textContent = "Copy";
        if (status) status.textContent = "";
      }, RESET_MS);
    };

    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.plCopy ?? "");
        show("copied");
      } catch (error) {
        console.warn("[plain] clipboard write failed", error);
        show("failed");
      }
    });
  });
</script>
