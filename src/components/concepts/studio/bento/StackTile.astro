---
import { Layers } from "@lucide/astro";
import { venues } from "../../../../content/site";
import Tile from "../Tile.astro";
---

<Tile as="section" class="bento__stack stack" aria-labelledby="stack-title">
  <p class="eyebrow" id="stack-title">
    <Layers class="stack__icon" aria-hidden="true" />
    Stack
  </p>
  <p class="stack__lede">Static-first, edge-delivered, verifiable.</p>
  <ul class="stack__chips">
    {
      venues.map((venue) => (
        <li class="chip">
          {venue.name}
          <span class="chip__meta">· {venue.place}</span>
        </li>
      ))
    }
  </ul>
</Tile>

<style>
  :global(.tile.stack) {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .eyebrow :global(.stack__icon) {
    width: 14px;
    height: 14px;
    color: var(--gold-text);
  }

  .stack__lede {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .stack__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    padding-top: var(--s-3);
  }

  .stack__chips .chip {
    height: 28px;
    font-size: 12.5px;
    background: var(--ground);
  }
</style>
