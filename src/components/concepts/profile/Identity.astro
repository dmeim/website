---
/**
 * Identity column: portrait, name, role, availability, section nav and
 * contact. Sticky on desktop; a plain top block on small screens.
 */
import { Image } from "astro:assets";
import { Mail, GitBranch } from "@lucide/astro";
import portrait from "../../../../assets/images/photoshoot/gpt-crossarmed-transparent.png";
import { connect, hero } from "../../../content/site";
import SpyNav from "./SpyNav.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<aside class="p-id" aria-label="Profile">
  <div class="p-id__inner">
    <div class="p-id__head">
      <figure class="p-id__portrait">
        <Image
          src={portrait}
          alt="Dimitri in a black suit, arms crossed, smiling"
          widths={[280, 420, 560]}
          sizes="280px"
          loading="eager"
        />
      </figure>
      <div class="p-id__names">
        <h1 class="p-id__name">Dimitri</h1>
        <p class="p-id__handle">@dmeim</p>
      </div>
    </div>

    <p class="p-id__role">{hero.role}</p>
    <p class="p-id__status">
      <span class="p-id__dot" aria-hidden="true"></span>
      Open to thoughtful collaborations
    </p>

    <SpyNav />

    <div class="p-id__meta">
      <ul class="p-id__links" aria-label="Contact">
        <li>
          <a href={`mailto:${connect.email}`}><Mail size={15} stroke-width={1.75} aria-hidden="true" />Email</a>
        </li>
        <li>
          <a href={connect.socialUrl} target="_blank" rel="noopener noreferrer">
            <GitBranch size={15} stroke-width={1.75} aria-hidden="true" />GitHub<span class="p-sr-only"> (opens in a new tab)</span>
          </a>
        </li>
      </ul>

      <div class="p-id__foot">
        <ThemeToggle />
      </div>
    </div>
  </div>
</aside>

<style>
  .p-id__inner {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-block: 2.5rem 2.25rem;
    border-bottom: 1px solid var(--p-line);
  }

  .p-id__head {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* Crop the full-length cut-out to head and shoulders. */
  .p-id__portrait {
    position: relative;
    flex: none;
    width: 88px;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--p-radius);
    background: var(--p-surface);
  }

  .p-id__portrait :global(img) {
    position: absolute;
    top: -1%;
    left: -42%;
    width: 200%;
    max-width: none;
    height: auto;
  }

  .p-id__name {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .p-id__handle {
    color: var(--p-muted);
    font-size: 0.875rem;
  }

  .p-id__role {
    font-size: 0.9375rem;
    max-width: 24rem;
  }

  .p-id__status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: -0.75rem;
    color: var(--p-muted);
    font-size: 0.875rem;
  }

  .p-id__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--p-gold);
  }

  .p-id__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .p-id__links {
    display: flex;
    gap: 1.25rem;
  }

  .p-id__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    color: var(--p-ink);
    font-size: 0.875rem;
    text-decoration: none;
  }

  .p-id__links a:hover {
    color: var(--p-gold);
  }

  @media (min-width: 960px) {
    .p-id {
      position: sticky;
      top: 0;
      align-self: start;
      height: 100vh;
      height: 100dvh;
      overflow-y: auto;
      scrollbar-width: none;
    }

    .p-id__inner {
      min-height: 100%;
      gap: 1.5rem;
      padding-block: 5.5rem 2.5rem;
      border-bottom: 0;
    }

    .p-id__head {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }

    .p-id__portrait {
      width: 144px;
    }

    .p-id__status {
      margin-top: -1rem;
    }

    .p-id__meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
      margin-top: auto;
    }

    .p-id__links {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
