---
/** Work: ongoing roles, then selected projects with status. */
import { appointments, projects } from "../../../content/site";
import Section from "./Section.astro";
import Row from "./Row.astro";

// Source summaries carry lorem and an old design name; keep one plain line.
const blurbs: Record<string, string> = {
  "dmeim-com": "Personal platform for projects, keys, and tools on Cloudflare.",
  "verification-lab": "In-browser PGP and SSH/Ed25519 verification.",
  "edge-experiments": "Workers, bindings, and small edge utilities.",
};

const blurb = (slug: string, summary: string): string =>
  blurbs[slug] ?? summary.split(" — ")[0];
---

<Section id="work" title="Work" spy="work">
  <h3 class="p-sub" data-reveal>Roles</h3>
  <ul class="p-list">
    {
      appointments.map((a) => (
        <Row label={a.dates} title={a.title} desc={a.bullets?.[0] ?? a.organization} href={a.url} />
      ))
    }
  </ul>

  <h3 class="p-sub" data-reveal>Projects</h3>
  <ul class="p-list">
    {
      projects.map((p) => (
        <Row label={p.tags[0]} title={p.title} desc={blurb(p.slug, p.summary)} status={p.status} href={p.href} />
      ))
    }
  </ul>
</Section>

<style>
  .p-sub {
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .p-list + .p-sub {
    margin-top: 2rem;
  }
</style>
