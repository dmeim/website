---
import { ClientRouter } from "astro:transitions";
import SiteEffects from "../components/react/SiteEffects";
import "@/ui/index.css";
import Fonts from "@/ui/fonts/Fonts.astro";
import SiteFooter from "@/ui/components/SiteFooter.astro";
import SiteHeader from "@/ui/components/SiteHeader.astro";
import WalletDialogs from "@/components/wallets/WalletDialogs.astro";
import SiteIdentity from "@/ui/components/SiteIdentity.astro";
import { Container } from "@/ui/components";
import SkipLink from "@/ui/components/SkipLink.astro";
import Toaster from "@/ui/components/Toaster.astro";
import { shellMode } from "@/ui/lib/site-nav";

interface Props {
  title?: string;
  description?: string;
  /** Full-bleed main, no footer. Outside /tools and /chat it also drops the site header. */
  immersive?: boolean;
  /** Adds robots noindex (e.g. the /ui showcase). */
  noindex?: boolean;
}

const {
  title = "dmeim.com",
  description = "Personal site for Dimitri — projects, keys, and tools.",
  immersive = false,
  noindex = false,
} = Astro.props;

const pageTitle = title === "dmeim.com" ? title : `${title} · dmeim.com`;

const pathname = Astro.url.pathname;
// Tools and chat keep the app bar even though their main is full-bleed.
const mode = shellMode(pathname, immersive && shellMode(pathname) !== "app");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Fonts />
    {noindex ? <meta name="robots" content="noindex" /> : null}
    <title>{pageTitle}</title>
    <!-- FOUC-safe theme: apply before paint -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var pref =
            stored === "light" || stored === "system" || stored === "dark"
              ? stored
              : "system";
          var prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches;
          var theme =
            pref === "light" || pref === "dark"
              ? pref
              : prefersDark
                ? "dark"
                : "light";
          document.documentElement.setAttribute("data-theme-pref", pref);
          document.documentElement.setAttribute("data-theme", theme);
        } catch (_) {
          document.documentElement.setAttribute("data-theme-pref", "system");
          document.documentElement.setAttribute("data-theme", "dark");
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body class:list={[{ "is-immersive": immersive }]} data-shell={mode}>
    <SkipLink />
    <div class="ui-site-shell" data-shell={mode}>
      <SiteHeader currentPath={pathname} immersive={mode === "immersive"} />
      <main
        class:list={["site-main", { "site-main--immersive": immersive }]}
        id="main"
      >
        {
          mode === "rail" && (
            <Container width="narrow">
              <SiteIdentity />
            </Container>
          )
        }
        <slot />
      </main>
      <SiteFooter immersive={immersive} />
      {mode !== "immersive" && <WalletDialogs />}
    </div>

    <Toaster />
    <SiteEffects client:load />

    <script>
      import { initReveals } from "@/ui/lib/reveal";

      initReveals();
    </script>
  </body>
</html>
