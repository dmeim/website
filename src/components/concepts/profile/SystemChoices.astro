---
/** Choice specimens: checkbox, switch, segmented control (native inputs). */
---

<div class="p-sys__group" data-reveal>
  <h3 class="p-sys__label">Choices</h3>
  <div class="p-sys__body p-sys__stack">
    <label class="p-check">
      <input type="checkbox" checked />
      <span>Send me a copy</span>
    </label>
    <label class="p-check">
      <input type="checkbox" role="switch" class="p-switch" />
      <span>Email notifications</span>
    </label>
    <fieldset class="p-seg">
      <legend class="p-sr-only">Density</legend>
      <label><input type="radio" name="p-density" value="compact" /><span>Compact</span></label>
      <label><input type="radio" name="p-density" value="default" checked /><span>Default</span></label>
      <label><input type="radio" name="p-density" value="relaxed" /><span>Relaxed</span></label>
    </fieldset>
  </div>
</div>

<style>
  .p-check {
    display: inline-flex;
    justify-self: start;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.9375rem;
    cursor: pointer;
  }

  .p-check input {
    appearance: none;
    flex: none;
    display: grid;
    place-items: center;
    width: 1.125rem;
    height: 1.125rem;
    margin: 0;
    border: 1px solid var(--p-line-strong);
    border-radius: 4px;
    background: transparent;
    cursor: pointer;
    transition:
      background-color var(--p-fast) var(--p-ease),
      border-color var(--p-fast) var(--p-ease);
  }

  .p-check input:not(.p-switch)::after {
    content: "";
    width: 0.3125rem;
    height: 0.5625rem;
    margin-top: -2px;
    border: solid var(--p-on-ink);
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(45deg);
    opacity: 0;
  }

  .p-check input:checked {
    border-color: var(--p-ink);
    background: var(--p-ink);
  }

  .p-check input:checked::after {
    opacity: 1;
  }

  .p-check input.p-switch {
    position: relative;
    display: block;
    width: 2rem;
    height: 1.125rem;
    border: 0;
    border-radius: var(--p-pill);
    background: var(--p-surface-strong);
  }

  .p-switch::after {
    content: "";
    position: absolute;
    top: 2px;
    left: 2px;
    width: calc(1.125rem - 4px);
    height: calc(1.125rem - 4px);
    border-radius: 50%;
    background: var(--p-ground);
    transition: transform var(--p-fast) var(--p-ease);
  }

  .p-check input.p-switch:checked {
    background: var(--p-ink);
  }

  .p-switch:checked::after {
    transform: translateX(0.875rem);
  }

  .p-seg {
    display: inline-flex;
    justify-self: start;
    gap: 2px;
    margin: 0;
    padding: 2px;
    border: 0;
    border-radius: var(--p-radius);
    background: var(--p-surface);
  }

  .p-seg label {
    position: relative;
  }

  .p-seg input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .p-seg span {
    display: block;
    padding: 0.3125rem 0.75rem;
    border-radius: 6px;
    color: var(--p-muted);
    font-size: 0.875rem;
    cursor: pointer;
    transition:
      background-color var(--p-fast) var(--p-ease),
      color var(--p-fast) var(--p-ease);
  }

  .p-seg span:hover,
  .p-seg input:checked + span {
    color: var(--p-ink);
  }

  .p-seg input:checked + span {
    background: var(--p-ground);
  }

  .p-seg input:focus-visible + span {
    outline: 2px solid var(--p-gold);
    outline-offset: 1px;
  }
</style>
