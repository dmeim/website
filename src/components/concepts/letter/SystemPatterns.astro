---
import { Info } from "@lucide/astro";
import Specimen from "./Specimen.astro";
import StatusMark from "./StatusMark.astro";
import TextLink from "./TextLink.astro";

const tabs = [
  { id: "overview", label: "Overview", body: "A quiet summary of the project and why it exists." },
  { id: "notes", label: "Notes", body: "Decisions written down as they were made, not after." },
  { id: "changes", label: "Changes", body: "A short, dated list of what moved and what stayed." },
];
---

<Specimen title="Status">
  <div class="lt-row lt-row--wide">
    <StatusMark status="live" />
    <StatusMark status="wip" />
    <StatusMark status="archived" />
  </div>
</Specimen>

<Specimen title="Card">
  <article class="lt-card">
    <div class="lt-card__head">
      <h4 class="lt-card__title">Verification lab</h4>
      <StatusMark status="wip" />
    </div>
    <p class="lt-muted">In-browser PGP and SSH signature verification.</p>
    <p class="lt-card__foot"><TextLink href="/projects" arrow>Read the notes</TextLink></p>
  </article>
</Specimen>

<Specimen title="Tabs">
  <div class="lt-tabs" data-lt-tabs>
    <div class="lt-tabs__list" role="tablist" aria-label="Project detail">
      {
        tabs.map((tab, i) => (
          <button
            type="button"
            role="tab"
            class="lt-tabs__tab"
            id={`sys-tab-${tab.id}`}
            aria-controls={`sys-panel-${tab.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
          >
            {tab.label}
          </button>
        ))
      }
    </div>
    {
      tabs.map((tab, i) => (
        <p role="tabpanel" class="lt-tabs__panel" id={`sys-panel-${tab.id}`} aria-labelledby={`sys-tab-${tab.id}`} hidden={i !== 0}>
          {tab.body}
        </p>
      ))
    }
  </div>
</Specimen>

<Specimen title="Tooltip and link">
  <div class="lt-row lt-row--wide">
    <span class="lt-tip">
      <button type="button" class="lt-tip__trigger" aria-describedby="sys-tip">
        <Info size={16} stroke-width={1.5} aria-hidden="true" />
        Fingerprint
      </button>
      <span role="tooltip" id="sys-tip" class="lt-tip__bubble">A short hash that identifies a key.</span>
    </span>
    <TextLink href="/keys" arrow>An ordinary link</TextLink>
  </div>
</Specimen>

<style>
  .lt-row--wide {
    gap: 1.5rem;
  }

  .lt-card {
    display: grid;
    gap: 0.4rem;
    padding: 1.25rem 1.25rem 1rem;
    border: 1px solid var(--lt-line-strong);
    border-radius: var(--lt-radius);
  }

  .lt-card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .lt-card__title {
    font-size: 1.125rem;
    font-weight: 500;
  }

  .lt-card__foot {
    margin-top: 0.5rem;
    font-size: var(--lt-small);
  }

  .lt-tabs__list {
    display: flex;
    gap: 1.5rem;
    border-bottom: 1px solid var(--lt-line);
  }

  .lt-tabs__tab {
    margin-bottom: -1px;
    padding: 0.5rem 0;
    border: 0;
    border-bottom: 1px solid transparent;
    background: none;
    color: var(--lt-muted);
    font-size: var(--lt-small);
    cursor: pointer;
    transition:
      color var(--lt-fast) var(--lt-ease),
      border-color var(--lt-fast) var(--lt-ease);
  }

  .lt-tabs__tab:hover {
    color: var(--lt-ink);
  }

  .lt-tabs__tab[aria-selected="true"] {
    color: var(--lt-ink);
    border-bottom-color: var(--lt-gold);
  }

  .lt-tabs__panel {
    padding-top: 1rem;
  }

  .lt-tip {
    position: relative;
    display: inline-flex;
  }

  .lt-tip__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0;
    border: 0;
    background: none;
    color: var(--lt-ink);
    font-size: var(--lt-small);
    cursor: help;
    text-decoration: underline dotted var(--lt-line-strong);
    text-underline-offset: 0.3em;
  }

  .lt-tip__bubble {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 0;
    width: max-content;
    max-width: 16rem;
    padding: 0.4rem 0.6rem;
    border-radius: var(--lt-radius);
    background: var(--lt-ink);
    color: var(--lt-ground);
    font-size: var(--lt-fine);
    line-height: 1.4;
    opacity: 0;
    transform: translateY(4px);
    pointer-events: none;
    transition:
      opacity var(--lt-fast) var(--lt-ease),
      transform var(--lt-fast) var(--lt-ease);
  }

  .lt-tip:hover .lt-tip__bubble,
  .lt-tip__trigger:focus-visible + .lt-tip__bubble {
    opacity: 1;
    transform: none;
  }

  .lt-tip[data-dismissed] .lt-tip__bubble {
    opacity: 0;
  }
</style>
