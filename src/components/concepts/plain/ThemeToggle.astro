---
import { Monitor, Moon, Sun } from "@lucide/astro";
---

<!-- One button that cycles Light → Auto → Dark. It carries `data-theme-set` for the
     next mode so the shared runtime does the switching; the icon follows the
     current preference via CSS. -->
<button
  type="button"
  class="pl-btn pl-btn--icon pl-btn--ghost pl-theme"
  data-theme-set="system"
  data-pl-theme
  aria-label="Theme: Light. Switch to Auto"
>
  <Sun class="pl-theme__icon pl-theme__icon--light" aria-hidden="true" />
  <Monitor class="pl-theme__icon pl-theme__icon--system" aria-hidden="true" />
  <Moon class="pl-theme__icon pl-theme__icon--dark" aria-hidden="true" />
</button>

<style>
  .pl-theme :global(.pl-theme__icon) {
    display: none;
    width: 18px;
    height: 18px;
  }

  :global(html:not([data-theme-pref])) .pl-theme :global(.pl-theme__icon--system),
  :global(html[data-theme-pref="light"]) .pl-theme :global(.pl-theme__icon--light),
  :global(html[data-theme-pref="system"]) .pl-theme :global(.pl-theme__icon--system),
  :global(html[data-theme-pref="dark"]) .pl-theme :global(.pl-theme__icon--dark) {
    display: block;
  }
</style>

<script>
  type Pref = "light" | "system" | "dark";

  const ORDER: Pref[] = ["light", "system", "dark"];
  const NAMES: Record<Pref, string> = { light: "Light", system: "Auto", dark: "Dark" };

  function currentPref(): Pref {
    const value = document.documentElement.dataset.themePref;
    return value === "light" || value === "dark" ? value : "system";
  }

  function sync(): void {
    const pref = currentPref();
    const next = ORDER[(ORDER.indexOf(pref) + 1) % ORDER.length];
    document.querySelectorAll<HTMLButtonElement>("[data-pl-theme]").forEach((button) => {
      button.dataset.themeSet = next;
      // The runtime marks theme buttons as pressed; a cycling button is not a toggle.
      button.removeAttribute("aria-pressed");
      button.setAttribute("aria-label", `Theme: ${NAMES[pref]}. Switch to ${NAMES[next]}`);
      button.title = `Theme: ${NAMES[pref]}`;
    });
  }

  document.addEventListener("concept:theme", sync);
  sync();
</script>
