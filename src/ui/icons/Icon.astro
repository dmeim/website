---
/**
 * Icon for .astro files: inline SVG rendered at build, zero JS. Takes every
 * IconName, including page-only icons and the crypto token marks.
 */
import { islandGlyphs } from "./glyphs-island";
import { pageGlyphs } from "./glyphs-page";
import { isTokenIcon, type IconName, type IconWeight } from "./registry";
import { tokenIcons } from "./token-icons";

interface Props {
  name: IconName;
  size?: number | string;
  weight?: IconWeight;
  mirrored?: boolean;
  /** Accessible name; omit for decorative icons (aria-hidden). */
  label?: string;
  class?: string;
}

const { name, size = "1em", weight = "regular", mirrored = false, label, class: className } = Astro.props;
const classes = className ? `ui-icon ${className}` : "ui-icon";
const a11y = label ? { role: "img", "aria-label": label } : { "aria-hidden": "true" };
const Token = isTokenIcon(name) ? tokenIcons[name] : undefined;
const glyph = isTokenIcon(name) ? "" : (name in islandGlyphs ? islandGlyphs : pageGlyphs)[name as keyof typeof islandGlyphs & keyof typeof pageGlyphs]?.[weight];
---

{
  Token ? (
    <Token size={size} className={classes} focusable="false" data-icon={name} {...a11y} />
  ) : (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width={size}
      height={size}
      fill="currentColor"
      viewBox="0 0 256 256"
      transform={mirrored ? "scale(-1, 1)" : undefined}
      class={classes}
      focusable="false"
      data-icon={name}
      {...a11y}
      set:html={glyph}
    />
  )
}
