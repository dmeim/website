---
/**
 * Choice controls specimen: select, checkbox, switch, segmented control.
 * All native inputs restyled, so keyboard and form behaviour come free.
 */
import { ChevronDown } from "@lucide/astro";

const segments = ["Index", "Grid", "List"];
---

<div class="ch">
  <div class="ch__select">
    <label class="l-mono" for="sys-select">Category</label>
    <div class="ch__select-wrap">
      <select id="sys-select">
        <option>All tools</option>
        <option>Encoders</option>
        <option>Network</option>
        <option>Images &amp; video</option>
      </select>
      <ChevronDown size={16} stroke-width={1.75} aria-hidden="true" class="ch__chev" />
    </div>
  </div>

  <div class="ch__row">
    <label class="ch__check">
      <input type="checkbox" checked />
      <span>Show planned tools</span>
    </label>
    <label class="ch__check">
      <input type="checkbox" class="ch__switch" role="switch" />
      <span>Reduce motion</span>
    </label>
  </div>

  <fieldset class="ch__seg">
    <legend class="l-mono">View</legend>
    <div class="ch__seg-track">
      {
        segments.map((s, i) => (
          <label>
            <input type="radio" name="sys-view" value={s.toLowerCase()} checked={i === 0} />
            <span>{s}</span>
          </label>
        ))
      }
    </div>
  </fieldset>
</div>

<style>
  .ch {
    display: grid;
    gap: var(--l-space-6);
  }

  .ch__select {
    display: grid;
    gap: var(--l-space-2);
  }

  .ch__select-wrap {
    position: relative;
  }

  .ch__select select {
    width: 100%;
    min-height: 3rem;
    padding: 0 2.5rem 0 0.875rem;
    border: 1px solid var(--l-line-strong);
    border-radius: 0;
    background: var(--l-ground);
    appearance: none;
    cursor: pointer;
  }

  .ch__select select:hover {
    border-color: var(--l-ink-muted);
  }

  .ch__select select:focus-visible {
    outline-offset: -1px;
    border-color: var(--l-gold);
  }

  .ch__select :global(.ch__chev) {
    position: absolute;
    top: 50%;
    right: 0.875rem;
    translate: 0 -50%;
    pointer-events: none;
  }

  .ch__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--l-space-4) var(--l-space-6);
  }

  .ch__check {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-size: var(--l-text-sm);
    cursor: pointer;
  }

  .ch__check input {
    position: relative;
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    margin: 0;
    border: 1px solid var(--l-ink-muted);
    border-radius: 0;
    background: var(--l-ground);
    appearance: none;
    cursor: pointer;
    transition:
      background-color var(--l-dur-fast) var(--l-ease),
      border-color var(--l-dur-fast) var(--l-ease);
  }

  .ch__check input:not(.ch__switch):checked {
    background: var(--l-ink);
    border-color: var(--l-ink);
  }

  .ch__check input:not(.ch__switch)::after {
    content: "";
    position: absolute;
    left: 5px;
    top: 1px;
    width: 5px;
    height: 10px;
    border: solid var(--l-ground);
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(45deg) scale(0);
    transition: transform var(--l-dur-fast) var(--l-ease);
  }

  .ch__check input:not(.ch__switch):checked::after {
    transform: rotate(45deg) scale(1);
  }

  .ch__check input.ch__switch {
    width: 2.25rem;
  }

  .ch__switch::after {
    content: "";
    position: absolute;
    top: 2px;
    left: 2px;
    width: calc(1.125rem - 6px);
    height: calc(1.125rem - 6px);
    background: var(--l-ink-muted);
    transition:
      transform var(--l-dur) var(--l-ease),
      background-color var(--l-dur-fast) var(--l-ease);
  }

  .ch__switch:checked {
    background: var(--l-gold);
    border-color: var(--l-gold);
  }

  .ch__switch:checked::after {
    background: var(--l-on-gold);
    transform: translateX(1.125rem);
  }

  .ch__seg {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .ch__seg legend {
    padding: 0;
    margin-bottom: var(--l-space-2);
  }

  .ch__seg-track {
    display: inline-flex;
    border: 1px solid var(--l-line-strong);
  }

  .ch__seg label {
    position: relative;
    cursor: pointer;
  }

  .ch__seg label + label {
    border-left: 1px solid var(--l-line-strong);
  }

  .ch__seg input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .ch__seg span {
    display: block;
    padding: 0.6rem 1.1rem;
    font-size: var(--l-text-sm);
    color: var(--l-ink-muted);
    transition:
      background-color var(--l-dur-fast) var(--l-ease),
      color var(--l-dur-fast) var(--l-ease);
  }

  .ch__seg label:hover span {
    color: var(--l-ink);
  }

  .ch__seg input:checked + span {
    background: var(--l-ink);
    color: var(--l-ground);
  }

  .ch__seg input:focus-visible + span {
    outline: 2px solid var(--l-gold);
    outline-offset: 2px;
  }
</style>
