---
/** A text button that copies `value` and swaps its word to "Copied". */
interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<button type="button" class="lt-copy" data-lt-copy={value} aria-label={label}>
  <span class="lt-copy__word lt-copy__word--idle" aria-hidden="true">Copy</span>
  <span class="lt-copy__word lt-copy__word--done" aria-hidden="true">Copied</span>
</button>
<span class="lt-visually-hidden" role="status" aria-live="polite" data-lt-copy-status></span>

<script>
  const RESET_MS = 1800;

  // Clipboard API is unavailable on insecure origins and some embedded views.
  const legacyCopy = (text: string): boolean => {
    const area = document.createElement("textarea");
    area.value = text;
    area.setAttribute("readonly", "");
    area.style.position = "fixed";
    area.style.opacity = "0";
    document.body.append(area);
    area.select();
    const ok = document.execCommand("copy");
    area.remove();
    return ok;
  };

  const copy = async (text: string): Promise<boolean> => {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      return legacyCopy(text);
    }
  };

  document.querySelectorAll<HTMLButtonElement>("[data-lt-copy]").forEach((btn) => {
    let timer = 0;
    const status = btn.nextElementSibling as HTMLElement | null;

    btn.addEventListener("click", async () => {
      const ok = await copy(btn.dataset.ltCopy ?? "");
      if (!ok) console.error("letter: clipboard write failed");
      btn.toggleAttribute("data-copied", ok);
      if (status) status.textContent = ok ? "Copied" : "Copy failed — select the text instead";
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        btn.removeAttribute("data-copied");
        if (status) status.textContent = "";
      }, ok ? RESET_MS : RESET_MS * 2);
    });
  });
</script>

<style>
  .lt-copy {
    display: inline-grid;
    padding: 0.15rem 0;
    border: 0;
    background: none;
    color: var(--lt-gold);
    font-size: var(--lt-label);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.08em;
    cursor: pointer;
    text-decoration-line: underline;
    text-decoration-color: var(--lt-gold-soft);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
    transition:
      text-decoration-color var(--lt-fast) var(--lt-ease),
      text-decoration-thickness var(--lt-fast) var(--lt-ease);
  }

  .lt-copy:hover {
    text-decoration-color: var(--lt-gold);
    text-decoration-thickness: 2px;
  }

  /* Both words share one grid cell so the button never changes width. */
  .lt-copy__word {
    grid-area: 1 / 1;
    text-align: left;
    transition:
      opacity var(--lt-fast) var(--lt-ease),
      transform var(--lt-fast) var(--lt-ease);
  }

  .lt-copy__word--done {
    opacity: 0;
    transform: translateY(4px);
  }

  .lt-copy[data-copied] .lt-copy__word--idle {
    opacity: 0;
    transform: translateY(-4px);
  }

  .lt-copy[data-copied] .lt-copy__word--done {
    opacity: 1;
    transform: none;
  }
</style>
