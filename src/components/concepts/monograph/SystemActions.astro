---
import { ArrowRight, Info, Plus } from "@lucide/astro";
import StatusBadge from "./StatusBadge.astro";
---

<div class="mg-spec mg-spec--wide">
  <p class="mg-spec__name mg-label"><span>Buttons</span><span>.mg-btn</span></p>
  <div class="mg-spec__row">
    <button type="button" class="mg-btn mg-btn--primary">Primary <ArrowRight aria-hidden="true" /></button>
    <button type="button" class="mg-btn">Secondary</button>
    <button type="button" class="mg-btn mg-btn--ghost">Text action</button>
    <button type="button" class="mg-btn mg-btn--icon" aria-label="Add"><Plus aria-hidden="true" /></button>
    <button type="button" class="mg-btn mg-btn--primary" disabled>Disabled</button>
  </div>
</div>

<div class="mg-spec">
  <p class="mg-spec__name mg-label"><span>Status</span><span>.mg-badge</span></p>
  <div class="mg-spec__row">
    <StatusBadge status="live" />
    <StatusBadge status="wip" />
    <StatusBadge status="archived" />
  </div>
</div>

<div class="mg-spec">
  <p class="mg-spec__name mg-label"><span>Inline link</span><span>.mg-link</span></p>
  <p class="mg-sys-prose">
    Fingerprints live on the <a class="mg-link" href="/keys">keys page</a>, and every tool runs{" "}
    <a class="mg-link" href="/tools">locally in your browser</a>.
  </p>
</div>

<div class="mg-spec">
  <p class="mg-spec__name mg-label"><span>Tooltip</span><span>[role=tooltip]</span></p>
  <div class="mg-spec__row">
    <span class="mg-tip" data-mg-tip>
      <button type="button" class="mg-btn mg-btn--icon" aria-describedby="mg-tip-1" aria-label="About fingerprints">
        <Info aria-hidden="true" />
      </button>
      <span class="mg-tip__bubble" role="tooltip" id="mg-tip-1">A short hash that identifies a public key.</span>
    </span>
    <span class="mg-label">Hover or focus</span>
  </div>
</div>

<style>
  .mg-sys-prose {
    font-family: var(--mg-font-display);
    font-size: 1.5rem;
    line-height: 1.3;
  }

  .mg-tip {
    position: relative;
    display: inline-flex;
  }

  .mg-tip__bubble {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 12px);
    z-index: 5;
    width: max-content;
    max-width: 220px;
    padding: 10px 14px;
    background: var(--mg-ink);
    color: var(--mg-ground);
    font-size: 0.8125rem;
    line-height: 1.45;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, 6px);
    transition:
      opacity var(--mg-dur-1) var(--mg-ease),
      transform var(--mg-dur-2) var(--mg-ease);
  }

  .mg-tip__bubble::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    width: 8px;
    height: 8px;
    background: inherit;
    transform: translate(-50%, -4px) rotate(45deg);
  }

  .mg-tip:hover .mg-tip__bubble,
  .mg-tip:has(:focus-visible) .mg-tip__bubble {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .mg-tip[data-dismissed] .mg-tip__bubble {
    opacity: 0;
  }
</style>

<script>
  // Escape dismisses an open tooltip without moving focus (WCAG 1.4.13).
  document.querySelectorAll<HTMLElement>("[data-mg-tip]").forEach((tip) => {
    tip.addEventListener("keydown", (event) => {
      if (event.key === "Escape") tip.setAttribute("data-dismissed", "");
    });
    const restore = (): void => tip.removeAttribute("data-dismissed");
    tip.addEventListener("focusout", restore);
    tip.addEventListener("pointerleave", restore);
  });
</script>
