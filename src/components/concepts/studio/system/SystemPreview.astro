---
import SectionHead from "../SectionHead.astro";
import PreviewButtons from "./PreviewButtons.astro";
import PreviewControls from "./PreviewControls.astro";
import PreviewFeedback from "./PreviewFeedback.astro";
import PreviewCard from "./PreviewCard.astro";
import PreviewFields from "./PreviewFields.astro";
import "./forms.css";

const tokens = [
  { name: "ground", var: "--ground" },
  { name: "tile", var: "--tile" },
  { name: "tile-alt", var: "--tile-alt" },
  { name: "ink", var: "--ink" },
  { name: "ink-muted", var: "--ink-muted" },
  { name: "gold", var: "--gold" },
];
---

<section class="section container system" id="system" aria-labelledby="system-title">
  <SectionHead
    index="03"
    eyebrow="System"
    title="System — component preview"
    id="system-title"
    lede="The vocabulary this page is built from. Every control is keyboard reachable and follows the theme."
  >
    <ul class="swatches" aria-label="Color tokens">
      {
        tokens.map((token) => (
          <li class="swatch" title={`var(${token.var})`}>
            <span class="swatch__chip" style={`background: var(${token.var})`} />
            <span class="mono swatch__name">{token.name}</span>
          </li>
        ))
      }
    </ul>
  </SectionHead>

  <div class="system__grid" data-reveal>
    <div class="system__col">
      <PreviewButtons />
      <PreviewFeedback />
    </div>
    <div class="system__col">
      <PreviewFields />
    </div>
    <div class="system__col">
      <PreviewControls />
      <PreviewCard />
    </div>
  </div>
</section>

<style>
  .swatches {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--s-2);
  }

  .swatch {
    display: grid;
    justify-items: center;
    gap: 6px;
  }

  .swatch__chip {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    box-shadow: inset 0 0 0 1px var(--border-strong);
  }

  .swatch__name {
    font-size: 10px;
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .system__grid {
    display: grid;
    gap: var(--s-3);
  }

  /* Columns are hand-balanced on wide screens; below that panels flow freely. */
  .system__col {
    display: contents;
  }

  @media (min-width: 900px) {
    .system__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s-4);
      align-items: start;
    }
  }

  @media (min-width: 1200px) {
    .system__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .system__col {
      display: grid;
      gap: var(--s-4);
      align-content: start;
    }
  }
</style>
