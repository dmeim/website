---
import { ClientRouter } from "astro:transitions";
import "@/ui/index.css";
import Fonts from "@/ui/fonts/Fonts.astro";
import SiteFooter from "@/ui/components/SiteFooter.astro";
import SiteHeader from "@/ui/components/SiteHeader.astro";
import WalletDialogs from "@/components/wallets/WalletDialogs.astro";
import SiteIdentity from "@/ui/components/SiteIdentity.astro";
import { Container } from "@/ui/components";
import SkipLink from "@/ui/components/SkipLink.astro";
import Toaster from "@/ui/components/Toaster.astro";
import { fullName } from "@/ui/lib/identity";
import { shellMode } from "@/ui/lib/site-nav";
import { THEME_COLORS } from "@/ui/lib/theme";
import { analytics } from "@/content/site";

interface Props {
  title?: string;
  description?: string;
  /** Full-bleed main with no site header or footer. */
  immersive?: boolean;
  /** Adds robots noindex (e.g. the /ui showcase). */
  noindex?: boolean;
}

const {
  title = "dmeim.com",
  description = "Personal site of Dimitrios Meimaridis: projects, tools, and public keys.",
  immersive = false,
  noindex = false,
} = Astro.props;

const pageTitle = title === "dmeim.com" || title.startsWith(fullName) ? title : `${title} · dmeim.com`;

const pathname = Astro.url.pathname;
const mode = shellMode(immersive);
const canonicalPath = pathname.replace(/(\.html|\/)$/, "").replace(/\/index$/, "") || "/";
const canonical = new URL(canonicalPath, Astro.site).href;
const isNotFound = canonicalPath === "/404";

// Rail and identity hold still; only the page content fades and rises (ui-page-* in base.css).
const pageStep = {
  old: { name: "ui-page-out", duration: "120ms", easing: "ease-in", fillMode: "both" },
  new: { name: "ui-page-in", duration: "240ms", delay: "60ms", easing: "cubic-bezier(0.2, 0.7, 0.2, 1)", fillMode: "both" },
};
const pageTransition = { forwards: pageStep, backwards: pageStep };
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content={THEME_COLORS.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={THEME_COLORS.dark} media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-title" content="dmeim" />
    <Fonts />
    {noindex ? <meta name="robots" content="noindex" /> : null}
    {!isNotFound && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
    {
      import.meta.env.PROD && analytics.cloudflareToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analytics.cloudflareToken, spa: true })}
        />
      )
    }
    <title>{pageTitle}</title>
    <!-- FOUC-safe theme: apply before paint -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var pref =
            stored === "light" || stored === "system" || stored === "dark"
              ? stored
              : "system";
          var prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches;
          var theme =
            pref === "light" || pref === "dark"
              ? pref
              : prefersDark
                ? "dark"
                : "light";
          document.documentElement.setAttribute("data-theme-pref", pref);
          document.documentElement.setAttribute("data-theme", theme);
          var color = theme === "dark" ? "#111110" : "#f6f4ef";
          document.querySelectorAll("meta[name='theme-color']").forEach(function (meta) {
            meta.setAttribute("content", color);
          });
        } catch (_) {
          document.documentElement.setAttribute("data-theme-pref", "system");
          document.documentElement.setAttribute("data-theme", "dark");
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body class:list={[{ "is-immersive": immersive }]} data-shell={mode}>
    <SkipLink />
    <div class="ui-site-shell" data-shell={mode}>
      <SiteHeader currentPath={pathname} immersive={mode === "immersive"} />
      <main
        class:list={["site-main", { "site-main--immersive": immersive }]}
        id="main"
        transition:animate={pageTransition}
      >
        {
          mode === "rail" && (
            <Container width="narrow" transition:name="site-identity" transition:animate="none">
              <SiteIdentity />
            </Container>
          )
        }
        <slot />
      </main>
      <SiteFooter immersive={immersive} />
      {mode !== "immersive" && <WalletDialogs />}
    </div>

    <Toaster />

    <script>
      import { initReveals } from "@/ui/lib/reveal";

      initReveals();
    </script>
  </body>
</html>
