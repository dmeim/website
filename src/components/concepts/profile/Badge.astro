---
/** Tiny status pill. Live is the only state that earns the gold dot. */
export type BadgeStatus = "live" | "wip" | "archived";

interface Props {
  status: BadgeStatus;
}

const { status } = Astro.props;
const labels: Record<BadgeStatus, string> = {
  live: "Live",
  wip: "In progress",
  archived: "Archived",
};
---

<span class={`p-badge p-badge--${status}`}>
  <span class="p-badge__dot" aria-hidden="true"></span>
  {labels[status]}
</span>

<style>
  .p-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.125rem 0.5rem;
    border-radius: var(--p-pill);
    background: var(--p-surface);
    color: var(--p-ink);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.5;
    white-space: nowrap;
  }

  .p-badge__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--p-gold);
  }

  .p-badge--wip .p-badge__dot {
    background: transparent;
    box-sizing: border-box;
    border: 1.5px solid var(--p-muted);
  }

  .p-badge--archived {
    background: transparent;
    color: var(--p-muted);
    border: 1px solid var(--p-line-strong);
    padding-block: calc(0.125rem - 1px);
  }

  .p-badge--archived .p-badge__dot {
    background: var(--p-muted);
    opacity: 0.6;
  }
</style>
