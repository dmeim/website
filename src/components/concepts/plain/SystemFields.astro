---
import { ChevronDown } from "@lucide/astro";
import SpecRow from "./SpecRow.astro";
---

<SpecRow label="Fields">
  <div class="pl-fields">
    <div class="pl-field">
      <label for="pl-demo-name">Name</label>
      <input id="pl-demo-name" class="pl-input" type="text" placeholder="Your name" aria-describedby="pl-demo-name-hint" />
      <p id="pl-demo-name-hint" class="pl-field__hint">How you'd like to be addressed.</p>
    </div>

    <div class="pl-field">
      <label for="pl-demo-email">Email</label>
      <input
        id="pl-demo-email"
        class="pl-input"
        type="email"
        value="hello@"
        aria-invalid="true"
        aria-describedby="pl-demo-email-error"
      />
      <p id="pl-demo-email-error" class="pl-field__error">Enter a full address, like name@example.com.</p>
    </div>

    <div class="pl-field">
      <label for="pl-demo-topic">Topic</label>
      <div class="pl-select">
        <select id="pl-demo-topic" class="pl-input">
          <option>Collaboration</option>
          <option>Keys &amp; verification</option>
          <option>Just saying hello</option>
        </select>
        <ChevronDown aria-hidden="true" />
      </div>
    </div>

    <div class="pl-field pl-field--wide">
      <label for="pl-demo-message">Message</label>
      <textarea id="pl-demo-message" class="pl-input" rows="4" placeholder="A few lines is plenty."></textarea>
    </div>
  </div>
</SpecRow>


<style>
  .pl-fields {
    display: grid;
    gap: 24px;
  }

  .pl-field {
    display: grid;
    gap: 8px;
    align-content: start;
  }

  .pl-field label {
    font-size: 0.875rem;
    font-weight: 500;
  }

  .pl-input {
    width: 100%;
    min-height: 44px;
    padding: 10px 14px;
    border: 0;
    border-radius: var(--pl-radius-control);
    background: var(--pl-field);
    color: var(--pl-ink);
    line-height: 1.4;
    appearance: none;
    transition: background-color var(--pl-fast) var(--pl-ease);
  }

  .pl-input::placeholder {
    color: var(--pl-muted);
  }

  .pl-input:hover {
    background: var(--pl-field-hover);
  }

  .pl-input:focus-visible {
    outline: 2px solid var(--pl-gold);
    outline-offset: 2px;
    border-radius: var(--pl-radius-control);
  }

  .pl-input[aria-invalid="true"] {
    background: color-mix(in oklab, var(--pl-danger) 12%, var(--pl-field));
  }

  textarea.pl-input {
    resize: vertical;
  }

  .pl-field__hint,
  .pl-field__error {
    font-size: 0.8125rem;
    color: var(--pl-muted);
  }

  .pl-field__error {
    color: var(--pl-danger);
  }

  .pl-select {
    position: relative;
  }

  .pl-select select {
    padding-right: 40px;
    cursor: pointer;
  }

  .pl-select :global(svg) {
    position: absolute;
    top: 50%;
    right: 14px;
    width: 16px;
    height: 16px;
    color: var(--pl-muted);
    pointer-events: none;
    transform: translateY(-50%);
  }

  @media (min-width: 720px) {
    .pl-fields {
      grid-template-columns: repeat(3, 1fr);
    }

    .pl-field--wide {
      grid-column: 1 / -1;
    }
  }
</style>
