---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolsShell from "../../components/tools/ToolsShell";
import "../../components/tools/ToolsShell.css";
import { availableTools, getToolById, type Tool } from "../../content/tools";

export function getStaticPaths() {
  return availableTools().map((tool) => ({
    params: { slug: tool.id },
    props: { tool },
  }));
}

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const resolved = getToolById(tool.id) ?? tool;
---

<BaseLayout title={`${resolved.title} · Tools`} description={resolved.description}>
  <ToolsShell client:only="react" initialSlug={resolved.id}>
    <div slot="fallback" class="tools-shell-fallback" aria-busy="true">
      <span class="ui-skeleton" style="--ui-skeleton-w: 40%; --ui-skeleton-h: 2.25rem" aria-hidden="true"></span>
      <span class="ui-skeleton" style="--ui-skeleton-h: 1rem" aria-hidden="true"></span>
      <span class="ui-skeleton" style="--ui-skeleton-h: 12rem" data-radius="panel" aria-hidden="true"></span>
    </div>
  </ToolsShell>
</BaseLayout>
