---
import { ArrowUpRight } from "@lucide/astro";
import AccordionItem from "./AccordionItem.astro";
import StatusBadge from "./StatusBadge.astro";
import "./system-patterns.css";

const tabs = [
  { id: "overview", label: "Overview", body: "Static-first pages served from the edge, with islands only where interaction earns it." },
  { id: "keys", label: "Keys", body: "SSH and GPG fingerprints, published openly with import and verification notes." },
  { id: "tools", label: "Tools", body: "Local-first utilities that run entirely in the browser; nothing leaves the page." },
];
---

<div class="mg-spec">
  <p class="mg-spec__name mg-label"><span>Card</span><span>.mg-card</span></p>
  <a class="mg-card" href="/projects">
    <span class="mg-card__top">
      <span class="mg-num mg-card__num">01</span>
      <StatusBadge status="wip" />
    </span>
    <span class="mg-card__title">Verification lab</span>
    <span class="mg-card__body">In-browser PGP and SSH signature checks, with nothing uploaded.</span>
    <span class="mg-card__foot mg-label">View project <ArrowUpRight aria-hidden="true" /></span>
  </a>
</div>

<div class="mg-spec">
  <p class="mg-spec__name mg-label"><span>Tabs</span><span>[role=tablist]</span></p>
  <div class="mg-tabs" data-mg-tabs>
    <div class="mg-tabs__list" role="tablist" aria-label="Platform areas">
      {
        tabs.map((t, i) => (
          <button
            type="button"
            role="tab"
            class="mg-tabs__tab"
            id={`mg-tab-${t.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            aria-controls={`mg-tabpanel-${t.id}`}
            tabindex={i === 0 ? "0" : "-1"}
          >
            {t.label}
          </button>
        ))
      }
      <span class="mg-tabs__indicator" aria-hidden="true" data-mg-tabs-indicator></span>
    </div>
    {
      tabs.map((t, i) => (
        <div
          class="mg-tabs__panel"
          role="tabpanel"
          id={`mg-tabpanel-${t.id}`}
          aria-labelledby={`mg-tab-${t.id}`}
          tabindex="0"
          hidden={i !== 0}
        >
          {t.body}
        </div>
      ))
    }
  </div>
</div>

<div class="mg-spec">
  <p class="mg-spec__name mg-label"><span>Accordion item</span><span>AccordionItem</span></p>
  <div class="mg-sys-acc">
    <AccordionItem id="mg-sys-acc" title="What does “local-first” mean?" size="sm">
      <p>The tools run in your browser, so whatever you paste into them stays on your device.</p>
    </AccordionItem>
  </div>
</div>

<script>
  import { initTabs } from "./tabs";
  initTabs();
</script>
