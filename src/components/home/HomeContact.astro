---
/** Contact: two direct routes and one line of context. */
import Section from "@/ui/components/Section.astro";
import List from "@/ui/components/List.astro";
import ListRow from "@/ui/components/ListRow.astro";
import { connect } from "@/content/site";
---

<Section id="contact" title="Contact" spy class="home-section" data-reveal-group>
  <p class="home-lede" data-reveal>{connect.intro}</p>
  <List>
    <ListRow
      label="Email"
      title={connect.email}
      description="Best for collaborations and questions"
      href={`mailto:${connect.email}`}
      data-reveal
    />
    <ListRow
      label="GitHub"
      title={connect.socialHandle}
      description="Code, issues, and experiments"
      href={connect.socialUrl}
      data-reveal
    />
  </List>
</Section>
