---
/** Keys: fingerprint rows with a copy control; full blocks live on /keys. */
import Section from "@/ui/components/Section.astro";
import List from "@/ui/components/List.astro";
import ListRow from "@/ui/components/ListRow.astro";
import CopyButton from "@/ui/components/CopyButton.astro";
import Link from "@/ui/components/Link.astro";
import { keys } from "@/content/site";
---

<Section id="keys" title="Keys" spy class="home-section" data-reveal-group>
  <List>
    {
      keys.map((key) => (
        <ListRow label={key.kind} title={key.title} description={key.fingerprint} mono data-reveal>
          <CopyButton
            slot="actions"
            value={key.fingerprint}
            appearance="icon"
            size="sm"
            label={`Copy ${key.title} fingerprint`}
          />
        </ListRow>
      ))
    }
  </List>
  <p class="home-after home-muted" data-reveal>
    Full public key blocks and import steps are on the <Link href="/keys">keys page</Link>.
  </p>
</Section>
