---
/**
 * Index hero: mono meta row, masked word-by-word headline, a short
 * statement with CTAs, an in-page index, and the portrait plate.
 * Load motion is pure CSS so it still resolves to visible without JS.
 */
import { hero } from "../../../content/site";
import portrait from "../../../../assets/images/photoshoot/gpt-crossarmed-transparent.png";
import Button from "./Button.astro";
import IndexNav from "./IndexNav.astro";
import Plate from "./Plate.astro";

const lines = [["Careful", "interfaces."], ["Trustworthy", "systems."]];
const roles = hero.role.split("·").map((r) => r.trim());
const [primary, secondary] = hero.ctas;

const index = [
  { n: "02", label: "Now", href: "#now" },
  { n: "03", label: "Selected work", href: "#work" },
  { n: "04", label: "Toolbox", href: "#toolbox" },
  { n: "05", label: "Principles", href: "#principles" },
  { n: "06", label: "Keys", href: "#keys" },
  { n: "07", label: "Contact", href: "#contact" },
];
let word = 0;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__inner l-container">
    <div class="hero__guides l-grid" aria-hidden="true">
      {Array.from({ length: 12 }, (_, i) => <span style={`--i:${i}`}></span>)}
    </div>

    <dl class="hero__meta l-grid l-mono">
      <div><dt class="l-sr-only">Section</dt><dd><span class="l-gold">01</span> — Index</dd></div>
      <div><dt class="l-sr-only">Name</dt><dd>Dimitri / {hero.name}</dd></div>
      <div><dt class="l-sr-only">Based</dt><dd>Remote</dd></div>
      <div><dt class="l-sr-only">Edition</dt><dd class="l-num">2026</dd></div>
    </dl>

    <h1 class="hero__title" id="hero-title">
      {
        lines.map((line, li) => (
          <span class="hero__line">
            {line.map((w) => (
              <span class="hero__mask">
                <span class="hero__word" style={`--w:${word++};--l:${li}`}>
                  {w}
                </span>
              </span>
            ))}
          </span>
        ))
      }
    </h1>

    <div class="hero__body l-grid">
      <div class="hero__copy">
        <ul class="hero__roles l-mono" aria-label="Roles">
          {roles.map((r) => <li>{r}</li>)}
        </ul>
        <p class="hero__sentence">{hero.sentence}</p>
        <div class="hero__ctas">
          <Button href={primary.href} arrow>{primary.label} with Dimitri</Button>
          <a class="hero__secondary l-link" href={secondary.href}>View {secondary.label.toLowerCase()}</a>
        </div>
      </div>

      <div class="hero__index">
        <IndexNav label="Contents" items={index} />
      </div>

      <div class="hero__plate">
        <Plate
          src={portrait}
          alt="Dimitri in a black suit, arms crossed, looking at the camera."
          figure="Fig. 1"
          caption="Dimitri, 2026"
          sizes="(min-width: 900px) 32vw, 100vw"
          eager
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-bottom: clamp(4rem, 2rem + 6vw, 8rem);
  }

  .hero__inner {
    position: relative;
  }

  .hero__guides {
    position: absolute;
    inset: 0 var(--l-gutter);
    pointer-events: none;
    z-index: 0;
    mask-image: linear-gradient(to bottom, #000 35%, transparent 90%);
  }

  .hero__guides span {
    border-left: 1px solid var(--l-guide);
    transform-origin: top;
    animation: ledger-guide 1.4s var(--l-ease) both;
    animation-delay: calc(var(--i) * 40ms);
  }

  .hero__guides span:nth-child(n + 5) {
    display: none;
  }

  .hero__guides span:nth-child(4) {
    border-right: 1px solid var(--l-guide);
  }

  .hero__meta,
  .hero__title,
  .hero__body {
    position: relative;
    z-index: 1;
  }

  .hero__meta {
    row-gap: var(--l-space-2);
    padding-block: var(--l-space-5) var(--l-space-4);
    border-bottom: 1px solid var(--l-line);
    color: var(--l-ink-muted);
    animation: ledger-fade 900ms var(--l-ease) 100ms both;
  }

  .hero__meta > div {
    grid-column: span 2;
  }

  .hero__meta dd {
    margin: 0;
  }

  .hero__title {
    margin-top: clamp(2.5rem, 1rem + 4vw, 5rem);
    font-size: var(--l-text-display);
    font-weight: 450;
    letter-spacing: var(--l-track-display);
    line-height: 0.9;
  }

  .hero__line {
    display: block;
  }

  .hero__line:nth-child(2) {
    color: var(--l-ink-muted);
  }

  .hero__mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
    margin-right: 0.22em;
  }

  .hero__word {
    display: inline-block;
    animation: ledger-rise 1.1s var(--l-ease) both;
    animation-delay: calc(250ms + var(--l) * 140ms + var(--w) * 50ms);
  }

  .hero__body {
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
    row-gap: var(--l-space-7);
    animation: ledger-fade 900ms var(--l-ease) 700ms both;
  }

  .hero__copy,
  .hero__plate {
    grid-column: 1 / -1;
  }

  .hero__index {
    display: none;
  }

  .hero__roles {
    display: grid;
    gap: 0.25rem;
    color: var(--l-ink-muted);
  }

  .hero__roles li::before {
    content: "/";
    margin-right: 0.6rem;
    color: var(--l-gold);
  }

  @media (min-width: 600px) {
    .hero__roles {
      display: flex;
      flex-wrap: wrap;
      column-gap: 1rem;
    }

    .hero__roles li:first-child::before {
      content: none;
    }
  }

  .hero__sentence {
    margin-top: var(--l-space-4);
    max-width: 30ch;
    font-size: var(--l-text-xl);
    letter-spacing: -0.02em;
    line-height: 1.18;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--l-space-4) var(--l-space-6);
    margin-top: var(--l-space-6);
  }

  .hero__secondary {
    font-size: var(--l-text-sm);
    font-weight: 500;
  }

  @media (min-width: 900px) {
    .hero__guides span:nth-child(n + 5) {
      display: block;
    }

    .hero__guides span:nth-child(4) {
      border-right: 0;
    }

    .hero__guides span:nth-child(12) {
      border-right: 1px solid var(--l-guide);
    }

    .hero__meta > div {
      grid-column: span 3;
    }

    .hero__meta > div:last-child {
      text-align: right;
    }

    .hero__copy {
      grid-column: 1 / span 5;
      align-self: start;
    }

    .hero__index {
      display: block;
      grid-column: 6 / span 2;
      align-self: end;
    }

    .hero__plate {
      grid-column: 9 / span 4;
    }
  }

  @keyframes ledger-rise {
    from {
      transform: translateY(110%);
    }
  }

  @keyframes ledger-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes ledger-guide {
    from {
      transform: scaleY(0);
    }
  }
</style>
