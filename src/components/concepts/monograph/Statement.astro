---
import { shortBio } from "../../../content/site";

const emphasis = new Set(["careful", "trustworthy", "clarity", "durable"]);
const words = shortBio.split(/\s+/).map((word) => ({
  text: word,
  em: emphasis.has(word.toLowerCase().replace(/[^a-z]/g, "")),
}));
---

<section class="mg-statement mg-section" id="profile" aria-labelledby="mg-statement-label">
  <div class="mg-container mg-statement__grid">
    <p class="mg-label" id="mg-statement-label"><span class="mg-label__num">01</span>Profile</p>
    <p class="mg-statement__text" data-mg-statement>
      {
        words.map((word) => (
          <>
            <span class:list={["mg-statement__word", { "mg-em": word.em }]}>{word.text}</span>{" "}
          </>
        ))
      }
    </p>
  </div>
</section>

<style>
  .mg-statement__grid {
    display: grid;
    gap: 32px;
  }

  .mg-statement__text {
    font-family: var(--mg-font-display);
    font-size: clamp(1.875rem, 1rem + 3.2vw, 4.25rem);
    line-height: 1.08;
    letter-spacing: -0.012em;
    text-wrap: pretty;
    max-width: 22em;
  }

  .mg-statement__word {
    transition: color var(--mg-dur-2) var(--mg-ease);
  }

  :global(html.js) .mg-statement__word {
    color: color-mix(in srgb, var(--mg-ink) 26%, var(--mg-ground));
  }

  :global(html.js) .mg-statement__word[data-on] {
    color: var(--mg-ink);
  }

  :global(html.js) .mg-statement__word.mg-em[data-on] {
    color: var(--mg-gold);
  }

  @media (min-width: 900px) {
    .mg-statement__grid {
      grid-template-columns: minmax(180px, 1fr) 4fr;
      align-items: start;
    }

    .mg-statement__grid .mg-label {
      padding-top: 1.4em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .mg-statement__word {
      color: var(--mg-ink);
    }
  }
</style>

<script>
  import { clamp, motionAllowed, onScrollFrame } from "./monograph-scroll";

  const text = document.querySelector<HTMLElement>("[data-mg-statement]");
  const words = text ? Array.from(text.querySelectorAll<HTMLElement>(".mg-statement__word")) : [];

  if (text && words.length) {
    if (!motionAllowed()) {
      words.forEach((word) => word.setAttribute("data-on", ""));
    } else {
      let lit = 0;
      onScrollFrame(() => {
        const rect = text.getBoundingClientRect();
        const vh = window.innerHeight;
        // Starts as the paragraph enters the lower fifth, done when its end reaches mid-screen.
        const progress = clamp((vh * 0.82 - rect.top) / (rect.height + vh * 0.3));
        const next = Math.round(progress * words.length);
        if (next === lit) return;
        const [from, to] = next > lit ? [lit, next] : [next, lit];
        for (let i = from; i < to; i++) words[i].toggleAttribute("data-on", next > lit);
        lit = next;
      });
    }
  }
</script>
