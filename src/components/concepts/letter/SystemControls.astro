---
import { ChevronDown } from "@lucide/astro";
import Specimen from "./Specimen.astro";
---

<Specimen title="Buttons">
  <div class="lt-row">
    <button type="button" class="lt-btn lt-btn--primary">Send message</button>
    <button type="button" class="lt-btn lt-btn--secondary">View keys</button>
    <button type="button" class="lt-btn lt-btn--text">Learn more</button>
    <button type="button" class="lt-btn lt-btn--secondary" disabled>Disabled</button>
  </div>
</Specimen>

<Specimen title="Fields">
  <form class="lt-stack" novalidate onsubmit="return false">
    <div class="lt-field">
      <label class="lt-field__label" for="sys-name">Name</label>
      <input class="lt-input" id="sys-name" name="name" type="text" placeholder="Your name" aria-describedby="sys-name-hint" autocomplete="off" />
      <p class="lt-field__hint" id="sys-name-hint">How you’d like to be addressed.</p>
    </div>
    <div class="lt-field">
      <label class="lt-field__label" for="sys-email">Email</label>
      <input class="lt-input" id="sys-email" name="email" type="email" value="hello@" aria-invalid="true" aria-describedby="sys-email-error" autocomplete="off" />
      <p class="lt-field__error" id="sys-email-error">Enter a full address, like name@example.com.</p>
    </div>
    <div class="lt-field">
      <label class="lt-field__label" for="sys-topic">Topic</label>
      <div class="lt-select">
        <select class="lt-input" id="sys-topic" name="topic">
          <option>Collaboration</option>
          <option>Keys and verification</option>
          <option>Just saying hello</option>
        </select>
        <span class="lt-select__chevron" aria-hidden="true"><ChevronDown size={16} stroke-width={1.5} /></span>
      </div>
    </div>
    <div class="lt-field">
      <label class="lt-field__label" for="sys-message">Message</label>
      <textarea class="lt-input" id="sys-message" name="message" rows="4" placeholder="A few lines is plenty."></textarea>
    </div>
  </form>
</Specimen>
