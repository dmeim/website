---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/ui/components/Button.astro";
import Container from "@/ui/components/Container.astro";
import PageHeader from "@/ui/components/PageHeader.astro";
import Prose from "@/ui/components/Prose.astro";
import Section from "@/ui/components/Section.astro";
import Stack from "@/ui/components/Stack.astro";
import { loadCatalog } from "@/lib/orthodox/assets";

const { images, collections } = await loadCatalog();
const meta = `${images.length} icons · ${collections.length}${collections.length === 1 ? " collection" : " collections"}`;
---

<BaseLayout
  title="Orthodox"
  description="Orthodox Christian icons arranged by month, and a full-screen icon wall screensaver."
>
  <Container>
    <PageHeader
      title="Orthodox"
      lede="Icons for the wall — a quiet screensaver of holy images, hung the way they would be at home."
    />

    <Section title="About" spy>
      <Prose as="article">
        <p>
          In Orthodox homes, icons hang together in a prayer corner, often on
          the east wall, with a lampada burning before them. This screensaver
          brings that wall to a screen: icons on their wooden panels, changing
          slowly through the day.
        </p>
        <p>
          Tap the wall at any time to choose a collection, how many icons hang,
          how they are arranged, their borders, how often they change, and the
          wall behind them. The settings fade away on their own.
        </p>
      </Prose>
    </Section>

    <Section title="Hang the icons" eyebrow="Screensaver" spy>
      <Stack gap="md" align="start">
        <Prose>
          <p>
            Opens full screen. Best on a spare tablet or a TV browser, left
            running.
          </p>
        </Prose>
        <Prose size="sm"><p>{meta}</p></Prose>
        <Button variant="primary" href="/orthodox/screensaver" iconEnd="arrow-right" data-orthodox-launch>
          Launch screensaver
        </Button>
      </Stack>
    </Section>
  </Container>
</BaseLayout>

<script>
  // Request fullscreen while the click still counts as a user gesture; the
  // client router keeps the document, so it carries over to the screensaver.
  function bindLaunch() {
    const link = document.querySelector<HTMLAnchorElement>(
      "[data-orthodox-launch]",
    );
    if (!link || link.dataset.bound === "1") return;
    link.dataset.bound = "1";
    link.addEventListener("click", () => {
      const root = document.documentElement;
      if (!document.fullscreenEnabled || document.fullscreenElement) return;
      root.requestFullscreen().catch((error: unknown) => {
        console.warn("[orthodox] fullscreen request failed", error);
      });
    });
  }

  bindLaunch();
  document.addEventListener("astro:page-load", bindLaunch);
</script>
