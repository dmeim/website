---
/**
 * Content section with a quiet label heading. `spy` names the nav entry
 * this section lights up; sections without one hide the marker.
 */
interface Props {
  id: string;
  title: string;
  spy?: string;
  note?: string;
}

const { id, title, spy, note } = Astro.props;
const headingId = `${id}-title`;
---

<section class="p-section" id={id} aria-labelledby={headingId} data-spy-section={spy ?? ""} data-reveal-group>
  <header class="p-section__head" data-reveal>
    <h2 class="p-section__title" id={headingId}>{title}</h2>
    {note && <p class="p-section__note">{note}</p>}
  </header>
  <slot />
</section>

<style>
  .p-section {
    padding-block: 2.25rem;
  }

  .p-section:first-child {
    padding-top: 0;
  }

  .p-section__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .p-section__title {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--p-muted);
  }

  .p-section__note {
    font-size: 0.8125rem;
    color: var(--p-muted);
  }

  @media (min-width: 960px) {
    .p-section {
      padding-block: 3rem;
    }
  }
</style>
