---
import { Image } from "astro:assets";
import portrait from "../../../../../assets/images/photoshoot/gpt-pockets-transparent.png";
import Tile from "../Tile.astro";
---

<Tile as="figure" class="bento__portrait portrait" tone="alt" data-parallax>
  <span class="portrait__ring" aria-hidden="true"></span>
  <span class="portrait__circle" aria-hidden="true"></span>
  <Image
    src={portrait}
    alt="Dimitri in a black suit, hands in pockets"
    class="portrait__img"
    widths={[360, 560, 820]}
    sizes="(min-width: 1100px) 440px, (min-width: 720px) 34vw, 92vw"
    loading="eager"
    fetchpriority="high"
  />
  <figcaption class="portrait__caption">
    <span class="portrait__name">Dimitri</span>
    <span class="mono muted">dmeim</span>
  </figcaption>
</Tile>

<script>
  import { finePointer } from "../scripts/interactions";
  import { prefersReducedMotion } from "../../shared/concept-runtime";

  document.querySelectorAll<HTMLElement>("[data-parallax]").forEach((tile) => {
    if (!finePointer() || prefersReducedMotion()) return;
    tile.addEventListener("pointermove", (event) => {
      const rect = tile.getBoundingClientRect();
      const x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
      const y = ((event.clientY - rect.top) / rect.height) * 2 - 1;
      tile.style.setProperty("--px", x.toFixed(3));
      tile.style.setProperty("--py", y.toFixed(3));
    });
    tile.addEventListener("pointerleave", () => {
      tile.style.setProperty("--px", "0");
      tile.style.setProperty("--py", "0");
    });
  });
</script>

<style>
  :global(.tile.portrait) {
    --px: 0;
    --py: 0;
    margin: 0;
    padding: 0;
    overflow: hidden;
    min-height: 420px;
    isolation: isolate;
  }

  .portrait__circle,
  .portrait__ring {
    position: absolute;
    left: 50%;
    border-radius: 50%;
    aspect-ratio: 1;
    transition: transform 700ms var(--ease);
  }

  .portrait__circle {
    bottom: 18%;
    width: min(86%, 440px);
    margin-left: calc(min(86%, 440px) / -2);
    background: var(--gold);
    transform: translate3d(calc(var(--px) * -14px), calc(var(--py) * -10px), 0);
  }

  .portrait__ring {
    bottom: calc(18% - 28px);
    width: calc(min(86%, 440px) + 56px);
    margin-left: calc((min(86%, 440px) + 56px) / -2);
    border: 1px solid color-mix(in oklab, var(--gold) 55%, transparent);
    transform: translate3d(calc(var(--px) * -6px), calc(var(--py) * -4px), 0);
  }

  :global(.portrait) :global(.portrait__img) {
    position: absolute;
    left: 50%;
    bottom: 0;
    z-index: 1;
    width: auto;
    height: 90%;
    max-width: none;
    margin-left: 0;
    object-fit: contain;
    object-position: bottom center;
    translate: -50% 0;
    transform: translate3d(calc(var(--px) * 8px), calc(var(--py) * 4px), 0);
    transition:
      transform 700ms var(--ease),
      opacity 900ms var(--ease) 200ms,
      scale 1200ms var(--ease) 200ms;
  }

  :global(html.js .portrait:not([data-revealed="true"]) .portrait__img) {
    opacity: 0;
    scale: 1.04;
  }

  .portrait__caption {
    position: absolute;
    left: var(--s-4);
    bottom: var(--s-4);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 32px;
    padding: 0 12px;
    border: 1px solid var(--border);
    border-radius: var(--r-pill);
    background: color-mix(in oklab, var(--tile) 82%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-size: 13px;
    font-weight: 500;
  }

  .portrait__caption .mono {
    font-size: 11.5px;
    font-weight: 400;
  }

  @media (min-width: 720px) {
    :global(.tile.portrait) {
      min-height: 0;
    }
  }
</style>
