---
import { currentChapter } from "../../../content/site";
import Section from "./Section.astro";

// Only the first sentence: the rest describes a retired visual direction.
const firstSentence = currentChapter.body.split(/(?<=\.)\s/)[0];
---

<Section id="now" label="Now">
  <p>
    <span class="lt-now__title">{currentChapter.title}.</span>{" "}
    {firstSentence.replace("Dimitri’s", "my")}
  </p>
</Section>

<style>
  .lt-now__title {
    font-style: italic;
  }
</style>
