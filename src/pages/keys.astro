---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CodeBlock, Container, KeyValue, Link, Notice, PageHeader, Section, Stack } from "@/ui/components";
import { keys, contact } from "../content/site";
---

<BaseLayout
  title="Keys"
  description="Public SSH and GPG keys for Dimitrios Meimaridis, with fingerprints and import notes."
>
  <Container>
    <PageHeader
      title="Keys"
      lede="Public SSH and GPG material for verifying identity and securing collaboration. Placeholder blocks below — replace with real keys before production."
    />
    <Section>
      <Notice tone="warning" variant="callout" title="Notice" live="off">
        <p>
          Fingerprints and key bodies on this page are placeholders. Do not trust
          them for production verification until real material is published from
          <code>assets/keys/</code>.
        </p>
        <p>
          Contact: <Link href={`mailto:${contact.email}`}>{contact.email}</Link>
        </p>
      </Notice>
    </Section>
    {
      keys.map((key) => (
        <Section id={key.id} title={key.title} spy>
          <Stack gap="md">
            <KeyValue items={[{ label: "Usage", value: key.usage }]} />
            <CodeBlock label="Fingerprint" code={key.fingerprint} wrap />
            <CodeBlock label="Public key" code={key.body} wrap />
          </Stack>
        </Section>
      ))
    }
  </Container>
</BaseLayout>
