---
/**
 * Cursor-following preview for the work index. Purely decorative (the row
 * links carry the information), so it is aria-hidden and only runs on
 * fine pointers without reduced motion.
 */
---

<div class="pv" data-work-preview aria-hidden="true">
  <div class="pv__inner" data-work-preview-body></div>
</div>

<script>
  import { prefersReducedMotion } from "../shared/concept-runtime";

  const list = document.querySelector<HTMLElement>("[data-work-list]");
  const card = document.querySelector<HTMLElement>("[data-work-preview]");
  const body = document.querySelector<HTMLElement>("[data-work-preview-body]");
  const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

  if (list && card && body && finePointer && !prefersReducedMotion()) {
    const OFFSET = 28;
    let x = 0;
    let y = 0;
    let tx = 0;
    let ty = 0;
    let frame = 0;
    let current: string | null = null;

    const place = () => {
      // Lerp toward the pointer so the card trails slightly behind it.
      x += (tx - x) * 0.18;
      y += (ty - y) * 0.18;
      card.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      frame = Math.abs(tx - x) + Math.abs(ty - y) > 0.5 ? requestAnimationFrame(place) : 0;
    };

    const target = (cx: number, cy: number) => {
      const w = card.offsetWidth;
      const h = card.offsetHeight;
      const flipX = cx + OFFSET + w > window.innerWidth - 16;
      const flipY = cy + OFFSET + h > window.innerHeight - 16;
      tx = flipX ? cx - OFFSET - w : cx + OFFSET;
      ty = flipY ? cy - OFFSET - h : cy + OFFSET;
    };

    list.addEventListener("pointermove", (event) => {
      if (event.pointerType !== "mouse") return;
      const row = (event.target as HTMLElement).closest<HTMLElement>("[data-preview]");
      if (!row) return;
      const id = row.dataset.preview ?? null;
      if (id !== current) {
        const tpl = list.querySelector<HTMLTemplateElement>(`[data-preview-tpl="${id}"]`);
        if (!tpl) return;
        body.replaceChildren(tpl.content.cloneNode(true));
        current = id;
      }
      target(event.clientX, event.clientY);
      if (!card.hasAttribute("data-open")) {
        x = tx;
        y = ty;
        card.setAttribute("data-open", "");
      }
      if (!frame) frame = requestAnimationFrame(place);
    });

    list.addEventListener("pointerleave", () => {
      card.removeAttribute("data-open");
      current = null;
    });

    window.addEventListener("scroll", () => card.removeAttribute("data-open"), { passive: true });
  }
</script>

<style>
  .pv {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 40;
    width: 20rem;
    pointer-events: none;
    will-change: transform;
  }

  .pv__inner {
    display: grid;
    gap: var(--l-space-3);
    padding: var(--l-space-5);
    background: var(--l-ink);
    color: var(--l-ground);
    opacity: 0;
    clip-path: inset(0 0 100% 0);
    transition:
      opacity var(--l-dur) var(--l-ease),
      clip-path var(--l-dur-slow) var(--l-ease);
  }

  .pv[data-open] .pv__inner {
    opacity: 1;
    clip-path: inset(0 0 0 0);
  }

  .pv__inner :global(.pv__kicker) {
    color: color-mix(in srgb, var(--l-ground) 60%, var(--l-ink));
  }

  /* The card inverts the theme, so it borrows the opposite theme's gold. */
  .pv__inner :global(.pv__kicker .l-gold) {
    color: #7a6136;
  }

  :global([data-theme="light"]) .pv__inner :global(.pv__kicker .l-gold) {
    color: #d1b47a;
  }

  .pv__inner :global(.pv__title) {
    font-size: var(--l-text-lg);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .pv__inner :global(.pv__text),
  .pv__inner :global(.pv__list) {
    font-size: var(--l-text-sm);
    line-height: 1.5;
    color: color-mix(in srgb, var(--l-ground) 78%, var(--l-ink));
  }

  .pv__inner :global(.pv__list li) {
    padding: 0.4rem 0;
    border-top: 1px solid color-mix(in srgb, var(--l-ground) 18%, var(--l-ink));
  }

  .pv__inner :global(.tag) {
    justify-self: start;
    color: var(--l-ground);
    border-color: color-mix(in srgb, var(--l-ground) 40%, var(--l-ink));
  }
</style>
