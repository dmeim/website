---
/** Status as plain small-caps text with a dot; colour is never the only signal. */
interface Props {
  status: "live" | "wip" | "archived";
}

const labels = { live: "Live", wip: "In progress", archived: "Archived" } as const;
const { status } = Astro.props;
---

<span class={`lt-status lt-status--${status}`}>
  <span class="lt-status__dot" aria-hidden="true"></span>{labels[status]}
</span>

<style>
  .lt-status {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-size: var(--lt-label);
    font-variant-caps: all-small-caps;
    font-variant-numeric: lining-nums;
    letter-spacing: 0.08em;
    line-height: 1.4;
    color: var(--lt-muted);
    white-space: nowrap;
  }

  .lt-status__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .lt-status--live .lt-status__dot {
    background: var(--lt-ok);
  }

  .lt-status--wip .lt-status__dot {
    background: var(--lt-gold);
  }

  .lt-status--archived .lt-status__dot {
    background: transparent;
    border: 1px solid currentColor;
  }
</style>
