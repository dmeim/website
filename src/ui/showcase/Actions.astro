---
import ThemePair from "./ThemePair.astro";
import { Button, ButtonGroup, CopyButton, IconButton, Toolbar } from "@/ui/components/groups/actions";
import { ActionsShowcase } from "@/ui/react/showcase/ActionsShowcase";

const variants = ["primary", "secondary", "ghost", "danger"] as const;
const sizes = ["sm", "md", "lg"] as const;
const stage = "position: relative; min-height: 8rem; background: var(--ui-bg-inset); border-radius: var(--ui-radius-panel)";
---

<section id="actions" class="ui-showcase-section" aria-labelledby="actions-title">
  <h2 id="actions-title" class="ui-showcase-section__title">Actions</h2>
  <h3 class="ui-showcase-sub">Astro</h3>
  <ThemePair>
    <div style="display: grid; gap: var(--ui-space-sm)">
      <h4 class="ui-showcase-sub">Button: variant × size</h4>
      {
        variants.map((variant) => (
          <ButtonGroup>
            {sizes.map((size) => (
              <Button variant={variant} size={size} iconStart="plus">{`${variant} ${size}`}</Button>
            ))}
          </ButtonGroup>
        ))
      }
      <h4 class="ui-showcase-sub">Button: disabled, loading, pressed, link</h4>
      {
        variants.map((variant) => (
          <ButtonGroup>
            <Button variant={variant} disabled>Disabled</Button>
            <Button variant={variant} loading>Loading</Button>
            <Button variant={variant} pressed iconStart="eye">Pressed</Button>
            <Button variant={variant} href="#actions" iconEnd="arrow-right">Link</Button>
            <Button variant={variant} href="#actions" disabled>Disabled link</Button>
          </ButtonGroup>
        ))
      }
      <Button fullWidth variant="primary">Full width</Button>

      <h4 class="ui-showcase-sub">IconButton</h4>
      {
        variants.map((variant) => (
          <ButtonGroup>
            {sizes.map((size) => (
              <IconButton icon="gear" label={`Settings ${size}`} variant={variant} size={size} />
            ))}
            <IconButton icon="eye" label="Pressed" variant={variant} pressed />
            <IconButton icon="trash" label="Disabled" variant={variant} disabled />
            <IconButton icon="link" label="Link" variant={variant} href="#actions" tooltip={false} />
          </ButtonGroup>
        ))
      }

      <h4 class="ui-showcase-sub">CopyButton: button, icon, inline</h4>
      <ButtonGroup>
        <CopyButton value="Astro button copy" />
        <CopyButton value="Astro primary copy" variant="primary" size="sm" />
        <CopyButton value="Astro icon copy" appearance="icon" />
        <CopyButton value="Astro inline copy" appearance="inline" />
        <CopyButton value="x" disabled />
      </ButtonGroup>

      <h4 class="ui-showcase-sub">ButtonGroup: align, attached</h4>
      <ButtonGroup align="end" label="End aligned"><Button>Cancel</Button><Button variant="primary">Save</Button></ButtonGroup>
      <ButtonGroup align="between"><Button>Back</Button><Button variant="primary">Next</Button></ButtonGroup>
      <ButtonGroup align="stretch"><Button>One</Button><Button>Two</Button><Button>Three</Button></ButtonGroup>
      <ButtonGroup attached label="Alignment"><Button pressed>Left</Button><Button>Centre</Button><Button>Right</Button></ButtonGroup>

      <h4 class="ui-showcase-sub">Toolbar: inline, vertical, floating (arrow keys move focus)</h4>
      <Toolbar label="Formatting">
        <IconButton icon="code" label="Code" pressed tooltip={false} />
        <IconButton icon="image" label="Image" tooltip={false} />
        <IconButton icon="link" label="Link" tooltip={false} />
        <Button size="sm">Clear</Button>
      </Toolbar>
      <Toolbar label="Vertical tools" orientation="vertical" style="width: max-content">
        <IconButton icon="plus" label="Add" tooltip={false} />
        <IconButton icon="minus" label="Remove" tooltip={false} />
      </Toolbar>
      <div style={stage}>
        <Toolbar label="Stage top" placement="floating-top">
          <IconButton icon="play" label="Play" tooltip={false} />
          <IconButton icon="pause" label="Pause" tooltip={false} />
        </Toolbar>
        <Toolbar label="Stage bottom" placement="floating-bottom">
          <Button size="sm" variant="ghost">Step</Button>
          <Button size="sm" variant="primary">Run</Button>
        </Toolbar>
      </div>
    </div>
  </ThemePair>
  <h3 class="ui-showcase-sub">React</h3>
  <ActionsShowcase client:visible />
</section>
