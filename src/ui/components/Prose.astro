---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  as?: "div" | "article" | "section";
  size?: "sm" | "md";
}

const { as: Tag = "div", size = "md", class: className, ...rest } = Astro.props;
---

<Tag class:list={["ui-prose", className]} data-size={size} {...rest}><slot /></Tag>
