---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CodeBlock, Container, KeyValue, Link, Notice, PageHeader, Section, Stack } from "@/ui/components";
import { keys, contact } from "../content/site";
---

<BaseLayout
  title="Keys"
  description="Public SSH and GPG keys for Dimitrios Meimaridis, with fingerprints and import notes."
>
  <Container>
    <PageHeader
      title="Keys"
      lede="Public SSH and GPG keys for verifying identity and securing collaboration."
    />
    <Section>
      <Notice variant="callout" title="Before you trust a key" live="off">
        <p>
          Check its fingerprint against a copy you already trust, not only this
          page. Anyone who could change this site could change the keys too.
        </p>
        <p>
          Contact: <Link href={`mailto:${contact.email}`}>{contact.email}</Link>
        </p>
      </Notice>
    </Section>
    {
      keys.map((key) => (
        <Section id={key.id} title={key.title} spy>
          <Stack gap="md">
            <KeyValue items={[{ label: "Usage", value: key.usage }]} />
            <CodeBlock label="Fingerprint" code={key.fingerprint} wrap />
            <CodeBlock label={key.commandLabel} code={key.command} wrap />
            <CodeBlock label="Public key" code={key.body} wrap />
          </Stack>
        </Section>
      ))
    }
  </Container>
</BaseLayout>
