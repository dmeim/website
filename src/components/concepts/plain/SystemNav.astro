---
import { ArrowRight, Info } from "@lucide/astro";
import SpecRow from "./SpecRow.astro";

const tabs = [
  { id: "overview", label: "Overview", body: "A short summary sits here. One idea per tab." },
  { id: "details", label: "Details", body: "Specifics live one click away, never all at once." },
  { id: "notes", label: "Notes", body: "Arrow keys move between tabs; Tab moves into the panel." },
];
---

<SpecRow label="Tabs">
  <div class="pl-tabs" data-pl-tabs>
    <div class="pl-tabs__list" role="tablist" aria-label="Example tabs">
      {
        tabs.map((tab, index) => (
          <button
            type="button"
            role="tab"
            id={`pl-tab-${tab.id}`}
            aria-controls={`pl-tabpanel-${tab.id}`}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? 0 : -1}
          >
            {tab.label}
          </button>
        ))
      }
    </div>
    {
      tabs.map((tab, index) => (
        <div
          class="pl-tabs__panel"
          role="tabpanel"
          id={`pl-tabpanel-${tab.id}`}
          aria-labelledby={`pl-tab-${tab.id}`}
          tabindex="0"
          hidden={index !== 0}
        >
          {tab.body}
        </div>
      ))
    }
  </div>
</SpecRow>

<SpecRow label="Tooltip & link">
  <div class="pl-system__row">
    <span class="pl-tip" data-pl-tip>
      <button type="button" class="pl-btn pl-btn--icon" aria-label="About fingerprints" aria-describedby="pl-tip-1">
        <Info aria-hidden="true" />
      </button>
      <span class="pl-tip__bubble" role="tooltip" id="pl-tip-1">Compare these before trusting a key.</span>
    </span>
    <p class="pl-muted">
      Inline links look <a class="pl-link" href="#system">like this <ArrowRight aria-hidden="true" /></a>
    </p>
  </div>
</SpecRow>

<style>
  .pl-tabs__list {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .pl-tabs__list button {
    min-height: 40px;
    padding: 0 16px;
    border: 0;
    border-radius: var(--pl-radius-control);
    background: transparent;
    color: var(--pl-muted);
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color var(--pl-fast) var(--pl-ease),
      color var(--pl-fast) var(--pl-ease);
  }

  .pl-tabs__list button:hover {
    color: var(--pl-ink);
  }

  .pl-tabs__list button[aria-selected="true"] {
    background: var(--pl-surface);
    color: var(--pl-ink);
  }

  .pl-tabs__panel {
    margin-top: 12px;
    padding: 20px 24px;
    border-radius: var(--pl-radius-panel);
    background: var(--pl-surface);
    color: var(--pl-muted);
  }

  .pl-tip {
    position: relative;
    display: inline-flex;
  }

  .pl-tip__bubble {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 0;
    z-index: 2;
    width: max-content;
    max-width: 16rem;
    padding: 8px 12px;
    border-radius: 8px;
    background: var(--pl-ink);
    color: var(--pl-on-ink);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.4;
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    pointer-events: none;
    transition:
      opacity var(--pl-fast) var(--pl-ease),
      transform var(--pl-fast) var(--pl-ease),
      visibility var(--pl-fast);
  }

  .pl-tip:hover .pl-tip__bubble,
  .pl-tip:focus-within .pl-tip__bubble {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .pl-tip[data-dismissed] .pl-tip__bubble {
    opacity: 0;
    visibility: hidden;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-pl-tabs]").forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));

    const select = (next: HTMLButtonElement): void => {
      tabs.forEach((tab) => {
        const active = tab === next;
        tab.setAttribute("aria-selected", String(active));
        tab.tabIndex = active ? 0 : -1;
        const panel = document.getElementById(tab.getAttribute("aria-controls") ?? "");
        if (panel) panel.hidden = !active;
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", (event) => {
        const moves: Record<string, number> = {
          ArrowRight: index + 1,
          ArrowLeft: index - 1,
          Home: 0,
          End: tabs.length - 1,
        };
        if (!(event.key in moves)) return;
        event.preventDefault();
        const next = tabs[(moves[event.key] + tabs.length) % tabs.length];
        select(next);
        next.focus();
      });
    });
  });

  // Escape hides a tooltip without moving focus; it returns on the next hover or focus.
  document.querySelectorAll<HTMLElement>("[data-pl-tip]").forEach((tip) => {
    const reset = () => tip.removeAttribute("data-dismissed");
    tip.addEventListener("keydown", (event) => {
      if (event.key === "Escape") tip.setAttribute("data-dismissed", "");
    });
    tip.addEventListener("mouseleave", reset);
    tip.addEventListener("focusout", reset);
  });
</script>
