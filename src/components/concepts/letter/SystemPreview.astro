---
/** Appendix: the page's component vocabulary, set in the same quiet register. */
import "./system.css";
import SystemControls from "./SystemControls.astro";
import SystemChoices from "./SystemChoices.astro";
import SystemPatterns from "./SystemPatterns.astro";
---

<section class="lt-appendix" id="system" aria-labelledby="system-title">
  <p class="lt-label">Appendix</p>
  <h2 class="lt-appendix__title" id="system-title">System — component preview</h2>
  <p class="lt-appendix__note lt-muted">
    The pieces this page is built from, shown on their own for review. None of
    the controls below send anything.
  </p>
  <div class="lt-appendix__specs">
    <SystemControls />
    <SystemChoices />
    <SystemPatterns />
  </div>
</section>

<script>
  import { initLetterSystem } from "./system";
  initLetterSystem();
</script>

<style>
  .lt-appendix {
    margin-top: clamp(5rem, 12vw, 8rem);
    padding-top: 2.5rem;
    border-top: 1px solid var(--lt-line-strong);
  }

  .lt-appendix__title {
    margin-top: 0.35rem;
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.3;
  }

  .lt-appendix__note {
    margin-top: 0.75rem;
    margin-bottom: 2rem;
    font-size: var(--lt-small);
  }
</style>
