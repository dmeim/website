---
import PreviewPanel from "./PreviewPanel.astro";

const ranges = ["Day", "Week", "Month", "Year"];
const tabs = [
  { id: "overview", label: "Overview", body: "Tabs swap panels in place; arrow keys move between tabs, Home/End jump to the ends." },
  { id: "keys", label: "Keys", body: "Each panel is labelled by its tab, so screen readers announce context on entry." },
  { id: "activity", label: "Activity", body: "The gold underline glides to the selected tab with the system ease." },
];
---

<PreviewPanel title="Selection" note="checkbox · switch · segmented · tabs">
  <div class="stack">
    <label class="check"><input type="checkbox" checked /> Publish fingerprints</label>
    <label class="check"><input type="checkbox" /> Email me on new tools</label>
  </div>
  <div class="stack">
    <label class="switch"><input type="checkbox" role="switch" checked /> Reduce noise</label>
    <label class="switch"><input type="checkbox" role="switch" /> Beta features</label>
  </div>

  <div class="seg" role="group" aria-label="Range" data-seg="select">
    <span class="seg__thumb" aria-hidden="true"></span>
    {
      ranges.map((range, i) => (
        <button type="button" class="seg__option" data-value={range} aria-pressed={i === 1 ? "true" : "false"}>
          {range}
        </button>
      ))
    }
  </div>

  <div class="tabs" data-tabs>
    <div class="tabs__list" role="tablist" aria-label="Demo tabs">
      <span class="tabs__indicator" aria-hidden="true" data-tabs-indicator></span>
      {
        tabs.map((tab, i) => (
          <button
            type="button"
            class="tabs__tab"
            role="tab"
            id={`pv-tab-${tab.id}`}
            aria-controls={`pv-panel-${tab.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
          >
            {tab.label}
          </button>
        ))
      }
    </div>
    {
      tabs.map((tab, i) => (
        <div
          class="tabs__panel"
          role="tabpanel"
          id={`pv-panel-${tab.id}`}
          aria-labelledby={`pv-tab-${tab.id}`}
          tabindex="0"
          hidden={i !== 0}
        >
          {tab.body}
        </div>
      ))
    }
  </div>
</PreviewPanel>

<script>
  import { initSegmented } from "../scripts/interactions";

  initSegmented();

  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLElement>('[role="tab"]')];
    const indicator = root.querySelector<HTMLElement>("[data-tabs-indicator]");

    const place = () => {
      const active = tabs.find((t) => t.getAttribute("aria-selected") === "true");
      if (!active || !indicator) return;
      indicator.style.setProperty("--x", `${active.offsetLeft}px`);
      indicator.style.setProperty("--w", `${active.offsetWidth}px`);
    };

    const select = (tab: HTMLElement) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute("aria-controls") ?? "");
        if (!panel) return;
        panel.hidden = !on;
        panel.toggleAttribute("data-entering", on);
      });
      place();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", (event) => {
        const last = tabs.length - 1;
        const next =
          event.key === "ArrowRight" ? (i + 1) % tabs.length
          : event.key === "ArrowLeft" ? (i - 1 + tabs.length) % tabs.length
          : event.key === "Home" ? 0
          : event.key === "End" ? last
          : -1;
        if (next < 0) return;
        event.preventDefault();
        tabs[next].focus();
        select(tabs[next]);
      });
    });

    place();
    new ResizeObserver(place).observe(root);
  });
</script>

<style>
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-6);
  }

  .seg {
    width: fit-content;
    max-width: 100%;
  }
</style>
