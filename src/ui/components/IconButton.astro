---
import type { HTMLAttributes } from "astro/types";
import Icon from "@/ui/icons/Icon.astro";
import type { IconName, IconWeight } from "@/ui/icons";
import { cx } from "@/ui/lib/cx";
import Tooltip from "./Tooltip.astro";

interface Props extends Omit<HTMLAttributes<"button">, "class" | "type"> {
  icon: IconName;
  label: string;
  variant?: "ghost" | "secondary" | "primary" | "danger";
  size?: "sm" | "md" | "lg";
  pressed?: boolean;
  href?: string;
  tooltip?: boolean;
  iconWeight?: IconWeight;
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  icon,
  label,
  variant = "ghost",
  size = "md",
  pressed,
  href,
  tooltip = true,
  iconWeight,
  type = "button",
  disabled = false,
  class: className,
  ...rest
} = Astro.props;

const isLink = href !== undefined;
const Tag = isLink ? "a" : "button";
const attrs = {
  ...rest,
  class: cx("ui-icon-button", className),
  "data-variant": variant,
  "data-size": size,
  "aria-label": label,
  "aria-pressed": pressed === undefined ? undefined : String(pressed),
  ...(isLink
    ? { href: disabled ? undefined : href, "aria-disabled": disabled ? "true" : undefined }
    : { type, disabled }),
};
const weight = iconWeight ?? (pressed ? "fill" : "regular");
---

{
  tooltip ? (
    <Tooltip content={label}>
      <Tag {...attrs}><Icon name={icon} weight={weight} class="ui-icon-button__icon" /></Tag>
    </Tooltip>
  ) : (
    <Tag {...attrs}><Icon name={icon} weight={weight} class="ui-icon-button__icon" /></Tag>
  )
}
