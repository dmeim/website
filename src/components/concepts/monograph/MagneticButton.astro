---
import { ArrowUpRight } from "@lucide/astro";

interface Props {
  href: string;
  label: string;
  /** Text repeated around the rotating ring. */
  ring: string;
}

const { href, label, ring } = Astro.props;
const ringId = `mg-ring-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="mg-magnet" data-mg-magnet>
  <svg class="mg-magnet__ring" viewBox="0 0 200 200" aria-hidden="true">
    <defs>
      <path id={ringId} d="M100,100 m-88,0 a88,88 0 1,1 176,0 a88,88 0 1,1 -176,0"></path>
    </defs>
    <text><textPath href={`#${ringId}`} textLength="552">{ring}</textPath></text>
  </svg>
  <a class="mg-magnet__btn" href={href} data-mg-magnet-target>
    <span class="mg-magnet__inner" data-mg-magnet-inner>
      <ArrowUpRight aria-hidden="true" />
      <span class="mg-magnet__label">{label}</span>
    </span>
  </a>
</div>

<style>
  .mg-magnet {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(200px, 22vw, 260px);
    aspect-ratio: 1;
    flex: none;
  }

  .mg-magnet__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: mg-spin 28s linear infinite;
    fill: var(--mg-ink-muted);
    font-family: var(--mg-font-sans);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .mg-magnet__btn {
    position: relative;
    display: grid;
    place-items: center;
    width: 66%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--mg-ink);
    color: var(--mg-ground);
    transition:
      transform var(--mg-dur-3) var(--mg-ease),
      background-color var(--mg-dur-2) var(--mg-ease);
    will-change: transform;
  }

  .mg-magnet__ring {
    transition: fill var(--mg-dur-2) var(--mg-ease);
  }

  .mg-magnet:hover .mg-magnet__ring,
  .mg-magnet:focus-within .mg-magnet__ring {
    fill: var(--mg-gold);
  }

  .mg-magnet__btn:focus-visible {
    outline-offset: 6px;
  }

  .mg-magnet[data-active] .mg-magnet__btn {
    transition:
      transform var(--mg-dur-1) linear,
      background-color var(--mg-dur-2) var(--mg-ease);
  }

  .mg-magnet__inner {
    display: grid;
    justify-items: center;
    gap: 8px;
    transition: transform var(--mg-dur-3) var(--mg-ease);
  }

  .mg-magnet__inner :global(svg) {
    width: 28px;
    height: 28px;
    stroke-width: 1.25;
    transition: transform var(--mg-dur-2) var(--mg-ease);
  }

  .mg-magnet__btn:hover .mg-magnet__inner :global(svg) {
    transform: rotate(45deg);
  }

  .mg-magnet__label {
    font-size: var(--mg-text-label);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .mg-magnet:hover .mg-magnet__ring {
    animation-duration: 12s;
  }

  @keyframes mg-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mg-magnet__ring {
      animation: none;
    }
  }
</style>

<script>
  import { motionAllowed } from "./monograph-scroll";

  const PULL = 0.32;
  const INNER_PULL = 0.18;

  if (motionAllowed() && window.matchMedia("(pointer: fine)").matches) {
    document.querySelectorAll<HTMLElement>("[data-mg-magnet]").forEach((magnet) => {
      const target = magnet.querySelector<HTMLElement>("[data-mg-magnet-target]");
      const inner = magnet.querySelector<HTMLElement>("[data-mg-magnet-inner]");
      if (!target || !inner) return;
      let frame = 0;

      const reset = (): void => {
        magnet.removeAttribute("data-active");
        target.style.transform = "";
        inner.style.transform = "";
      };

      window.addEventListener(
        "pointermove",
        (event) => {
          cancelAnimationFrame(frame);
          frame = requestAnimationFrame(() => {
            const rect = magnet.getBoundingClientRect();
            const dx = event.clientX - (rect.left + rect.width / 2);
            const dy = event.clientY - (rect.top + rect.height / 2);
            const radius = rect.width * 0.85;
            if (Math.hypot(dx, dy) > radius) {
              if (magnet.hasAttribute("data-active")) reset();
              return;
            }
            magnet.setAttribute("data-active", "");
            target.style.transform = `translate3d(${dx * PULL}px, ${dy * PULL}px, 0)`;
            inner.style.transform = `translate3d(${dx * INNER_PULL}px, ${dy * INNER_PULL}px, 0)`;
          });
        },
        { passive: true },
      );
      document.addEventListener("pointerleave", reset);
    });
  }
</script>
