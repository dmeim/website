---
import { ArrowRight } from "@lucide/astro";
import { currentChapter } from "../../../../content/site";
import Tile from "../Tile.astro";

const summary = currentChapter.body.split(/(?<=\.)\s/)[0];
---

<Tile as="article" class="bento__now now">
  <p class="eyebrow now__eyebrow">
    <span class="now__dot" aria-hidden="true"></span>
    Now · {currentChapter.eyebrow}
  </p>
  <h2 class="display now__title">{currentChapter.title}</h2>
  <p class="now__body">{summary}</p>
  <a class="now__link" href="/projects">
    Follow the build <ArrowRight aria-hidden="true" />
  </a>
</Tile>

<style>
  :global(.tile.now) {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .now__eyebrow {
    color: var(--gold-text);
  }

  .now__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
  }

  .now__title {
    margin-top: var(--s-2);
    font-size: 23px;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .now__body {
    color: var(--ink-muted);
    font-size: 14.5px;
  }

  .now__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: fit-content;
    margin-top: auto;
    padding-top: var(--s-3);
    border-radius: 6px;
    font-size: 14px;
    font-weight: 500;
  }

  .now__link :global(svg) {
    width: 15px;
    height: 15px;
    transition: translate var(--dur) var(--ease-spring);
  }

  .now__link:hover {
    color: var(--gold-text);
  }

  .now__link:hover :global(svg) {
    translate: 3px 0;
  }
</style>
