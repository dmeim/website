---
/**
 * Connect form — fields from `src/content/site.ts`.
 *
 * n8n webhook scaffold:
 * Set `PUBLIC_N8N_WEBHOOK_URL` in `.env` (see `.env.example`) to the n8n
 * webhook endpoint. On submit, the client POSTs JSON:
 *   { name, email, subject, message }
 * If the URL is unset, fields still validate but the UI shows a friendly
 * “form not connected yet” message (no fake success).
 * Turnstile / Workers email / live n8n wiring are intentionally out of scope.
 */
import Button from "@/ui/components/Button.astro";
import FormGrid from "@/ui/components/FormGrid.astro";
import Input from "@/ui/components/Input.astro";
import Notice from "@/ui/components/Notice.astro";
import Spinner from "@/ui/components/Spinner.astro";
import Textarea from "@/ui/components/Textarea.astro";
import { connect } from "@/content/site";
import "./connect.css";

const webhookUrl = import.meta.env.PUBLIC_N8N_WEBHOOK_URL?.trim() ?? "";
const { fields, submitLabel } = connect.form;
const autocomplete = (name: string) => (name === "name" ? "name" : name === "email" ? "email" : undefined);
---

<form class="connect-form" id="connect-form" novalidate data-webhook-url={webhookUrl}>
  <FormGrid columns={2}>
    {
      fields.map((field) =>
        field.type === "textarea" ? (
          <Textarea
            id={field.name}
            name={field.name}
            label={field.label}
            required={field.required}
            placeholder={field.placeholder}
            rows={6}
            span="full"
          />
        ) : (
          <Input
            type={field.type}
            id={field.name}
            name={field.name}
            label={field.label}
            required={field.required}
            placeholder={field.placeholder}
            autocomplete={autocomplete(field.name)}
            span={field.name === "subject" ? "full" : "auto"}
          />
        ),
      )
    }
  </FormGrid>

  <Notice id="connect-form-status" class="form-status" icon={false} hidden />

  <Button type="submit" variant="primary" id="connect-form-submit" class="connect-form__submit">
    {submitLabel}
  </Button>
  <template id="connect-form-spinner"><Spinner size="sm" class="ui-button__spinner" label="Sending" /></template>
</form>

<script>
  type Kind = "idle" | "loading" | "success" | "error" | "disconnected";
  type Control = HTMLInputElement | HTMLTextAreaElement;

  const TONES: Record<Kind, string> = {
    idle: "neutral",
    loading: "neutral",
    success: "success",
    error: "danger",
    disconnected: "warning",
  };

  function initConnectForm() {
    const form = document.getElementById("connect-form");
    if (!(form instanceof HTMLFormElement) || form.dataset.bound === "1") return;
    form.dataset.bound = "1";

    const statusEl = document.getElementById("connect-form-status");
    const submitBtn = document.getElementById("connect-form-submit");
    const spinnerTpl = document.getElementById("connect-form-spinner");
    if (!(statusEl instanceof HTMLElement) || !(submitBtn instanceof HTMLButtonElement)) {
      return;
    }
    const statusBody = statusEl.querySelector<HTMLElement>(".ui-notice__body") ?? statusEl;
    const labelEl = submitBtn.querySelector<HTMLElement>(".ui-button__label") ?? submitBtn;
    const defaultLabel = labelEl.textContent?.trim() || "Send Message";

    function setStatus(message: string, kind: Kind) {
      statusEl.hidden = !message;
      statusBody.textContent = message;
      statusEl.dataset.kind = kind;
      statusEl.dataset.tone = TONES[kind];
      statusEl.classList.remove(...Array.from(statusEl.classList).filter((c) => c.startsWith("form-status--")));
      statusEl.classList.add(`form-status--${kind}`);
    }

    function setLoading(loading: boolean) {
      submitBtn.disabled = loading;
      labelEl.textContent = loading ? "Sending…" : defaultLabel;
      form.setAttribute("aria-busy", loading ? "true" : "false");
      submitBtn.querySelector(".ui-button__spinner")?.remove();
      if (loading) {
        submitBtn.setAttribute("aria-busy", "true");
        if (spinnerTpl instanceof HTMLTemplateElement) submitBtn.append(spinnerTpl.content.cloneNode(true));
      } else {
        submitBtn.removeAttribute("aria-busy");
      }
    }

    function setFieldError(el: Control, message: string) {
      el.setCustomValidity(message);
      const field = el.closest<HTMLElement>(".ui-field");
      const errorId = `${el.id}-error`;
      let errorEl = document.getElementById(errorId);
      if (!message) {
        el.removeAttribute("aria-invalid");
        el.removeAttribute("aria-describedby");
        errorEl?.remove();
        if (field) delete field.dataset.invalid;
        return;
      }
      el.setAttribute("aria-invalid", "true");
      el.setAttribute("aria-describedby", errorId);
      if (field) field.dataset.invalid = "true";
      if (!errorEl) {
        errorEl = document.createElement("p");
        errorEl.className = "ui-field__error";
        errorEl.id = errorId;
        field?.append(errorEl);
      }
      errorEl.textContent = message;
    }

    function messageFor(el: Control): string {
      const value = el.value.trim();
      if (el.required && !value) return "This field is required.";
      // Lightweight client check; server/n8n can validate further.
      if (el.type === "email" && value && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
        return "Please enter a valid email address.";
      }
      return "";
    }

    function validate(): boolean {
      const controls = form.querySelectorAll<Control>("input, textarea");
      let first: Control | null = null;
      for (const el of controls) {
        const message = messageFor(el);
        setFieldError(el, message);
        if (message && !first) first = el;
      }
      if (first) {
        first.reportValidity();
        first.focus();
        return false;
      }
      return form.checkValidity();
    }

    form.addEventListener("input", (event) => {
      const el = event.target;
      if ((el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement) && el.hasAttribute("aria-invalid")) {
        setFieldError(el, messageFor(el));
      }
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      setStatus("", "idle");

      if (!validate()) return;

      const webhook = (form.dataset.webhookUrl ?? "").trim();
      const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      const payload = {
        name: (data.name ?? "").trim(),
        email: (data.email ?? "").trim(),
        subject: (data.subject ?? "").trim(),
        message: (data.message ?? "").trim(),
      };

      if (!webhook) {
        setStatus(
          "Thanks for filling this out — the form is not connected yet. Please email hello@dmeim.com directly for now.",
          "disconnected",
        );
        return;
      }

      setLoading(true);
      setStatus("Sending your message…", "loading");

      try {
        const res = await fetch(webhook, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(payload),
        });

        if (!res.ok) {
          throw new Error(`Request failed (${res.status})`);
        }

        form.reset();
        setStatus("Message sent — thank you. Dimitri will be in touch soon.", "success");
      } catch {
        setStatus(
          "Something went wrong sending your message. Please try again or email hello@dmeim.com directly.",
          "error",
        );
      } finally {
        setLoading(false);
      }
    });
  }

  initConnectForm();
  document.addEventListener("astro:page-load", initConnectForm);
</script>
