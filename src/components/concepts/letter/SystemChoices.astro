---
import Specimen from "./Specimen.astro";
---

<Specimen title="Checkbox and switch">
  <div class="lt-stack lt-stack--tight">
    <label class="lt-check">
      <input type="checkbox" checked />
      <span>Send me a copy</span>
    </label>
    <label class="lt-check">
      <input type="checkbox" />
      <span>Sign the message with my key</span>
    </label>
    <div class="lt-switch-row">
      <span id="sys-switch-label">Notify me of replies</span>
      <button type="button" class="lt-switch" role="switch" aria-checked="false" aria-labelledby="sys-switch-label" data-lt-switch>
        <span class="lt-switch__thumb" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</Specimen>

<Specimen title="Segmented control">
  <fieldset class="lt-seg">
    <legend class="lt-visually-hidden">Density</legend>
    <label><input type="radio" name="sys-density" value="compact" /><span>Compact</span></label>
    <label><input type="radio" name="sys-density" value="regular" checked /><span>Regular</span></label>
    <label><input type="radio" name="sys-density" value="relaxed" /><span>Relaxed</span></label>
  </fieldset>
</Specimen>

<style>
  .lt-check {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    cursor: pointer;
  }

  .lt-check input {
    appearance: none;
    display: grid;
    place-items: center;
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    margin: 0;
    border: 1px solid var(--lt-line-strong);
    border-radius: 3px;
    cursor: pointer;
    transition:
      background-color var(--lt-fast) var(--lt-ease),
      border-color var(--lt-fast) var(--lt-ease);
  }

  .lt-check input::after {
    content: "";
    width: 0.3rem;
    height: 0.55rem;
    margin-top: -0.12rem;
    border: solid var(--lt-ground);
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(45deg) scale(0);
    transition: transform var(--lt-fast) var(--lt-ease);
  }

  .lt-check input:checked {
    background: var(--lt-ink);
    border-color: var(--lt-ink);
  }

  .lt-check input:checked::after {
    transform: rotate(45deg) scale(1);
  }

  .lt-switch-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 20rem;
  }

  .lt-switch {
    position: relative;
    width: 2.25rem;
    height: 1.25rem;
    padding: 0;
    border: 1px solid var(--lt-line-strong);
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
    transition:
      background-color var(--lt-fast) var(--lt-ease),
      border-color var(--lt-fast) var(--lt-ease);
  }

  .lt-switch__thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 50%;
    background: var(--lt-muted);
    transition:
      transform var(--lt-fast) var(--lt-ease),
      background-color var(--lt-fast) var(--lt-ease);
  }

  .lt-switch[aria-checked="true"] {
    background: var(--lt-ink);
    border-color: var(--lt-ink);
  }

  .lt-switch[aria-checked="true"] .lt-switch__thumb {
    background: var(--lt-ground);
    transform: translateX(1rem);
  }

  .lt-seg {
    display: inline-flex;
    margin: 0;
    padding: 2px;
    border: 1px solid var(--lt-line-strong);
    border-radius: var(--lt-radius);
    min-width: 0;
  }

  .lt-seg label {
    position: relative;
    cursor: pointer;
  }

  .lt-seg input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .lt-seg span {
    display: block;
    padding: 0.4rem 0.85rem;
    border-radius: 2px;
    color: var(--lt-muted);
    font-size: var(--lt-small);
    transition:
      background-color var(--lt-fast) var(--lt-ease),
      color var(--lt-fast) var(--lt-ease);
  }

  .lt-seg label:hover span {
    color: var(--lt-ink);
  }

  .lt-seg input:checked + span {
    background: var(--lt-surface);
    color: var(--lt-ink);
  }

  .lt-seg input:focus-visible + span {
    outline: 2px solid var(--lt-gold);
    outline-offset: 1px;
  }
</style>
