---
/**
 * Review-only pill for jumping between concepts. Deliberately neutral so it
 * doesn't bias the comparison; not part of any concept's design.
 */
interface Props {
  active: 1 | 2 | 3 | 4 | 5 | 6;
}

const { active } = Astro.props;

const concepts = [
  { n: 1, href: "/home1", name: "Ledger" },
  { n: 2, href: "/home2", name: "Studio" },
  { n: 3, href: "/home3", name: "Monograph" },
  { n: 4, href: "/home4", name: "Letter" },
  { n: 5, href: "/home5", name: "Profile" },
  { n: 6, href: "/home6", name: "Plain" },
] as const;
---

<nav class="concept-switcher" aria-label="Design concepts">
  {
    concepts.map(({ n, href, name }) => (
      <a href={href} aria-current={n === active ? "page" : undefined} title={name}>
        <span class="concept-switcher__n">{n}</span>
        <span class="concept-switcher__name">{name}</span>
      </a>
    ))
  }
  <a href="/" class="concept-switcher__live">Live</a>
</nav>

<style>
  .concept-switcher {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 2147483000;
    display: flex;
    gap: 2px;
    padding: 4px;
    border-radius: 999px;
    background: rgb(20 20 20 / 88%);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font: 500 12px/1 ui-sans-serif, system-ui, -apple-system, sans-serif;
    letter-spacing: 0;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 10%);
  }

  .concept-switcher a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border-radius: 999px;
    color: rgb(255 255 255 / 70%);
    text-decoration: none;
    transition:
      background-color 150ms ease,
      color 150ms ease;
  }

  .concept-switcher a:hover {
    color: #fff;
    background: rgb(255 255 255 / 10%);
  }

  .concept-switcher a[aria-current="page"] {
    color: #111;
    background: #f2eee6;
  }

  .concept-switcher a:focus-visible {
    outline: 2px solid #d4bc8a;
    outline-offset: 1px;
  }

  .concept-switcher__n {
    font-variant-numeric: tabular-nums;
    opacity: 0.6;
  }

  @media (max-width: 640px) {
    .concept-switcher {
      right: 50%;
      transform: translateX(50%);
    }

    .concept-switcher__name {
      display: none;
    }

    .concept-switcher a[aria-current="page"] .concept-switcher__name {
      display: inline;
    }
  }
</style>
