---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Container, PageHeader, Section, Swatch } from "@/ui/components";
import { uiColorTokenNames } from "@/ui";
import "../components/content-pages/colors.css";

type Token = (typeof uiColorTokenNames)[number];

const groups: { title: string; match: (t: Token) => boolean }[] = [
  { title: "Ground and surface", match: (t) => /^--ui-(bg|surface|field|popover|overlay)/.test(t) },
  { title: "Lines", match: (t) => t.startsWith("--ui-line") },
  { title: "Text", match: (t) => t.startsWith("--ui-text") },
  { title: "Ink", match: (t) => /^--ui-(ink|on-ink)/.test(t) },
  { title: "Accent", match: (t) => /^--ui-(accent|on-accent|focus-ring|selection|highlight)/.test(t) },
  { title: "Tones", match: (t) => /^--ui-(success|warning|danger|info|live)/.test(t) },
];
const grouped = new Set<Token>();
const sections = groups.map((g) => {
  const tokens = uiColorTokenNames.filter((t) => !grouped.has(t) && g.match(t));
  tokens.forEach((t) => grouped.add(t));
  return { title: g.title, tokens };
});
sections.push({ title: "Diff and canvas", tokens: uiColorTokenNames.filter((t) => !grouped.has(t)) });
const themes = ["light", "dark"] as const;
---

<BaseLayout
  title="Colors"
  description="The dmeim.com colour tokens — every --ui-* colour with its light and dark value."
>
  <Container>
    <PageHeader
      title="Colors"
      lede="Every colour token in the live design, shown in the light and dark theme. Values are read from the stylesheet, so this page always matches the site."
    />
    {
      sections.map((section) => (
        <Section title={section.title} spy>
          <ul class="colors-tokens" role="list">
            {section.tokens.map((token) => (
              <li class="colors-token">
                <code class="colors-token__name">{token}</code>
                <div class="colors-token__themes">
                  {themes.map((theme) => (
                    <div class="colors-token__theme" data-theme={theme}>
                      <Swatch
                        color={`var(${token})`}
                        label={theme === "light" ? "Light" : "Dark"}
                        value="—"
                        data-color-token={token}
                      />
                    </div>
                  ))}
                </div>
              </li>
            ))}
          </ul>
        </Section>
      ))
    }
  </Container>
</BaseLayout>

<script>
  function resolveSwatches() {
    document.querySelectorAll<HTMLElement>("[data-color-token]").forEach((swatch) => {
      const token = swatch.dataset.colorToken;
      const out = swatch.querySelector(".ui-swatch__value");
      if (!token || !out) return;
      out.textContent = getComputedStyle(swatch).getPropertyValue(token).trim() || "—";
    });
  }
  resolveSwatches();
</script>
