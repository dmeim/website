---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"kbd"> {
  keys?: string[];
}

const { keys, class: className, ...rest } = Astro.props;
---

{
  keys && keys.length > 0 ? (
    <kbd class:list={["ui-kbd", className]} data-combo {...rest}>
      {keys.map((key, i) => (
        <>
          {i > 0 && <span class="ui-kbd__sep" aria-hidden="true">+</span>}
          <kbd class="ui-kbd__key">{key}</kbd>
        </>
      ))}
    </kbd>
  ) : (
    <kbd class:list={["ui-kbd", className]} {...rest}><slot /></kbd>
  )
}
