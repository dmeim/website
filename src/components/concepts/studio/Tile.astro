---
/**
 * Base surface of the Studio system. Every bento tile, card and preview
 * panel is a Tile so hover, press and reveal behave identically.
 */
import type { HTMLAttributes } from "astro/types";

type Tag = "div" | "article" | "section" | "aside" | "figure" | "a" | "li";

interface Props extends HTMLAttributes<"div"> {
  as?: Tag;
  href?: string;
  target?: string;
  rel?: string;
  tone?: "default" | "alt" | "inverse";
  spotlight?: boolean;
  pressable?: boolean;
  reveal?: boolean;
}

const {
  as: Element = "div",
  class: className,
  tone = "default",
  spotlight = true,
  pressable = false,
  reveal = true,
  ...rest
} = Astro.props;
---

<Element
  class:list={["tile", tone !== "default" && `tile--${tone}`, className]}
  data-spotlight={spotlight ? "" : undefined}
  data-pressable={pressable ? "" : undefined}
  data-reveal={reveal ? "" : undefined}
  {...rest}
>
  <slot />
</Element>
