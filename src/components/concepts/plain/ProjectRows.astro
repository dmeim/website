---
import { ArrowRight, ArrowUpRight } from "@lucide/astro";
import { projects } from "../../../content/site";

const statusLabel = { live: "Live", wip: "In progress", archived: "Archived" } as const;
const isExternal = (href: string) => href.startsWith("http://") || href.startsWith("https://");
---

<h3 class="pl-work__list-title" data-reveal>Projects</h3>
<ul class="pl-rows" data-reveal-group>
  {
    projects.map((project) => {
      const body = (
        <>
          <span class="pl-rows__title">{project.title}</span>
          <span class="pl-rows__tags">{project.tags.join(" · ")}</span>
          <span class={`pl-badge pl-badge--${project.status}`}>{statusLabel[project.status]}</span>
        </>
      );
      return (
        <li data-reveal>
          {project.href ? (
            <a
              class="pl-rows__row pl-rows__row--link"
              href={project.href}
              {...(isExternal(project.href) ? { target: "_blank", rel: "noopener" } : {})}
            >
              {body}
              {isExternal(project.href) ? (
                <>
                  <span class="pl-sr-only">(opens in a new tab)</span>
                  <ArrowUpRight class="pl-rows__arrow" aria-hidden="true" />
                </>
              ) : (
                <ArrowRight class="pl-rows__arrow" aria-hidden="true" />
              )}
            </a>
          ) : (
            <div class="pl-rows__row">
              {body}
              <span class="pl-rows__arrow" aria-hidden="true" />
            </div>
          )}
        </li>
      );
    })
  }
</ul>

<style>
  .pl-work__list-title {
    margin: 56px 0 16px;
    color: var(--pl-muted);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0;
  }

  /* Grouped list: separate fills with 2px gaps instead of divider lines. */
  .pl-rows {
    display: grid;
    gap: 2px;
  }

  .pl-rows__row {
    --pl-field: var(--pl-ground);
    display: grid;
    grid-template-columns: 1fr auto 20px;
    align-items: center;
    column-gap: 16px;
    min-height: 64px;
    padding: 12px 20px;
    border-radius: 6px;
    background: var(--pl-surface);
  }

  .pl-rows > li:first-child .pl-rows__row {
    border-top-left-radius: var(--pl-radius-panel);
    border-top-right-radius: var(--pl-radius-panel);
  }

  .pl-rows > li:last-child .pl-rows__row {
    border-bottom-left-radius: var(--pl-radius-panel);
    border-bottom-right-radius: var(--pl-radius-panel);
  }

  .pl-rows__row--link {
    transition:
      background-color var(--pl-fast) var(--pl-ease),
      transform var(--pl-fast) var(--pl-ease);
  }

  .pl-rows__row--link:hover {
    background: var(--pl-surface-hover);
  }

  .pl-rows__row--link:active {
    transform: scale(0.99);
  }

  .pl-rows__title {
    font-weight: 600;
  }

  .pl-rows__tags {
    display: none;
    color: var(--pl-muted);
    font-size: 0.875rem;
  }

  .pl-rows :global(.pl-rows__arrow) {
    width: 18px;
    height: 18px;
    color: var(--pl-muted);
  }

  @media (min-width: 720px) {
    /* Each row is its own grid, so fixed tracks keep the columns aligned. */
    .pl-rows__row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 7rem 20px;
      padding-inline: 24px;
    }

    .pl-rows .pl-badge {
      justify-self: end;
    }

    .pl-rows__tags {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pl-rows__row--link:active {
      transform: none;
    }
  }
</style>
