---
/**
 * Text segmented control for theme preference. State is owned by the
 * shared concept runtime via `data-theme-set` / `aria-pressed`.
 */
const options = [
  { value: "light", label: "Light" },
  { value: "system", label: "Auto" },
  { value: "dark", label: "Dark" },
];
---

<div class="theme" role="group" aria-label="Colour theme">
  {
    options.map((o) => (
      <button type="button" class="theme__opt" data-theme-set={o.value} aria-pressed="false">
        {o.label}
      </button>
    ))
  }
</div>

<style>
  .theme {
    display: inline-flex;
    border: 1px solid var(--l-line);
  }

  .theme__opt {
    position: relative;
    padding: 0.4rem 0.6rem;
    border: 0;
    background: none;
    font-family: var(--l-mono);
    font-size: var(--l-text-2xs);
    letter-spacing: var(--l-track-mono);
    text-transform: uppercase;
    color: var(--l-ink-muted);
    cursor: pointer;
    transition:
      color var(--l-dur-fast) var(--l-ease),
      background-color var(--l-dur-fast) var(--l-ease);
  }

  .theme__opt + .theme__opt {
    border-left: 1px solid var(--l-line);
  }

  .theme__opt:hover {
    color: var(--l-ink);
  }

  .theme__opt[aria-pressed="true"] {
    background: var(--l-ink);
    color: var(--l-ground);
  }

  .theme__opt:focus-visible {
    outline-offset: -2px;
    z-index: 1;
  }
</style>
