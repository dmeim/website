---
/**
 * Contact: oversized email link with a drawing underline, plus GitHub.
 */
import { ArrowUpRight } from "@lucide/astro";
import { connect } from "../../../content/site";
import SectionHead from "./SectionHead.astro";
---

<section class="ct l-section" id="contact" aria-labelledby="contact-title">
  <div class="l-container">
    <SectionHead index="07" label="Contact" meta={connect.location} />
    <h2 class="l-sr-only" id="contact-title">Contact</h2>

    <p class="ct__intro" data-reveal>{connect.intro}</p>

    <a class="ct__email" href={`mailto:${connect.email}`} data-reveal>
      <span class="ct__email-text">{connect.email}</span>
    </a>

    <dl class="ct__meta" data-reveal-group>
      <div data-reveal>
        <dt class="l-mono l-muted">Encrypted mail</dt>
        <dd><a class="l-link" href="/keys">Use the published GPG key</a></dd>
      </div>
      <div data-reveal>
        <dt class="l-mono l-muted">{connect.socialLabel}</dt>
        <dd>
          <a class="ct__ext l-link" href={connect.socialUrl} target="_blank" rel="noopener noreferrer">
            {connect.socialHandle}<span class="l-sr-only"> (opens in a new tab)</span>
          </a>
          <ArrowUpRight size={16} stroke-width={1.75} aria-hidden="true" class="ct__icon" />
        </dd>
      </div>
      <div data-reveal>
        <dt class="l-mono l-muted">Availability</dt>
        <dd>{connect.locationDetail}</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .ct__intro {
    max-width: 34ch;
    font-size: var(--l-text-lg);
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .ct__email {
    display: inline-block;
    max-width: 100%;
    margin-top: clamp(2rem, 1rem + 3vw, 4rem);
    font-size: clamp(2rem, 0.2rem + 10.2vw, 9rem);
    font-weight: 450;
    letter-spacing: var(--l-track-display);
    line-height: 1;
    overflow-wrap: anywhere;
  }

  .ct__email-text {
    background-image: linear-gradient(var(--l-gold), var(--l-gold)), linear-gradient(var(--l-line-strong), var(--l-line-strong));
    background-size: 0% 2px, 100% 1px;
    background-position: 0 100%, 0 100%;
    background-repeat: no-repeat;
    padding-bottom: 0.06em;
    transition: background-size 700ms var(--l-ease), color var(--l-dur) var(--l-ease);
  }

  .ct__email:hover .ct__email-text,
  .ct__email:focus-visible .ct__email-text {
    background-size: 100% 2px, 100% 1px;
  }

  .ct__email:hover {
    color: var(--l-gold-ink);
  }

  .ct__meta {
    display: grid;
    margin-top: clamp(3rem, 2rem + 4vw, 6rem);
    border-top: 1px solid var(--l-line-strong);
  }

  .ct__meta > div {
    display: grid;
    gap: var(--l-space-2);
    padding: var(--l-space-4) 0;
    border-bottom: 1px solid var(--l-line);
  }

  .ct__meta dd {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    font-size: var(--l-text-sm);
  }

  .ct__meta :global(.ct__icon) {
    color: var(--l-gold);
  }

  @media (min-width: 900px) {
    .ct__intro {
      margin-left: calc((100% + var(--l-col-gap)) / 12 * 3);
    }

    .ct__meta {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--l-col-gap);
      border-bottom: 1px solid var(--l-line);
    }

    .ct__meta > div {
      grid-column: span 3;
      border-bottom: 0;
    }

    .ct__meta > div:first-child {
      grid-column: 4 / span 3;
    }
  }
</style>
