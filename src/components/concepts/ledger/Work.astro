---
/**
 * Selected work as an editorial index. Rows are real links; on fine
 * pointers a preview card trails the cursor (see WorkPreview).
 */
import SectionHead from "./SectionHead.astro";
import WorkPreview from "./WorkPreview.astro";
import WorkRow from "./WorkRow.astro";
import { pad, workRows } from "./work-rows";

const rows = workRows();
---

<section class="work l-section" id="work" aria-labelledby="work-title">
  <div class="l-container">
    <SectionHead
      index="03"
      label="Selected work"
      meta={`${pad(rows.length)} entries`}
      title="Platforms, projects, and the trust layer between them."
      titleId="work-title"
    />

    <div class="work__cols l-mono l-muted" aria-hidden="true">
      <span>No.</span><span>Title</span><span>Context</span><span>Period</span><span>Tags</span>
    </div>

    <ol class="work__list" data-work-list data-reveal-group>
      {
        rows.map((row, i) => (
          <li data-reveal>
            <WorkRow row={row} index={i} />
          </li>
        ))
      }
    </ol>
  </div>
  <WorkPreview />
</section>

<style>
  .work__cols {
    display: none;
  }

  .work__list {
    border-top: 1px solid var(--l-line-strong);
  }

  .work__list > li {
    border-bottom: 1px solid var(--l-line);
  }

  @media (min-width: 900px) {
    .work__cols {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--l-col-gap);
      padding-bottom: var(--l-space-3);
    }

    .work__cols span:nth-child(2) {
      grid-column: 2 / span 4;
    }

    .work__cols span:nth-child(3) {
      grid-column: 6 / span 2;
    }

    .work__cols span:nth-child(4) {
      grid-column: 8 / span 2;
    }

    .work__cols span:nth-child(5) {
      grid-column: 10 / span 2;
    }
  }
</style>
