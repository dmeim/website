---
import { ArrowRight, Check, Copy, KeyRound } from "@lucide/astro";
import { keys } from "../../../../content/site";
import Tile from "../Tile.astro";
---

<Tile as="section" class="bento__keys keys" aria-labelledby="keys-title">
  <div class="keys__head">
    <p class="eyebrow" id="keys-title">
      <KeyRound class="keys__icon" aria-hidden="true" />
      Public keys
    </p>
    <a class="keys__all" href="/keys">
      Verify &amp; import <ArrowRight aria-hidden="true" />
    </a>
  </div>

  <p class="keys__lede">Fingerprints published openly, so anything signed by dmeim can be checked later.</p>

  <ul class="keys__list">
    {
      keys.map((key) => (
        <li class="keys__row">
          <span class="keys__kind mono">{key.kind}</span>
          <div class="keys__meta">
            <span class="keys__title">{key.title}</span>
            <code class="keys__fp" title={key.fingerprint}>
              {key.fingerprint}
            </code>
          </div>
          <button
            type="button"
            class="btn btn--ghost btn--icon btn--sm copy-btn tip-anchor"
            data-copy={key.fingerprint}
            data-copy-label={`${key.title} fingerprint copied`}
            aria-label={`Copy ${key.title} fingerprint`}
          >
            <span class="copy-btn__icons" aria-hidden="true">
              <Copy class="copy-btn__copy" />
              <Check class="copy-btn__check" />
            </span>
            <span class="tip" aria-hidden="true">
              <span class="copy-btn__tip-idle">Copy</span>
              <span class="copy-btn__tip-done">Copied</span>
            </span>
          </button>
        </li>
      ))
    }
  </ul>
</Tile>

<script>
  import { initCopyButtons } from "../scripts/interactions";
  initCopyButtons();
</script>

<style>
  :global(.tile.keys) {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .keys__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
  }

  .keys__head :global(.keys__icon) {
    width: 14px;
    height: 14px;
    color: var(--gold-text);
  }

  .keys__all {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-muted);
    transition: color var(--dur-fast) var(--ease);
  }

  .keys__all :global(svg) {
    width: 14px;
    height: 14px;
    transition: translate var(--dur) var(--ease-spring);
  }

  .keys__all:hover {
    color: var(--ink);
  }

  .keys__all:hover :global(svg) {
    translate: 3px 0;
  }

  .keys__lede {
    max-width: 40ch;
    font-size: 14px;
    color: var(--ink-muted);
  }

  .keys__list {
    display: grid;
    gap: var(--s-2);
    margin-top: auto;
  }

  .keys__row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s-3);
    padding: 10px 8px 10px 10px;
    border: 1px solid var(--border);
    border-radius: var(--r-control);
    background: var(--ground);
  }

  .keys__kind {
    display: grid;
    place-items: center;
    width: 40px;
    height: 32px;
    border-radius: 8px;
    background: var(--gold-soft);
    color: var(--gold-text);
    font-size: 11px;
    font-weight: 500;
  }

  .keys__meta {
    display: grid;
    min-width: 0;
  }

  .keys__title {
    font-size: 13.5px;
    font-weight: 500;
  }

  .keys__fp {
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--ink-muted);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .copy-btn__icons {
    position: relative;
    display: grid;
    width: 16px;
    height: 16px;
  }

  .copy-btn__icons :global(svg) {
    grid-area: 1 / 1;
    transition:
      opacity var(--dur-fast) var(--ease),
      scale var(--dur) var(--ease-spring),
      rotate var(--dur) var(--ease);
  }

  .copy-btn__icons :global(.copy-btn__check) {
    opacity: 0;
    scale: 0.4;
    rotate: -45deg;
    color: var(--gold-text);
  }

  .copy-btn[data-copied] :global(.copy-btn__copy) {
    opacity: 0;
    scale: 0.4;
    rotate: 45deg;
  }

  .copy-btn[data-copied] :global(.copy-btn__check) {
    opacity: 1;
    scale: 1;
    rotate: 0deg;
  }

  .copy-btn__tip-done,
  .copy-btn[data-copied] .copy-btn__tip-idle {
    display: none;
  }

  .copy-btn[data-copied] .copy-btn__tip-done {
    display: inline;
  }

  .copy-btn[data-copied] .tip {
    opacity: 1;
    translate: -50% 0;
    scale: 1;
  }
</style>
