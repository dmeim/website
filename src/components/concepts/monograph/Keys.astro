---
import { ArrowRight } from "@lucide/astro";
import { keys } from "../../../content/site";
import CopyButton from "./CopyButton.astro";
---

<section class="mg-keys mg-section" id="keys" aria-labelledby="mg-keys-title">
  <div class="mg-container">
    <header class="mg-keys__head" data-reveal-group>
      <div class="mg-section-head">
        <p class="mg-label" data-reveal><span class="mg-label__num">05</span>Public keys</p>
        <h2 class="mg-display mg-display--md" id="mg-keys-title" data-reveal>Verify, <em>then</em> trust</h2>
      </div>
      <p class="mg-lede" data-reveal>
        Fingerprints are published openly so anything signed in my name can be checked against them.
      </p>
    </header>

    <ul class="mg-keys__grid" data-reveal-group>
      {
        keys.map((key) => (
          <li data-reveal>
            <article class="mg-key" aria-labelledby={`mg-key-${key.id}`}>
              <div class="mg-key__top">
                <span class="mg-badge">{key.kind}</span>
                <h3 class="mg-key__title" id={`mg-key-${key.id}`}>{key.title}</h3>
              </div>
              <div class="mg-key__fp">
                <p class="mg-label">Fingerprint</p>
                <code>{key.fingerprint}</code>
              </div>
              <p class="mg-key__usage">
                <span class="mg-label">Usage</span>
                <code>{key.usage}</code>
              </p>
              <div class="mg-key__actions">
                <CopyButton value={key.fingerprint} label={`Copy ${key.title} fingerprint`} />
                <a class="mg-btn mg-btn--ghost" href={`/keys#${key.id}`}>
                  Full key <ArrowRight aria-hidden="true" />
                </a>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .mg-keys__head {
    display: grid;
    gap: 24px;
    margin-bottom: clamp(48px, 6vw, 88px);
  }

  .mg-keys__head .mg-section-head {
    margin-bottom: 0;
  }

  .mg-keys__grid {
    display: grid;
    gap: clamp(16px, 2vw, 28px);
  }

  .mg-key {
    display: grid;
    gap: 28px;
    height: 100%;
    padding: clamp(24px, 3vw, 44px);
    border: 1px solid var(--mg-line);
    background: var(--mg-surface);
    transition: border-color var(--mg-dur-2) var(--mg-ease);
  }

  .mg-key:hover,
  .mg-key:focus-within {
    border-color: var(--mg-line-strong);
  }

  .mg-key__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .mg-key__title {
    font-family: var(--mg-font-display);
    font-weight: 400;
    font-size: clamp(1.75rem, 1.3rem + 1.2vw, 2.5rem);
    line-height: 1;
    order: -1;
  }

  .mg-key__fp {
    display: grid;
    gap: 12px;
    padding-block: 22px;
    border-block: 1px solid var(--mg-line);
  }

  .mg-key code {
    font-family: var(--mg-font-mono);
    font-size: 0.9375rem;
    line-height: 1.7;
    letter-spacing: 0.04em;
    overflow-wrap: anywhere;
    color: var(--mg-ink);
  }

  .mg-key__fp code {
    font-size: clamp(0.9375rem, 0.8rem + 0.4vw, 1.125rem);
  }

  .mg-key__usage {
    display: grid;
    gap: 6px;
  }

  .mg-key__usage code {
    color: var(--mg-ink-muted);
    font-size: 0.8125rem;
  }

  .mg-key__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  @media (min-width: 900px) {
    .mg-keys__head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }

    .mg-keys__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
