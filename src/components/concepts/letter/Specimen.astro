---
/** One labelled sample in the component appendix. */
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="lt-spec">
  <h3 class="lt-label lt-spec__title">{title}</h3>
  <div class="lt-spec__body"><slot /></div>
</div>

<style>
  .lt-spec {
    padding-block: 1.75rem;
    border-top: 1px solid var(--lt-line);
  }

  .lt-spec__title {
    margin-bottom: 1rem;
  }

  .lt-spec__body {
    font-size: 1rem;
  }
</style>
