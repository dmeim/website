---
/** Now: the page's one statement (h1), a follow-up line, and the current chapter. */
import Section from "@/ui/components/Section.astro";
import List from "@/ui/components/List.astro";
import ListRow from "@/ui/components/ListRow.astro";
import { currentChapter, shortBio } from "@/content/site";

const sentences = shortBio.split(/(?<=\.)\s+/);
const lead = sentences.slice(0, 2).join(" ");
const follow = sentences[2] ?? "";
// Only the first sentence of the chapter body is current; the rest is stale.
const nowLine = currentChapter.body.split(/(?<=\.)\s+/)[0];
---

<Section id="now" title="Now" spy class="home-section" data-reveal-group>
  <div class="home-intro">
    <h1 class="home-intro__lead" data-reveal>{lead}</h1>
    {follow && <p class="home-intro__more" data-reveal>{follow}</p>}
  </div>
  <List>
    <ListRow label="Current" title={currentChapter.title} description={nowLine} data-reveal />
  </List>
</Section>
