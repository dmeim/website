---
/**
 * Full-width band of available tool names. The track is duplicated so the
 * loop is seamless; the copy is hidden from assistive tech.
 */
import { availableTools } from "../../../content/tools";

const names = availableTools().map((t) => t.title);
const duration = `${Math.round(names.length * 2.6)}s`;
---

<section class="marquee" aria-label={`${names.length} tools available`}>
  <a class="marquee__label l-mono" href="/tools">
    <span class="l-num">{names.length}</span> tools
    <span aria-hidden="true">→</span>
  </a>
  <div class="marquee__viewport">
    <div class="marquee__track" style={`--dur:${duration}`}>
      {
        [0, 1].map((copy) => (
          <ul class="marquee__list l-mono" aria-hidden={copy === 1 ? "true" : undefined}>
            {names.map((name) => (
              <li>{name}</li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>

<style>
  .marquee {
    display: flex;
    align-items: stretch;
    border-block: 1px solid var(--l-line);
    background: var(--l-ground);
  }

  .marquee__label {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0 var(--l-gutter);
    border-right: 1px solid var(--l-line);
    background: var(--l-ink);
    color: var(--l-ground);
    transition: background-color var(--l-dur-fast) var(--l-ease);
  }

  .marquee__label:hover {
    background: var(--l-gold);
    color: var(--l-on-gold);
  }

  .marquee__label:focus-visible {
    outline-offset: -4px;
  }

  .marquee__viewport {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: ledger-marquee var(--dur) linear infinite;
  }

  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }

  .marquee__list {
    display: flex;
    flex: none;
  }

  .marquee__list li {
    display: inline-flex;
    align-items: center;
    padding: 1rem 0;
    white-space: nowrap;
    color: var(--l-ink-muted);
    transition: color var(--l-dur-fast) var(--l-ease);
  }

  .marquee__list li:hover {
    color: var(--l-ink);
  }

  .marquee__list li::after {
    content: "/";
    padding-inline: 1.1rem;
    color: var(--l-gold);
  }

  @keyframes ledger-marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }

    .marquee__viewport {
      overflow-x: auto;
      mask-image: none;
    }

    .marquee__list[aria-hidden="true"] {
      display: none;
    }
  }
</style>
