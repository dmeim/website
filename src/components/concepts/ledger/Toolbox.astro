---
/**
 * Toolbox figures (count up on reveal) and the stack as a hairline grid.
 * Numbers render final on the server; the script only animates from zero.
 */
import { allTools, availableTools, plannedTools, toolCategories } from "../../../content/tools";
import { venues } from "../../../content/site";
import SectionHead from "./SectionHead.astro";
import Button from "./Button.astro";

const figures = [
  { value: availableTools().length, label: "Tools available", note: "Run locally in the browser" },
  { value: toolCategories.length, label: "Categories", note: "From encoders to network utilities" },
];

// "0 planned" reads as a dead number; fall back to the tag index when the queue is empty.
const planned = plannedTools().length;
const tagCount = new Set(allTools().flatMap((t) => t.tags ?? [])).size;
figures.push(
  planned > 0
    ? { value: planned, label: "Planned", note: "Queued for the catalogue" }
    : { value: tagCount, label: "Search tags", note: "Indexed across the catalogue" },
);
---

<section class="tb l-section" id="toolbox" aria-labelledby="toolbox-title">
  <div class="l-container">
    <SectionHead index="04" label="Toolbox" title="Private, local-first utilities." titleId="toolbox-title" />

    <dl class="tb__figs" data-reveal-group>
      {
        figures.map((f) => (
          <div class="tb__fig" data-reveal>
            <dt class="l-mono l-muted">{f.label}</dt>
            <dd class="tb__num l-num" data-count={f.value}>
              {f.value}
            </dd>
            <dd class="tb__note l-muted">{f.note}</dd>
          </div>
        ))
      }
    </dl>

    <div class="tb__stack">
      <p class="tb__stack-label l-mono"><span class="l-gold">Stack</span> / What it runs on</p>
      <ul class="tb__grid" data-reveal-group>
        {
          venues.map((v, i) => (
            <li class="tb__cell" data-reveal>
              <span class="l-mono l-gold l-num">{String.fromCharCode(65 + i)}</span>
              <span class="tb__name">{v.name}</span>
              <span class="tb__place l-mono l-muted">{v.place}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="tb__cta">
      <Button href="/tools" variant="secondary" arrow>Browse the toolbox</Button>
    </div>
  </div>
</section>

<script>
  import { prefersReducedMotion } from "../shared/concept-runtime";

  const counters = document.querySelectorAll<HTMLElement>("[data-count]");

  const run = (el: HTMLElement) => {
    const end = Number(el.dataset.count);
    const start = performance.now();
    const duration = 1400;
    const tick = (now: number) => {
      const t = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - t, 4);
      el.textContent = String(Math.round(end * eased));
      if (t < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  if (counters.length && !prefersReducedMotion() && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          run(entry.target as HTMLElement);
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.6 },
    );
    counters.forEach((el) => {
      el.textContent = "0";
      observer.observe(el);
    });
  }
</script>

<style>
  .tb__figs {
    display: grid;
    border-top: 1px solid var(--l-line-strong);
  }

  .tb__fig {
    display: grid;
    gap: var(--l-space-2);
    padding: var(--l-space-5) 0 var(--l-space-6);
    border-bottom: 1px solid var(--l-line);
  }

  .tb__fig dd {
    margin: 0;
  }

  .tb__num {
    font-size: var(--l-text-3xl);
    font-weight: 400;
    letter-spacing: var(--l-track-display);
    line-height: 0.9;
  }

  .tb__note {
    font-size: var(--l-text-sm);
  }

  .tb__stack {
    margin-top: clamp(4rem, 2rem + 5vw, 7rem);
  }

  .tb__stack-label {
    padding-bottom: var(--l-space-3);
  }

  .tb__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--l-line-strong);
    border-left: 1px solid var(--l-line);
  }

  .tb__cell {
    display: grid;
    align-content: space-between;
    gap: var(--l-space-6);
    min-height: 11rem;
    padding: var(--l-space-4);
    border-right: 1px solid var(--l-line);
    border-bottom: 1px solid var(--l-line);
    transition: background-color var(--l-dur) var(--l-ease);
  }

  .tb__cell:hover {
    background: var(--l-surface);
  }

  .tb__name {
    font-size: var(--l-text-lg);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .tb__cta {
    margin-top: var(--l-space-6);
  }

  @media (min-width: 900px) {
    .tb__figs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-bottom: 1px solid var(--l-line);
    }

    .tb__fig {
      padding: var(--l-space-5) var(--l-space-5) var(--l-space-7) 0;
      border-bottom: 0;
    }

    .tb__fig + .tb__fig {
      padding-left: var(--l-space-5);
      border-left: 1px solid var(--l-line);
    }

    .tb__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .tb__cell {
      min-height: 15rem;
      padding: var(--l-space-5);
    }
  }
</style>
