---
import type { HTMLAttributes } from "astro/types";
import { cx } from "@/ui/lib/cx";
import { fullName } from "@/ui/lib/identity";
import IdentityLinks from "./IdentityLinks.astro";

/** Copyright beside the same contact and crypto rows as SiteIdentity. */
interface Props extends Omit<HTMLAttributes<"footer">, "class"> {
  immersive?: boolean;
  class?: string;
}

const { immersive = false, class: className, ...rest } = Astro.props;
const year = new Date().getFullYear();
---

{
  !immersive && (
    <footer {...rest} class={cx("ui-site-footer", className)}>
      <p class="ui-site-footer__copy">&copy; {year} {fullName}</p>
      <div class="ui-site-footer__links">
        <IdentityLinks />
      </div>
    </footer>
  )
}
