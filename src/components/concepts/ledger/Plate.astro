---
/**
 * Image plate: flat surface rectangle with a captioned figure line.
 * Revealed with a bottom-up clip-path wipe; the image settles from a slight
 * scale. Built for transparent cut-outs anchored to the bottom edge.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  figure: string;
  caption: string;
  sizes?: string;
  eager?: boolean;
}

const { src, alt, figure, caption, sizes = "100vw", eager = false } = Astro.props;
---

<figure class="plate">
  <div class="plate__frame">
    <Image
      src={src}
      alt={alt}
      widths={[420, 640, 900, src.width]}
      sizes={sizes}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
      class="plate__img"
    />
  </div>
  <figcaption class="plate__caption l-mono l-muted">
    <span>{figure}</span><span>{caption}</span>
  </figcaption>
</figure>

<style>
  .plate__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--l-surface);
    animation: ledger-wipe 1.3s var(--l-ease) 450ms both;
  }

  :global([data-theme="dark"]) .plate__frame {
    background: var(--l-surface-2);
  }

  .plate__frame :global(.plate__img) {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 92%;
    height: auto;
    translate: -50% 0;
    animation: ledger-settle 1.8s var(--l-ease) 450ms both;
  }

  .plate__caption {
    display: flex;
    justify-content: space-between;
    padding-top: var(--l-space-3);
  }

  @keyframes ledger-wipe {
    from {
      clip-path: inset(100% 0 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes ledger-settle {
    from {
      transform: scale(1.08);
    }
  }
</style>
