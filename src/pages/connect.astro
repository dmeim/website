---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/ui/components/Container.astro";
import PageHeader from "@/ui/components/PageHeader.astro";
import Section from "@/ui/components/Section.astro";
import ConnectInfo from "@/components/connect/ConnectInfo.astro";
import ConnectForm from "@/components/connect/ConnectForm.astro";
import { connect, meta } from "@/content/site";
---

<BaseLayout title="Connect" description={meta.description}>
  <Container>
    <PageHeader title="Let's Connect" titleId="connect-heading" lede={connect.intro} />
    <Section title="Details" spy>
      <ConnectInfo />
    </Section>
    <Section title="Message" spy>
      <ConnectForm />
    </Section>
  </Container>
</BaseLayout>
