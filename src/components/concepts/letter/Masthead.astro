---
/** Top row: the handle on the left, theme choice as three quiet words on the right. */
const options = [
  { value: "light", label: "Light" },
  { value: "system", label: "Auto" },
  { value: "dark", label: "Dark" },
] as const;
---

<header class="lt-masthead lt-column">
  <a class="lt-masthead__name" href="/home4">dmeim</a>
  <div class="lt-theme" role="group" aria-label="Color theme">
    {
      options.map(({ value, label }, i) => (
        <>
          {i > 0 && <span class="lt-theme__sep" aria-hidden="true">·</span>}
          <button type="button" class="lt-theme__opt" data-theme-set={value} aria-pressed="false">
            {label}
          </button>
        </>
      ))
    }
  </div>
</header>

<style>
  .lt-masthead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-top: clamp(1.25rem, 3vw, 2rem);
    font-size: var(--lt-small);
  }

  .lt-masthead__name {
    color: var(--lt-ink);
    font-weight: 500;
    letter-spacing: 0.01em;
    text-decoration: none;
  }

  .lt-theme {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    color: var(--lt-muted);
  }

  .lt-theme__sep {
    opacity: 0.6;
  }

  .lt-theme__opt {
    padding: 0.25rem 0.1rem;
    border: 0;
    background: none;
    color: var(--lt-muted);
    cursor: pointer;
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
    transition:
      color var(--lt-fast) var(--lt-ease),
      text-decoration-color var(--lt-fast) var(--lt-ease);
  }

  .lt-theme__opt:hover {
    color: var(--lt-ink);
  }

  .lt-theme__opt[aria-pressed="true"] {
    color: var(--lt-ink);
    text-decoration-color: var(--lt-gold);
  }
</style>
