---
/** About: the page's one statement (h1), a follow-up line, and links into the site. */
import Section from "@/ui/components/Section.astro";
import Button from "@/ui/components/Button.astro";
import type { IconName } from "@/ui/icons";
import { summary } from "@/content/resume";
import { defaultNavItems } from "@/ui/lib/site-nav";

// Same pages and order as the site nav (minus Home); Orthodox keeps its cross glyph instead of an icon.
const icons: Record<string, IconName> = {
  "/projects": "code",
  "/gallery": "images",
  "/tools": "toolbox",
  "/keys": "key",
  "/game-of-life": "grid-four",
};
const destinations = defaultNavItems
  .filter(({ href }) => href !== "/")
  .map(({ href, label, glyph }) => ({ href, label, glyph, icon: icons[href] }));
---

<Section id="about" title="About" spy class="home-section" data-reveal-group>
  <div class="home-intro">
    <h1 class="home-intro__lead" data-reveal>{summary.lead}</h1>
    <p class="home-intro__more" data-reveal>{summary.more}</p>
  </div>
  <nav class="home-explore" aria-label="Explore the site" data-reveal>
    {
      destinations.map(({ href, label, icon, glyph }) => (
        <Button href={href} variant="secondary" iconStart={icon} size="sm">
          {label}
          {glyph && <span class="home-explore__glyph" aria-hidden="true">{glyph}</span>}
        </Button>
      ))
    }
  </nav>
</Section>
