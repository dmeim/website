---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/ui/components/Button.astro";
import Container from "@/ui/components/Container.astro";
import Link from "@/ui/components/Link.astro";
import PageHeader from "@/ui/components/PageHeader.astro";
import Prose from "@/ui/components/Prose.astro";
import Section from "@/ui/components/Section.astro";
import Stack from "@/ui/components/Stack.astro";
---

<BaseLayout
  title="Game of Life"
  description="Conway's Game of Life explained, with a full-page simulator you can draw on and run."
>
  <Container>
    <PageHeader
      title="Game of Life"
      lede="A zero-player cellular automaton. Set the stage, then watch the rules unfold."
    >
      <Button slot="actions" variant="primary" href="/game-of-life/simulation" iconEnd="arrow-right">
        Open the simulation
      </Button>
    </PageHeader>

    <Section title="About" spy>
      <Prose as="article">
        <p>
          Conway's Game of Life is a cellular automaton devised by the British
          mathematician John Horton Conway. It is a zero-player game: once you set
          the initial pattern, the system evolves from generation to generation
          with no further input.
        </p>
        <p>
          Each cell on the grid is either live or dead. Every generation applies
          the classic B3/S23 rules to every cell at once (birth on three neighbors,
          survival on two or three):
        </p>
        <ol>
          <li>
            <strong>Underpopulation.</strong> A live cell with fewer than two live
            neighbors dies.
          </li>
          <li>
            <strong>Survival.</strong> A live cell with two or three live neighbors
            lives on.
          </li>
          <li>
            <strong>Overpopulation.</strong> A live cell with more than three live
            neighbors dies.
          </li>
          <li>
            <strong>Reproduction.</strong> A dead cell with exactly three live
            neighbors becomes live.
          </li>
        </ol>
      </Prose>
      <Prose size="sm">
        <p>
          Overview adapted from{" "}
          <Link href="https://en.wikipedia.org/wiki/Conway's_Game_of_Life" external>
            Conway's Game of Life on Wikipedia
          </Link>.
        </p>
      </Prose>
    </Section>

    <Section title="Step onto the grid" eyebrow="Simulation" spy>
      <Stack gap="md" align="start">
        <Prose>
          <p>
            The board fills the screen and wraps at the edges, so patterns that
            leave one side return on the other. It opens with a random soup of
            cells, paused.
          </p>
          <ul>
            <li>Click or drag to draw cells, and right-click to erase them.</li>
            <li>Press Space to start or pause, and the right arrow to step once.</li>
            <li>Use Random for a fresh soup, Clear for an empty board, and Speed to set the pace.</li>
          </ul>
        </Prose>
        <Button variant="primary" href="/game-of-life/simulation" iconEnd="arrow-right">
          Enter simulation
        </Button>
      </Stack>
    </Section>
  </Container>
</BaseLayout>
