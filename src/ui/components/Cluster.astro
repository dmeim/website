---
import type { HTMLAttributes } from "astro/types";
import type { SpaceStep } from "@/ui/lib/space";

interface Props extends HTMLAttributes<"div"> {
  gap?: SpaceStep;
  align?: "start" | "center" | "end" | "baseline" | "stretch";
  justify?: "start" | "center" | "end" | "between";
  wrap?: boolean;
}

const { gap, align, justify, wrap = true, class: className, ...rest } = Astro.props;
---

<div class:list={["ui-cluster", className]} data-gap={gap} data-align={align} data-justify={justify} data-wrap={wrap ? undefined : "false"} {...rest}><slot /></div>
