---
/**
 * CSS-only tooltip on hover and keyboard focus. The trigger in the slot
 * should reference `id` with `aria-describedby`.
 */
interface Props {
  text: string;
  id: string;
}

const { text, id } = Astro.props;
---

<span class="p-tip">
  <slot />
  <span class="p-tip__bubble" role="tooltip" id={id}>{text}</span>
</span>

<style>
  .p-tip {
    position: relative;
    display: inline-flex;
  }

  .p-tip__bubble {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    background: var(--p-ink);
    color: var(--p-on-ink);
    font-size: 0.75rem;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, 2px);
    transition:
      opacity var(--p-fast) var(--p-ease),
      transform var(--p-fast) var(--p-ease);
  }

  .p-tip:hover .p-tip__bubble,
  .p-tip:focus-within .p-tip__bubble {
    opacity: 1;
    transform: translate(-50%, 0);
  }
</style>
