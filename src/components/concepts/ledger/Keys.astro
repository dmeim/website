---
/**
 * Keys teaser: published fingerprints with copy buttons.
 */
import { keys } from "../../../content/site";
import SectionHead from "./SectionHead.astro";
import CopyButton from "./CopyButton.astro";
---

<section class="keys l-section" id="keys" aria-labelledby="keys-title">
  <div class="l-container">
    <SectionHead
      index="06"
      label="Keys"
      meta={`${keys.length} published`}
      title="Verify before you trust."
      titleId="keys-title"
    />

    <div class="keys__layout">
      <p class="keys__intro l-muted">
        Fingerprints for the keys that sign commits and authenticate sessions. Compare them out of band,
        then import the full blocks from the keys page.
      </p>

      <ul class="keys__list" data-reveal-group>
        {
          keys.map((key) => (
            <li class="key" data-reveal>
              <div class="key__head">
                <span class="key__kind l-mono">{key.kind}</span>
                <h3 class="key__title">{key.title}</h3>
              </div>
              <div class="key__fp">
                <code id={`fp-${key.id}`}>{key.fingerprint}</code>
                <CopyButton value={key.fingerprint} label={`Copy ${key.title} fingerprint`} />
              </div>
              <p class="key__usage l-mono l-muted">{key.usage}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <p class="keys__more">
      <a class="l-link" href="/keys">Full key blocks and import guide</a>
      <span class="l-gold" aria-hidden="true"> →</span>
    </p>
  </div>
</section>

<style>
  .keys__layout {
    display: grid;
    gap: var(--l-space-6);
  }

  .keys__intro {
    max-width: 38ch;
    font-size: var(--l-text-md);
  }

  .keys__list {
    border-top: 1px solid var(--l-line-strong);
  }

  .key {
    display: grid;
    gap: var(--l-space-3);
    padding: var(--l-space-5) 0;
    border-bottom: 1px solid var(--l-line);
  }

  .key__head {
    display: flex;
    align-items: baseline;
    gap: var(--l-space-3);
  }

  .key__kind {
    padding: 0.15rem 0.4rem;
    background: var(--l-ink);
    color: var(--l-ground);
  }

  .key__title {
    font-size: var(--l-text-lg);
    letter-spacing: -0.02em;
  }

  .key__fp {
    display: flex;
    align-items: center;
    gap: var(--l-space-3);
    padding: var(--l-space-3) var(--l-space-3) var(--l-space-3) var(--l-space-4);
    background: var(--l-surface);
  }

  .key__fp code {
    flex: 1;
    min-width: 0;
    font-family: var(--l-mono);
    font-size: var(--l-text-sm);
    letter-spacing: 0.01em;
    overflow-wrap: anywhere;
  }

  .keys__more {
    margin-top: var(--l-space-6);
    font-size: var(--l-text-sm);
    font-weight: 500;
  }

  @media (min-width: 900px) {
    .keys__layout {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--l-col-gap);
    }

    .keys__intro {
      grid-column: 1 / span 3;
    }

    .keys__list {
      grid-column: 4 / span 9;
    }

    .keys__more {
      margin-left: calc((100% + var(--l-col-gap)) / 12 * 3);
    }
  }
</style>
