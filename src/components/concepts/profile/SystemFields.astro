---
/** Form specimens: labelled inputs with hint and error, textarea, select. */
import { ChevronDown } from "@lucide/astro";
---

<div class="p-sys__group" data-reveal>
  <h3 class="p-sys__label">Fields</h3>
  <div class="p-sys__body p-sys__stack">
    <div class="p-field">
      <label for="p-f-name">Name</label>
      <input class="p-input" id="p-f-name" type="text" placeholder="Your name" aria-describedby="p-f-name-hint" />
      <p class="p-field__hint" id="p-f-name-hint">How you'd like to be addressed.</p>
    </div>
    <div class="p-field">
      <label for="p-f-email">Email</label>
      <input
        class="p-input"
        id="p-f-email"
        type="email"
        value="hello@"
        aria-invalid="true"
        aria-describedby="p-f-email-error"
      />
      <p class="p-field__error" id="p-f-email-error">Enter a full address, like name@example.com.</p>
    </div>
    <div class="p-field">
      <label for="p-f-msg">Message</label>
      <textarea class="p-input p-input--area" id="p-f-msg" rows="3" placeholder="A few lines is plenty"></textarea>
    </div>
    <div class="p-field">
      <label for="p-f-topic">Topic</label>
      <span class="p-select">
        <select class="p-input" id="p-f-topic">
          <option>Collaboration</option>
          <option>Keys and verification</option>
          <option>Something else</option>
        </select>
        <ChevronDown size={16} stroke-width={1.75} aria-hidden="true" />
      </span>
    </div>
  </div>
</div>

<style>
  .p-field {
    display: grid;
    gap: 0.375rem;
  }

  .p-field label {
    font-size: 0.875rem;
    font-weight: 500;
  }

  .p-field__hint,
  .p-field__error {
    font-size: 0.8125rem;
    color: var(--p-muted);
  }

  .p-field__error {
    color: var(--p-danger);
  }

  .p-input {
    width: 100%;
    height: 2.5rem;
    padding: 0 0.75rem;
    border: 1px solid var(--p-line-strong);
    border-radius: var(--p-radius);
    background: transparent;
    font-size: 0.9375rem;
    transition: border-color var(--p-fast) var(--p-ease);
  }

  .p-input::placeholder {
    color: var(--p-muted);
    opacity: 0.8;
  }

  .p-input:hover {
    border-color: color-mix(in srgb, var(--p-ink) 35%, transparent);
  }

  .p-input:focus-visible {
    outline-offset: 0;
    border-color: transparent;
  }

  .p-input[aria-invalid="true"] {
    border-color: var(--p-danger);
  }

  .p-input--area {
    height: auto;
    padding-block: 0.625rem;
    resize: vertical;
  }

  .p-select {
    position: relative;
    display: block;
  }

  .p-select select {
    appearance: none;
    padding-right: 2.25rem;
    background: var(--p-ground);
  }

  .p-select :global(svg) {
    position: absolute;
    top: 50%;
    right: 0.75rem;
    color: var(--p-muted);
    transform: translateY(-50%);
    pointer-events: none;
  }
</style>
