---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div class="pl-spec" data-reveal>
  <h3 class="pl-spec__label">{label}</h3>
  <div class="pl-spec__body">
    <slot />
  </div>
</div>

<style>
  .pl-spec {
    display: grid;
    gap: 16px;
  }

  .pl-spec__label {
    color: var(--pl-muted);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0;
  }

  .pl-spec__body {
    min-width: 0;
  }

  @media (min-width: 720px) {
    .pl-spec {
      grid-template-columns: 10rem 1fr;
      gap: 32px;
    }

    .pl-spec__label {
      padding-top: 10px;
    }
  }
</style>
