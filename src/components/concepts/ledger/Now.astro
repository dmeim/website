---
/**
 * Two-column editorial block: sticky mono label left, text right.
 */
import { currentChapter, shortBio } from "../../../content/site";

const facts = [
  { k: "Stack", v: "Astro 7 · TypeScript" },
  { k: "Delivery", v: "Cloudflare edge" },
  { k: "Focus", v: "Keys, tools, verification" },
];
---

<section class="now l-section" id="now" aria-labelledby="now-title">
  <div class="l-container l-grid">
    <div class="now__aside">
      <p class="now__label l-mono">
        <span><span class="l-gold">02</span> / Now</span>
        <span class="now__eyebrow l-muted">{currentChapter.eyebrow}</span>
      </p>
    </div>

    <div class="now__main" data-reveal-group>
      <h2 class="now__title" id="now-title" data-reveal>{currentChapter.title}</h2>
      <p class="now__lede" data-reveal>{currentChapter.body}</p>
      <p class="now__bio l-muted" data-reveal>{shortBio}</p>
      <dl class="now__facts" data-reveal>
        {
          facts.map((f) => (
            <div>
              <dt class="l-mono l-muted">{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .now__aside {
    grid-column: 1 / -1;
    margin-bottom: var(--l-space-6);
  }

  .now__label {
    position: sticky;
    top: calc(var(--l-header-h) + 1.5rem);
    display: flex;
    flex-direction: column;
    gap: var(--l-space-1);
    padding-top: var(--l-space-4);
    border-top: 1px solid var(--l-line-strong);
  }

  .now__main {
    grid-column: 1 / -1;
  }

  .now__title {
    font-size: var(--l-text-2xl);
    letter-spacing: var(--l-track-display);
    line-height: 0.98;
    max-width: 14ch;
  }

  .now__lede {
    margin-top: clamp(2rem, 1rem + 3vw, 3.5rem);
    max-width: 34ch;
    font-size: var(--l-text-xl);
    letter-spacing: -0.02em;
    line-height: 1.22;
  }

  .now__bio {
    margin-top: var(--l-space-5);
    max-width: 58ch;
    font-size: var(--l-text-md);
  }

  .now__facts {
    display: grid;
    grid-template-columns: 1fr;
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    border-top: 1px solid var(--l-line);
  }

  .now__facts > div {
    display: flex;
    justify-content: space-between;
    gap: var(--l-space-4);
    padding: var(--l-space-4) 0;
    border-bottom: 1px solid var(--l-line);
  }

  .now__facts dd {
    margin: 0;
    font-size: var(--l-text-sm);
  }

  @media (min-width: 900px) {
    .now__aside {
      grid-column: 1 / span 3;
      margin-bottom: 0;
    }

    .now__label {
      height: auto;
    }

    .now__main {
      grid-column: 4 / span 9;
      padding-top: var(--l-space-4);
      border-top: 1px solid var(--l-line-strong);
    }

    .now__facts {
      grid-template-columns: repeat(3, 1fr);
      border-bottom: 1px solid var(--l-line);
    }

    .now__facts > div {
      flex-direction: column;
      gap: var(--l-space-2);
      padding: var(--l-space-4) var(--l-space-4) var(--l-space-5) 0;
      border-bottom: 0;
    }

    .now__facts > div + div {
      padding-left: var(--l-space-4);
      border-left: 1px solid var(--l-line);
    }
  }
</style>
