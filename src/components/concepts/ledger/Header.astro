---
/**
 * Thin top bar: wordmark, primary nav, availability, theme control.
 * Gains a hairline once scrolled; hides on scroll down, returns on scroll up.
 */
import ThemeSwitch from "./ThemeSwitch.astro";

const nav = [
  { label: "Work", href: "/projects" },
  { label: "Tools", href: "/tools" },
  { label: "Keys", href: "/keys" },
  { label: "Connect", href: "/connect" },
];
---

<header class="bar" data-ledger-header>
  <div class="bar__inner l-container">
    <a class="bar__mark" href="#top" aria-label="dmeim — back to top">dmeim</a>
    <nav class="bar__nav" aria-label="Primary">
      <ul>
        {
          nav.map((item, i) => (
            <li>
              <a class="bar__link" href={item.href}>
                <span class="bar__idx l-num" aria-hidden="true">0{i + 1}</span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="bar__status l-mono">
      <span class="bar__dot" aria-hidden="true"></span>
      Available for select work
    </p>
    <ThemeSwitch />
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-ledger-header]");

  if (header) {
    let lastY = window.scrollY;
    let ticking = false;

    const update = () => {
      const y = window.scrollY;
      header.toggleAttribute("data-scrolled", y > 8);
      // Small dead zone so trackpad jitter doesn't flicker the bar.
      if (Math.abs(y - lastY) > 6) {
        const hidden = y > lastY && y > 240 && !header.contains(document.activeElement);
        header.toggleAttribute("data-hidden", hidden);
        lastY = y;
      }
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true },
    );
    header.addEventListener("focusin", () => header.removeAttribute("data-hidden"));
    update();
  }
</script>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--l-ground);
    border-bottom: 1px solid transparent;
    transition:
      transform var(--l-dur) var(--l-ease),
      border-color var(--l-dur) var(--l-ease),
      background-color var(--l-dur) var(--l-ease);
  }

  .bar[data-scrolled] {
    border-bottom-color: var(--l-line);
  }

  .bar[data-hidden] {
    transform: translateY(-100%);
  }

  .bar__inner {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: var(--l-header-h) auto;
    grid-template-areas:
      "mark theme"
      "nav nav";
    align-items: center;
    column-gap: var(--l-space-5);
    min-height: var(--l-header-h);
  }

  .bar__mark {
    grid-area: mark;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.05em;
  }

  .bar__nav {
    grid-area: nav;
    border-top: 1px solid var(--l-line);
  }

  .bar__nav ul {
    display: flex;
    justify-content: space-between;
  }

  .bar__link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.7rem 0;
    font-size: var(--l-text-sm);
    transition: color var(--l-dur-fast) var(--l-ease);
  }

  .bar__link:hover {
    color: var(--l-gold-ink);
  }

  .bar__idx {
    font-family: var(--l-mono);
    font-size: var(--l-text-2xs);
    color: var(--l-ink-muted);
  }

  .bar__status {
    display: none;
  }

  .bar :global(.theme) {
    grid-area: theme;
    justify-self: end;
  }

  @media (min-width: 900px) {
    .bar__inner {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: none;
      grid-template-areas: none;
      column-gap: var(--l-col-gap);
    }

    .bar__mark {
      grid-area: auto;
      grid-column: 1 / span 2;
    }

    .bar__nav {
      grid-area: auto;
      grid-column: 3 / span 5;
      border-top: 0;
    }

    .bar__nav ul {
      justify-content: flex-start;
      gap: clamp(1.25rem, 2vw, 2.25rem);
    }

    .bar__status {
      grid-column: 8 / span 3;
      align-items: center;
      gap: 0.6rem;
      color: var(--l-ink-muted);
    }

    .bar :global(.theme) {
      grid-area: auto;
      grid-column: 11 / span 2;
    }
  }

  @media (min-width: 1100px) {
    .bar__status {
      display: inline-flex;
    }
  }

  .bar__dot {
    position: relative;
    width: 7px;
    height: 7px;
    background: var(--l-gold);
    border-radius: 50%;
  }

  .bar__dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--l-gold);
    animation: ledger-pulse 2.4s var(--l-ease) infinite;
  }

  @keyframes ledger-pulse {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    70%,
    100% {
      transform: scale(3.2);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bar__dot::after {
      animation: none;
      opacity: 0;
    }

    .bar[data-hidden] {
      transform: none;
    }
  }
</style>
