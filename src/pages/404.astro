---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Button, Container, PageHeader, Section, Stat } from "@/ui/components";
---

<BaseLayout title="Page not found" description="This page could not be found.">
  <Container>
    <Section>
      <Stat size="xl" label="Error" value="404" mono />
    </Section>
    <PageHeader
      title="Page not found"
      lede="The page you are looking for does not exist or has moved."
    >
      <Button slot="actions" variant="primary" href="/" iconStart="house">Return home</Button>
    </PageHeader>
  </Container>
</BaseLayout>
