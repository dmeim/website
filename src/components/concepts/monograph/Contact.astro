---
import { connect } from "../../../content/site";
import MagneticButton from "./MagneticButton.astro";
---

<section class="mg-contact mg-invert" id="contact" data-band="invert" aria-labelledby="mg-contact-title">
  <div class="mg-container">
    <p class="mg-label" data-reveal><span class="mg-label__num">07</span>Contact</p>

    <div class="mg-contact__stage">
      <h2 class="mg-contact__title" id="mg-contact-title" data-reveal>
        Let’s <em>talk.</em>
      </h2>
      <div class="mg-contact__cta" data-reveal>
        <MagneticButton
          href={`mailto:${connect.email}`}
          label="Write"
          ring={`${connect.email} · ${connect.email} · `}
        />
      </div>
    </div>

    <div class="mg-contact__foot" data-reveal-group>
      <p class="mg-lede" data-reveal>{connect.intro}</p>
      <dl class="mg-contact__links" data-reveal>
        <div>
          <dt class="mg-label">Email</dt>
          <dd><a class="mg-link" href={`mailto:${connect.email}`}>{connect.email}</a></dd>
        </div>
        <div>
          <dt class="mg-label">{connect.socialLabel}</dt>
          <dd>
            <a class="mg-link" href={connect.socialUrl} rel="me noopener" target="_blank">{connect.socialHandle}</a>
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .mg-contact {
    padding-block: clamp(96px, 12vw, 180px) clamp(64px, 8vw, 120px);
  }

  .mg-contact__stage {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 48px;
    margin-block: clamp(24px, 4vw, 48px) clamp(48px, 7vw, 96px);
  }

  .mg-contact__title {
    font-family: var(--mg-font-display);
    font-weight: 400;
    font-size: clamp(4.5rem, 0.5rem + 18vw, 19rem);
    line-height: 0.85;
    letter-spacing: -0.035em;
    white-space: nowrap;
  }

  .mg-contact__title em {
    color: var(--mg-gold);
  }

  .mg-contact__foot {
    display: grid;
    gap: 40px;
    padding-top: 40px;
    border-top: 1px solid var(--mg-line);
  }

  .mg-contact__links {
    display: grid;
    gap: 28px;
  }

  .mg-contact__links div {
    display: grid;
    gap: 8px;
  }

  .mg-contact__links dd {
    font-family: var(--mg-font-display);
    font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.75rem);
    line-height: 1.1;
  }

  .mg-contact__links .mg-link {
    background-size:
      0% 1px,
      0% 1px;
  }

  .mg-contact__links .mg-link:hover,
  .mg-contact__links .mg-link:focus-visible {
    background-size:
      100% 1px,
      0% 1px;
  }

  @media (min-width: 900px) {
    .mg-contact__foot {
      grid-template-columns: 1fr auto;
      align-items: end;
    }

    .mg-contact__links {
      grid-template-columns: auto auto;
      gap: 64px;
    }
  }

  @media (max-width: 560px) {
    .mg-contact__title {
      font-size: 27vw;
    }

    .mg-contact__cta {
      margin-inline: auto;
    }
  }
</style>
