---
import { mentorQuote } from "../../../content/site";
---

<figure class="lt-quote" data-reveal>
  <blockquote>
    <p>{mentorQuote.text}</p>
  </blockquote>
  {mentorQuote.attribution && <figcaption class="lt-label">{mentorQuote.attribution}</figcaption>}
</figure>

<style>
  .lt-quote {
    margin-top: clamp(3.5rem, 7vw, 4.75rem);
    padding-left: 1.25rem;
    border-left: 1px solid var(--lt-gold);
  }

  .lt-quote blockquote {
    font-size: 1.3125rem;
    font-style: italic;
    font-weight: 350;
    line-height: 1.5;
    font-variation-settings: "opsz" 36;
  }

  .lt-quote figcaption {
    margin-top: 0.75rem;
  }
</style>
