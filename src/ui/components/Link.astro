---
import type { HTMLAttributes } from "astro/types";
import Icon from "@/ui/icons/Icon.astro";

interface Props extends Omit<HTMLAttributes<"a">, "href"> {
  href: string;
  external?: boolean;
  arrow?: "none" | "right" | "up-right";
  tone?: "default" | "quiet" | "accent";
}

const { href, external = false, arrow = "none", tone = "default", class: className, ...rest } = Astro.props;
const arrowName = arrow === "right" ? "arrow-right" : arrow === "up-right" || external ? "arrow-up-right" : null;
const externalAttrs = external ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

<a
  class:list={["ui-link", className]}
  href={href}
  data-tone={tone}
  data-arrow={arrowName ? (arrow === "right" ? "right" : "up-right") : undefined}
  {...externalAttrs}
  {...rest}
><slot />{arrowName && <Icon name={arrowName} class="ui-link__arrow" />}{external && <span class="ui-visually-hidden"> (opens in new tab)</span>}</a>
