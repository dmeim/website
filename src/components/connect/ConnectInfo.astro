---
/** Connect details — sourced from `src/content/site.ts`. */
import List from "@/ui/components/List.astro";
import ListRow from "@/ui/components/ListRow.astro";
import { connect } from "@/content/site";
---

<List label="Contact details">
  <ListRow label="Email" icon="envelope-simple" title={connect.email} href={`mailto:${connect.email}`} />
  <ListRow
    label="Location"
    icon="map-pin"
    title={connect.location}
    description={connect.locationDetail}
  />
  <ListRow
    label={connect.socialLabel}
    icon="code"
    title={connect.socialHandle}
    href={connect.socialUrl}
  />
</List>
