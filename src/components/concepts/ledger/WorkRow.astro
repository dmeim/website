---
/**
 * One work index row: a real link with a left-to-right surface fill and an
 * arrow that turns to north-east. Its <template> feeds WorkPreview.
 */
import { ArrowRight } from "@lucide/astro";
import Tag from "./Tag.astro";
import { pad, statusLabel, type WorkRowData } from "./work-rows";

interface Props {
  row: WorkRowData;
  index: number;
}

const { row, index } = Astro.props;
const n = pad(index + 1);
---

<a
  class="row"
  href={row.href}
  data-preview={index}
  target={row.external ? "_blank" : undefined}
  rel={row.external ? "noopener noreferrer" : undefined}
>
  <span class="row__n l-mono l-num">{n}</span>
  <span class="row__title">{row.title}</span>
  <span class="row__org">{row.org}</span>
  <span class="row__dates l-mono">{row.dates}</span>
  <span class="row__tags l-mono">{row.tags.join(" · ")}</span>
  <span class="row__arrow" aria-hidden="true">
    <ArrowRight size={20} stroke-width={1.5} />
  </span>
  {row.external && <span class="l-sr-only">(opens in a new tab)</span>}
</a>
<template data-preview-tpl={index}>
  <p class="pv__kicker l-mono"><span class="l-gold">{n}</span> / {row.org}</p>
  <p class="pv__title">{row.title}</p>
  {row.summary && <p class="pv__text">{row.summary}</p>}
  {
    row.bullets && (
      <ul class="pv__list">
        {row.bullets.map((b) => (
          <li>{b}</li>
        ))}
      </ul>
    )
  }
  {row.status && <Tag tone={row.status}>{statusLabel[row.status]}</Tag>}
</template>

<style>
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    grid-template-areas:
      "n title arrow"
      "n org arrow"
      "n meta meta";
    column-gap: var(--l-space-3);
    row-gap: var(--l-space-1);
    padding: var(--l-space-5) 0;
    isolation: isolate;
  }

  .row::before {
    content: "";
    position: absolute;
    inset: 0 calc(var(--l-gutter) * -0.5);
    z-index: -1;
    background: var(--l-surface);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--l-dur-slow) var(--l-ease);
  }

  .row:hover::before,
  .row:focus-visible::before {
    transform: scaleX(1);
  }

  .row:focus-visible {
    outline-offset: 0;
  }

  .row__n {
    grid-area: n;
    padding-top: 0.45em;
    color: var(--l-gold-ink);
  }

  .row__title {
    grid-area: title;
    font-size: var(--l-text-xl);
    letter-spacing: -0.03em;
    line-height: 1.1;
    transition: transform var(--l-dur) var(--l-ease);
  }

  .row__org {
    grid-area: org;
    color: var(--l-ink-muted);
    font-size: var(--l-text-sm);
  }

  .row__dates,
  .row__tags {
    color: var(--l-ink-muted);
  }

  .row__dates {
    grid-area: meta;
    margin-top: var(--l-space-2);
  }

  .row__tags {
    display: none;
  }

  .row__arrow {
    grid-area: arrow;
    align-self: start;
    padding-top: 0.3em;
    transition: transform var(--l-dur) var(--l-ease), color var(--l-dur-fast) var(--l-ease);
  }

  .row:hover .row__arrow,
  .row:focus-visible .row__arrow {
    transform: rotate(-45deg);
    color: var(--l-gold-ink);
  }

  @media (min-width: 900px) {
    .row {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-areas: none;
      column-gap: var(--l-col-gap);
      align-items: baseline;
    }

    .row__n {
      grid-area: 1 / 1 / auto / span 1;
    }

    .row__title {
      grid-area: 1 / 2 / auto / span 4;
    }

    .row__org {
      grid-area: 1 / 6 / auto / span 2;
    }

    .row__dates {
      grid-area: 1 / 8 / auto / span 2;
    }

    .row__tags {
      grid-area: 1 / 10 / auto / span 2;
    }

    .row {
      padding: var(--l-space-6) 0;
    }

    .row__n,
    .row__dates {
      padding-top: 0;
      margin-top: 0;
    }

    .row__tags {
      display: block;
    }

    .row__arrow {
      grid-area: 1 / 12;
      justify-self: end;
      align-self: center;
      padding-top: 0;
    }

    .row:hover .row__title {
      transform: translateX(var(--l-space-3));
    }
  }
</style>
