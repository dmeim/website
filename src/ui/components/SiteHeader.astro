---
import type { HTMLAttributes } from "astro/types";
import { cx } from "@/ui/lib/cx";
import { defaultNavItems, shellMode, type NavItem } from "@/ui/lib/site-nav";
import Drawer from "./Drawer.astro";
import IconButton from "./IconButton.astro";
import SiteNav from "./SiteNav.astro";
import ThemeControl from "./ThemeControl.astro";

/**
 * Site chrome: a sticky theme + nav rail at >=960px and a top bar with the
 * menu below that; the identity lives in SiteIdentity at the top of main.
 * `immersive` renders nothing. `menuId` exists only so the /ui
 * showcase can render several headers; the site keeps `mobile-nav`.
 */
interface Props extends Omit<HTMLAttributes<"header">, "class"> {
  currentPath: string;
  items?: NavItem[];
  immersive?: boolean;
  menuId?: string;
  class?: string;
}

const {
  currentPath,
  items = defaultNavItems,
  immersive = false,
  menuId = "mobile-nav",
  class: className,
  ...rest
} = Astro.props;
const mode = shellMode(immersive);
const toggleId = menuId === "mobile-nav" ? "nav-toggle" : `${menuId}-toggle`;
---

{
  mode !== "immersive" && (
    <header {...rest} class={cx("ui-site-header", className)} data-shell={mode} data-ui-site-header>
      <div class="ui-site-header__rail">
        <ThemeControl size="sm" class="ui-site-header__rail-theme" />
        <SiteNav items={items} currentPath={currentPath} orientation="vertical" class="ui-site-header__nav" data-ui-site-spy />
      </div>

      <div class="ui-site-header__bar">
        <IconButton
          icon="list"
          label="Open menu"
          tooltip={false}
          class="ui-site-header__toggle"
          id={toggleId}
          aria-controls={menuId}
          aria-expanded="false"
          data-ui-drawer-toggle={menuId}
        />
        <div class="ui-site-header__actions">
          <ThemeControl size="sm" class="ui-site-header__bar-theme" />
        </div>
      </div>

      <Drawer id={menuId} side="start" title="Menu" class="ui-site-header__drawer" data-open="false" data-ui-site-menu>
        <SiteNav items={items} currentPath={currentPath} orientation="vertical" aria-label="Mobile" data-ui-site-spy />
      </Drawer>
    </header>
  )
}

<script>
  import { closeDrawer } from "@/ui/lib/overlay";

  const wideQuery = window.matchMedia("(min-width: 960px)");

  /** The menu has no trigger at >=960px, so close it when the viewport widens. */
  function closeSiteMenusWhenWide(): void {
    if (!wideQuery.matches) return;
    document.querySelectorAll<HTMLElement>("[data-ui-site-menu][data-state='open']").forEach((drawer) => {
      closeDrawer(drawer, false);
    });
  }

  /** Mirror the Drawer state onto the legacy `data-open` / `.is-open` hooks. */
  function bindSiteMenus(): void {
    document.querySelectorAll<HTMLElement>("[data-ui-site-menu]").forEach((drawer) => {
      if (drawer.dataset.menuBound === "1") return;
      drawer.dataset.menuBound = "1";
      const sync = () => {
        const open = drawer.dataset.state === "open";
        drawer.dataset.open = String(open);
        drawer.classList.toggle("is-open", open);
        document.querySelectorAll<HTMLElement>(`[data-ui-drawer-toggle="${drawer.id}"]`).forEach((toggle) => {
          toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
        });
      };
      new MutationObserver(sync).observe(drawer, { attributes: true, attributeFilter: ["data-state"] });
      sync();
    });
  }

  wideQuery.addEventListener("change", closeSiteMenusWhenWide);
  bindSiteMenus();
  document.addEventListener("astro:page-load", bindSiteMenus);
</script>
