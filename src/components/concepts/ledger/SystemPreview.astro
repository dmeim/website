---
/**
 * "System — component preview": the Ledger vocabulary on one sheet, so the
 * concept can be judged as a component library, not just a page.
 */
import { Search } from "@lucide/astro";
import SectionHead from "./SectionHead.astro";
import Button from "./Button.astro";
import Tag from "./Tag.astro";
import Field from "./Field.astro";
import Choices from "./Choices.astro";
import Tabs from "./Tabs.astro";
import Card from "./Card.astro";
import Tooltip from "./Tooltip.astro";

const swatches = [
  { name: "Ground", v: "--l-ground" },
  { name: "Surface", v: "--l-surface" },
  { name: "Ink", v: "--l-ink" },
  { name: "Ink muted", v: "--l-ink-muted" },
  { name: "Gold", v: "--l-gold" },
  { name: "Line", v: "--l-line-strong" },
];

const tabs = [
  { label: "Overview", body: "Tabs share the hairline baseline; the gold indicator slides to the active tab." },
  { label: "Usage", body: "Arrow keys move between tabs, Home and End jump to the ends. Panels are focusable." },
  { label: "Tokens", body: "Indicator: 2px gold · 300ms · cubic-bezier(0.22, 1, 0.36, 1)." },
];
---

<section class="sys l-section" id="system" aria-labelledby="system-title">
  <div class="l-container">
    <SectionHead
      index="08"
      label="System — component preview"
      meta="Ledger v0.1"
      title="The parts this page is made of."
      titleId="system-title"
    />

    <div class="sys__grid">
      <div class="spec spec--8">
        <p class="spec__label l-mono"><span class="l-gold">A.01</span> Buttons</p>
        <div class="spec__row">
          <Button arrow>Primary</Button>
          <Button variant="secondary">Secondary</Button>
          <Button variant="ghost">Ghost</Button>
          <Tooltip id="sys-tip-search" text="Search the toolbox">
            <Button variant="icon" label="Search" attrs={{ "aria-describedby": "sys-tip-search" }}>
              <Search size={18} stroke-width={1.75} aria-hidden="true" />
            </Button>
          </Tooltip>
          <Button disabled>Disabled</Button>
        </div>
        <div class="spec__row">
          <Button size="sm" arrow>Small</Button>
          <Button size="sm" variant="secondary">Small secondary</Button>
        </div>
      </div>

      <div class="spec spec--4">
        <p class="spec__label l-mono"><span class="l-gold">A.02</span> Status &amp; tags</p>
        <div class="spec__row spec__row--tight">
          <Tag tone="live">Live</Tag>
          <Tag tone="wip">In progress</Tag>
          <Tag tone="archived">Archived</Tag>
        </div>
        <div class="spec__row spec__row--tight">
          <Tag>Astro</Tag>
          <Tag>Cloudflare</Tag>
          <Tag>OpenPGP</Tag>
        </div>
      </div>

      <div class="spec spec--6">
        <p class="spec__label l-mono"><span class="l-gold">A.03</span> Text fields</p>
        <div class="spec__stack">
          <Field id="sys-name" label="Name" placeholder="Your name" hint="How you'd like to be addressed." />
          <Field id="sys-email" label="Email" type="email" value="hello@dmeim" error="Add a domain, e.g. hello@dmeim.com." />
          <Field id="sys-msg" label="Message" multiline optional placeholder="What's this about?" />
        </div>
      </div>

      <div class="spec spec--6">
        <p class="spec__label l-mono"><span class="l-gold">A.04</span> Choices</p>
        <Choices />
      </div>

      <div class="spec spec--6">
        <p class="spec__label l-mono"><span class="l-gold">A.05</span> Tabs</p>
        <Tabs id="sys-tabs" label="Component documentation" tabs={tabs} />
      </div>

      <div class="spec spec--6">
        <p class="spec__label l-mono"><span class="l-gold">A.06</span> Card &amp; inline link</p>
        <Card href="/projects" kicker="Project / 2026" title="Verification lab">
          In-browser PGP and SSH signature checks — nothing leaves the device.
          <Tag slot="meta" tone="wip">In progress</Tag>
        </Card>
        <p class="spec__prose l-muted">
          Inline links sit on a hairline and draw an ink underline on hover, like{" "}
          <a class="l-link" href="/keys">this one to the keys page</a>.
        </p>
      </div>

      <div class="spec spec--12">
        <p class="spec__label l-mono"><span class="l-gold">A.07</span> Tokens</p>
        <ul class="spec__swatches">
          {
            swatches.map((s) => (
              <li>
                <span class="spec__chip" style={`background: var(${s.v})`} />
                <span class="l-mono">{s.name}</span>
                <code class="spec__var l-muted">{s.v}</code>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .sys__grid {
    display: grid;
    border-top: 1px solid var(--l-line-strong);
    border-left: 1px solid var(--l-line);
  }

  .spec {
    display: grid;
    align-content: start;
    gap: var(--l-space-5);
    min-width: 0;
    padding: var(--l-space-5) var(--l-space-4) var(--l-space-6);
    border-right: 1px solid var(--l-line);
    border-bottom: 1px solid var(--l-line);
  }

  .spec__label {
    color: var(--l-ink-muted);
  }

  .spec__label .l-gold {
    margin-right: 0.5rem;
  }

  .spec__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--l-space-3);
  }

  .spec__row--tight {
    gap: var(--l-space-2);
  }

  .spec__stack {
    display: grid;
    gap: var(--l-space-5);
  }

  .spec__prose {
    font-size: var(--l-text-sm);
  }

  .spec__prose a {
    color: var(--l-ink);
  }

  .spec__swatches {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--l-space-4) var(--l-col-gap);
  }

  .spec__swatches li {
    display: grid;
    gap: var(--l-space-1);
  }

  .spec__var {
    font-family: var(--l-mono);
    font-size: var(--l-text-2xs);
  }

  .spec__chip {
    display: block;
    height: 4rem;
    margin-bottom: var(--l-space-2);
    border: 1px solid var(--l-line);
  }

  @media (min-width: 900px) {
    .sys__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .spec {
      padding: var(--l-space-5) var(--l-space-5) var(--l-space-7);
    }

    .spec--4 {
      grid-column: span 4;
    }

    .spec--6 {
      grid-column: span 6;
    }

    .spec--8 {
      grid-column: span 8;
    }

    .spec--12 {
      grid-column: span 12;
    }

    .spec__swatches {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
</style>
