---
/**
 * The one list row used across the page: muted label column, title and a
 * single line of description, optional badge, arrow or trailing control.
 * Renders its own <li>, so wrap rows in a `.p-list` <ul>/<ol>.
 */
import { ArrowRight, ArrowUpRight } from "@lucide/astro";
import Badge, { type BadgeStatus } from "./Badge.astro";

interface Props {
  label?: string;
  title: string;
  desc?: string;
  href?: string;
  status?: BadgeStatus;
  /** Render the description in the monospace face (fingerprints). */
  mono?: boolean;
}

const { label, title, desc, href, status, mono = false } = Astro.props;
const external = href?.startsWith("http") ?? false;
const hasTrail = Astro.slots.has("trail");
const Tag = href ? "a" : "div";
const linkAttrs = href
  ? { href, ...(external ? { target: "_blank", rel: "noopener noreferrer" } : {}) }
  : {};
---

<li class:list={["p-row", { "p-row--link": href }]} data-reveal>
  <Tag class="p-row__body" {...linkAttrs}>
    <span class="p-row__label p-num">{label}</span>
    <span class="p-row__main">
      <span class="p-row__title">
        {title}
        {external && <span class="p-sr-only">(opens in a new tab)</span>}
      </span>
      {desc && <span class:list={["p-row__desc", { "p-row__desc--mono": mono }]}>{desc}</span>}
    </span>
    {
      (status || href || hasTrail) && (
        <span class="p-row__trail">
          {status && <Badge status={status} />}
          {hasTrail && <slot name="trail" />}
          {href && (
            <span class="p-row__arrow" aria-hidden="true">
              {external ? <ArrowUpRight size={16} stroke-width={1.75} /> : <ArrowRight size={16} stroke-width={1.75} />}
            </span>
          )}
          {/* Keeps badges aligned with linked siblings. */}
          {status && !href && <span class="p-row__arrow p-row__arrow--empty" aria-hidden="true" />}
        </span>
      )
    }
  </Tag>
</li>

<style>
  .p-row {
    border-top: 1px solid var(--p-line);
    transition: border-color var(--p-fast) var(--p-ease);
  }

  .p-row:last-child {
    border-bottom: 1px solid var(--p-line);
  }

  .p-row__body {
    display: grid;
    grid-template-columns: var(--p-label-col) minmax(0, 1fr) auto;
    align-items: baseline;
    column-gap: 1rem;
    margin-inline: -0.75rem;
    padding: 0.875rem 0.75rem;
    border-radius: var(--p-radius);
    color: inherit;
    text-decoration: none;
    transition: background-color var(--p-fast) var(--p-ease);
  }

  .p-row__label {
    font-size: 0.8125rem;
    color: var(--p-muted);
  }

  .p-row__main {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
  }

  .p-row__title {
    font-weight: 500;
    color: var(--p-ink);
  }

  .p-row__desc {
    font-size: 0.875rem;
    color: var(--p-muted);
  }

  .p-row__desc--mono {
    font-family: var(--p-mono);
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
  }

  .p-row__trail {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    align-self: center;
  }

  .p-row__arrow {
    display: inline-flex;
    min-width: 16px;
    color: var(--p-muted);
    transition:
      transform var(--p-fast) var(--p-ease),
      color var(--p-fast) var(--p-ease);
  }

  /* Hover: flat surface fill; hide the hairlines that would cut through it. */
  .p-row--link:hover,
  .p-row--link:hover + .p-row {
    border-top-color: transparent;
  }

  .p-row--link:hover:last-child {
    border-bottom-color: transparent;
  }

  .p-row--link .p-row__body:hover,
  .p-row--link .p-row__body:focus-visible {
    background: var(--p-surface);
  }

  .p-row--link .p-row__body:hover .p-row__arrow,
  .p-row--link .p-row__body:focus-visible .p-row__arrow {
    color: var(--p-gold);
    transform: translateX(2px);
  }

  .p-row__body:focus-visible {
    outline-offset: 0;
    border-radius: var(--p-radius);
  }

  @media (max-width: 479px) {
    .p-row__body {
      grid-template-columns: minmax(0, 1fr) auto;
      row-gap: 0.125rem;
    }

    .p-row__label {
      grid-column: 1 / -1;
    }

    .p-row__label:empty {
      display: none;
    }
  }
</style>
