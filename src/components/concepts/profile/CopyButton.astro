---
/** Icon button that copies `value`; the icon swaps to a check briefly. */
import { Copy, Check } from "@lucide/astro";

interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<span class="p-copy">
  <button type="button" class="p-icon-btn p-copy__btn" data-p-copy={value} aria-label={label} title="Copy">
    <span class="p-copy__icon p-copy__icon--copy" aria-hidden="true"><Copy size={15} stroke-width={1.75} /></span>
    <span class="p-copy__icon p-copy__icon--check" aria-hidden="true"><Check size={15} stroke-width={2} /></span>
  </button>
  <span class="p-sr-only" role="status" aria-live="polite"></span>
</span>

<script>
  const RESET_MS = 1600;

  // Clipboard API is unavailable on insecure origins and some embedded views.
  const legacyCopy = (text: string): boolean => {
    const area = document.createElement("textarea");
    area.value = text;
    area.setAttribute("readonly", "");
    area.style.position = "fixed";
    area.style.opacity = "0";
    document.body.append(area);
    area.select();
    const ok = document.execCommand("copy");
    area.remove();
    return ok;
  };

  const copy = async (text: string): Promise<boolean> => {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      return legacyCopy(text);
    }
  };

  document.querySelectorAll<HTMLButtonElement>("[data-p-copy]").forEach((btn) => {
    let timer = 0;
    const status = btn.nextElementSibling;

    btn.addEventListener("click", async () => {
      const ok = await copy(btn.dataset.pCopy ?? "");
      if (!ok) console.error("profile: clipboard write failed");
      btn.toggleAttribute("data-copied", ok);
      if (status) status.textContent = ok ? "Copied" : "Copy failed. Select the text instead.";
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        btn.removeAttribute("data-copied");
        if (status) status.textContent = "";
      }, RESET_MS);
    });
  });
</script>

<style>
  .p-copy {
    display: inline-flex;
  }

  .p-copy__btn {
    display: grid;
    place-items: center;
  }

  .p-copy__icon {
    grid-area: 1 / 1;
    display: grid;
    transition: opacity var(--p-fast) var(--p-ease);
  }

  .p-copy__icon--check,
  .p-copy__btn[data-copied] .p-copy__icon--copy {
    opacity: 0;
  }

  .p-copy__btn[data-copied] .p-copy__icon--check {
    opacity: 1;
    color: var(--p-gold);
  }
</style>
