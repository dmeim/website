---
import ThemePair from "./ThemePair.astro";
import { Badge, Card, Figure, Quote, StatusDot, Swatch } from "@/ui/components/groups/display";
import {
  Disclosure,
  KeyValue,
  List,
  ListRow,
  Panel,
  StatGrid,
  Table,
} from "@/ui/components/groups/display";
import Button from "@/ui/components/Button.astro";
import IconButton from "@/ui/components/IconButton.astro";
import { DisplayShowcase } from "@/ui/react/showcase/DisplayShowcase";

const tones = ["neutral", "accent", "success", "warning", "danger", "info"] as const;
const variants = ["soft", "outline", "solid"] as const;
const statuses = ["live", "wip", "archived", "idle", "busy", "success", "error"] as const;
const figureSrc = "/gpt-photoshoot/gpt-jackethold-transparent.png";
---

<section id="display" class="ui-showcase-section" aria-labelledby="display-title">
  <h2 id="display-title" class="ui-showcase-section__title">Display</h2>
  <h3 class="ui-showcase-sub">Astro</h3>
  <ThemePair>
    <div style="display: grid; gap: var(--ui-space-sm)">
      <h4 class="ui-showcase-sub">Badge</h4>
      {
        variants.map((variant) => (
          <div style="display: flex; flex-wrap: wrap; align-items: center; gap: var(--ui-space-sm)">
            {tones.map((tone) => <Badge tone={tone} variant={variant}>{tone}</Badge>)}
          </div>
        ))
      }
      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: var(--ui-space-sm)">
        <Badge size="sm">sm</Badge>
        <Badge icon="lock">With icon</Badge>
        <Badge tone="accent" variant="solid" icon="check">Solid icon</Badge>
      </div>
      <h4 class="ui-showcase-sub">StatusDot</h4>
      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: var(--ui-space-sm)">
        {statuses.map((status) => <StatusDot status={status} label={status} />)}
      </div>
      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: var(--ui-space-sm)">
        <StatusDot status="live" label="Hidden label" labelHidden />
        <StatusDot status="live" pulse={false} label="No pulse" />
        <StatusDot status="idle" pulse label="Forced pulse" />
      </div>
      <h4 class="ui-showcase-sub">Card</h4>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr)); gap: var(--ui-space-sm)">
        <Card>
          <span slot="eyebrow">Default</span>
          <span slot="title">Static card</span>
          Body text in a flat surface tile.
          <span slot="footer">Footer</span>
        </Card>
        <Card href="#display">
          <span slot="eyebrow">Linked</span>
          <span slot="title">Whole card link</span>
          Hover or focus the card.
        </Card>
        <Card tone="inset" padding="sm">
          <span slot="title">Inset, padding sm</span>
          Inset tone with hairline.
        </Card>
        <Card tone="inset" padding="lg" interactive>
          <span slot="title">Inset, lg, interactive</span>
          Hover fill without a link.
        </Card>
        <Card padding="none" as="article">
          <img slot="media" src={figureSrc} alt="" width="320" height="180" style="aspect-ratio: 16/9; object-fit: cover" />
          <span slot="title">Padding none + media</span>
        </Card>
      </div>
      <h4 class="ui-showcase-sub">Quote</h4>
      <Quote source="A mentor" cite="https://example.com">Make it quiet, then make it right.</Quote>
      <h4 class="ui-showcase-sub">Figure</h4>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr)); gap: var(--ui-space-sm)">
        <Figure src={figureSrc} alt="Portrait" caption="Plain figure" ratio="4 / 3" />
        <Figure src={figureSrc} alt="Portrait" caption="Framed figure" ratio="1" frame />
      </div>
      <h4 class="ui-showcase-sub">Swatch</h4>
      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: var(--ui-space-sm)">
        <Swatch color="#8a6d3b" label="Gold" code="--ui-accent" value="#8A6D3B" size="sm" />
        <Swatch color="#3d6b48" label="Green" value="#3D6B48" />
        <Swatch color="#a3442c" label="Rust" value="#A3442C" size="lg" />
        <Swatch color="#4a5a6b" label="Selected" selected />
        <Swatch as="button" color="#171614" label="Button" />
        <Swatch as="button" color="#f6f4ef" label="Pressed" selected />
      </div>
    </div>
  </ThemePair>
  <h3 class="ui-showcase-sub">Astro: data display</h3>
  <div class="ui-showcase-pair">
    {
      (["light", "dark"] as const).map((theme) => (
        <div class="ui-showcase-pair__col" data-theme={theme}>
          <p class="ui-showcase-pair__label">{theme === "light" ? "Light" : "Dark"}</p>
          <div style="display: grid; gap: var(--ui-space-sm)">
            <Panel title="Panel" titleId={`a-panel-${theme}`} description="Boxless work area with a hairline top rule.">
              <Button slot="actions" size="sm" variant="ghost" iconStart="copy">Action</Button>
              <p style="margin: 0">Panel body content.</p>
            </Panel>
            <h4 class="ui-showcase-sub">List / ListRow</h4>
            <List label="Projects">
              <ListRow label="2025" title="Linked row" description="Hover: surface fill, gold arrow." href="#display" meta="Live" />
              <ListRow label="2024" title="Current row" description="Gold marker at the left edge." href="#display" current />
              <ListRow label="2023" title="External row" href="https://example.com" status={{ status: "live", label: "Live" }} />
              <ListRow label="2022" title="Static row with badge" description="No link." badge={{ label: "WIP", tone: "warning" }} />
              <ListRow label="2021" title="Disabled" href="#display" disabled />
              <ListRow title="Mono, icon, actions" description="SHA256:abc123def456" icon="key" mono>
                <IconButton slot="actions" icon="copy" label="Copy" size="sm" />
              </ListRow>
            </List>
            <List density="compact" divided={false} as="ol">
              <ListRow title="Compact, undivided" meta="1" />
              <ListRow title="Second" meta="2" />
            </List>
            <h4 class="ui-showcase-sub">KeyValue</h4>
            <KeyValue
              items={[
                { label: "Host", value: "dmeim.com", mono: true, copy: true },
                { label: "Status", value: "Valid", tone: "success", hint: "Checked just now" },
                { label: "Error", value: "Expired", tone: "danger" },
                { label: "Note", value: "Muted value", tone: "muted" },
              ]}
            />
            <KeyValue layout="grid" items={[{ label: "Width", value: "1200px" }, { label: "Height", value: "630px" }, { label: "Ratio", value: "1.91" }]} />
            <KeyValue layout="inline" items={[{ label: "Words", value: 120 }, { label: "Chars", value: 640 }]} />
            <h4 class="ui-showcase-sub">StatGrid</h4>
            <StatGrid
              items={[
                { label: "Generation", value: 128, size: "lg" },
                { label: "Population", value: "4,096", size: "lg", hint: "cells alive" },
                { label: "Code", value: "404", size: "xl", mono: true },
              ]}
            />
            <h4 class="ui-showcase-sub">Table</h4>
            <Table caption="MIME types" striped>
              <thead><tr><th>Extension</th><th>Type</th><th data-align="end">Size</th></tr></thead>
              <tbody>
                <tr><td data-mono>.png</td><td>image/png</td><td data-align="end">12 KB</td></tr>
                <tr><td data-mono>.svg</td><td>image/svg+xml</td><td data-align="end" data-tone="success">2 KB</td></tr>
                <tr><td data-mono>.exe</td><td>application/octet-stream</td><td data-align="end" data-tone="danger">9 MB</td></tr>
              </tbody>
            </Table>
            <h4 class="ui-showcase-sub">Disclosure</h4>
            <Disclosure summary="Section disclosure" meta="3" defaultOpen>
              <p style="margin: 0">Open by default.</p>
            </Disclosure>
            <Disclosure summary="Inline advanced options" level="inline">
              <p style="margin: 0">Hidden content.</p>
            </Disclosure>
          </div>
        </div>
      ))
    }
  </div>
  <h3 class="ui-showcase-sub">React</h3>
  <DisplayShowcase client:visible />
</section>
