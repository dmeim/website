---
import { ArrowUpRight } from "@lucide/astro";
import { connect } from "../../../../content/site";
import Tile from "../Tile.astro";
---

<Tile
  as="a"
  href={`mailto:${connect.email}`}
  class="bento__contact contact"
  tone="inverse"
  pressable
>
  <span class="eyebrow contact__eyebrow">Contact</span>
  <span class="display contact__title">Have something careful to build?</span>
  <span class="contact__row">
    <span class="contact__email mono">{connect.email}</span>
    <span class="contact__arrow" aria-hidden="true">
      <ArrowUpRight />
    </span>
  </span>
</Tile>

<style>
  :global(.tile.contact) {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    min-height: 220px;
  }

  .contact__eyebrow {
    color: var(--inv-muted);
  }

  .contact__title {
    font-size: clamp(1.45rem, 1.2rem + 0.8vw, 1.8rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .contact__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    margin-top: auto;
    padding-top: var(--s-4);
    border-top: 1px solid var(--inv-border);
  }

  .contact__email {
    overflow: hidden;
    font-size: 13.5px;
    text-overflow: ellipsis;
  }

  .contact__arrow {
    display: grid;
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--gold);
    color: var(--on-gold);
    transition:
      rotate var(--dur) var(--ease-spring),
      scale var(--dur) var(--ease-spring);
  }

  .contact__arrow :global(svg) {
    width: 20px;
    height: 20px;
  }

  :global(.contact:hover) .contact__arrow,
  :global(.contact:focus-visible) .contact__arrow {
    rotate: 45deg;
    scale: 1.06;
  }
</style>
