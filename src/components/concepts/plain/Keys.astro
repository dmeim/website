---
import { keys } from "../../../content/site";
import CopyButton from "./CopyButton.astro";
import SectionHead from "./SectionHead.astro";
---

<section id="keys" class="pl-section pl-container" aria-labelledby="pl-keys-title">
  <SectionHead
    id="pl-keys-title"
    title="Keys"
    intro="Fingerprints to verify what I sign and send."
    link={{ label: "Full keys", href: "/keys" }}
  />

  <ul class="pl-keys" data-reveal-group>
    {
      keys.map((key) => (
        <li class="pl-panel pl-key" data-reveal>
          <div class="pl-key__top">
            <h3>{key.title}</h3>
            <CopyButton value={key.fingerprint} label={`Copy ${key.title} fingerprint`} />
          </div>
          <p class="pl-key__label">Fingerprint</p>
          <p class="pl-key__fp pl-mono">{key.fingerprint}</p>
          <p class="pl-key__usage pl-mono">{key.usage}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .pl-keys {
    display: grid;
    gap: var(--pl-gap);
  }

  .pl-key {
    display: flex;
    flex-direction: column;
  }

  .pl-key__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
  }

  .pl-key h3 {
    font-size: 1.0625rem;
  }

  .pl-key__label {
    color: var(--pl-muted);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .pl-key__fp {
    margin-top: 4px;
    font-size: 0.9375rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .pl-key__usage {
    margin-top: auto;
    padding-top: 20px;
    color: var(--pl-muted);
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
  }

  @media (min-width: 720px) {
    .pl-keys {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
