# Pages stay fresh for a minute so a page prefetched on hover is reused on
# click instead of downloaded again; the asset rules below replace it.
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), fullscreen=(self), screen-wake-lock=(self), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), browsing-topics=()
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
  Cross-Origin-Opener-Policy: same-origin
  Cache-Control: public, max-age=60, stale-while-revalidate=600

/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  ! Cache-Control
  Cache-Control: public, max-age=86400

/*.ico
  ! Cache-Control
  Cache-Control: public, max-age=86400

/*.png
  ! Cache-Control
  Cache-Control: public, max-age=86400

# Readable in a browser instead of downloading as an unknown file type.
/keys/*
  ! Content-Type
  Content-Type: text/plain; charset=utf-8

/manifest.webmanifest
  Content-Type: application/manifest+json
  ! Cache-Control
  Cache-Control: public, max-age=86400
