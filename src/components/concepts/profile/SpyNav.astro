---
/** Section nav with the gliding gold marker (see scroll-spy.ts). */
const items = [
  { key: "now", label: "Now" },
  { key: "work", label: "Work" },
  { key: "tools", label: "Tools" },
  { key: "principles", label: "Principles" },
  { key: "keys", label: "Keys" },
  { key: "contact", label: "Contact" },
];
---

<nav class="p-nav" aria-label="Sections" data-spy-nav>
  <span class="p-nav__marker" aria-hidden="true" data-spy-marker data-visible="false"></span>
  <ul class="p-nav__list" data-spy-list>
    {
      items.map(({ key, label }) => (
        <li>
          <a class="p-nav__link" href={`#${key}`} data-spy-link={key}>
            {label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  import { initScrollSpy } from "./scroll-spy";
  initScrollSpy();
</script>

<style>
  .p-nav {
    position: relative;
  }

  .p-nav__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }

  .p-nav__link {
    display: block;
    padding-block: 0.25rem;
    color: var(--p-muted);
    font-size: 0.875rem;
    text-decoration: none;
  }

  .p-nav__link:hover,
  .p-nav__link[aria-current] {
    color: var(--p-ink);
  }

  .p-nav__marker {
    display: none;
  }

  @media (min-width: 960px) {
    .p-nav__list {
      flex-direction: column;
      gap: 0;
      padding-left: 1rem;
      border-left: 1px solid var(--p-line);
    }

    .p-nav__link {
      padding-block: 0.3125rem;
    }

    .p-nav__marker {
      position: absolute;
      top: 0;
      left: 0;
      z-index: 1;
      display: block;
      width: 2px;
      height: var(--spy-h, 1.5rem);
      margin-left: -0.5px;
      border-radius: 2px;
      background: var(--p-gold);
      transform: translateY(var(--spy-y, 0));
      opacity: 0;
      transition:
        transform 320ms var(--p-ease),
        height 320ms var(--p-ease),
        opacity 200ms var(--p-ease);
    }

    .p-nav__marker[data-visible="true"] {
      opacity: 1;
    }

    .p-nav__marker[data-instant] {
      transition: opacity 200ms var(--p-ease);
    }
  }
</style>
