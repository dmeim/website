---
import { Image } from "astro:assets";
import { ArrowRight } from "@lucide/astro";
import portrait from "../../../../assets/images/photoshoot/gpt-sidelook-transparent.png";
import { hero } from "../../../content/site";
import "./hero.css";

const name = "Dimitri";
const chapters = [
  { n: "01", label: "Profile", href: "#profile" },
  { n: "02", label: "Work", href: "#work" },
  { n: "03", label: "Chapter", href: "#about" },
  { n: "04", label: "Principles", href: "#principles" },
  { n: "05", label: "Keys", href: "#keys" },
];
---

<section class="mg-hero" id="top" data-mg-hero aria-labelledby="mg-hero-title">
  <div class="mg-hero__stage">
    <h1 class="mg-hero__title" id="mg-hero-title" aria-label={name}>
      <span class="mg-hero__word" aria-hidden="true">
        {name.split("").map((char, i) => <span class="mg-hero__char" style={`--i: ${i}`}>{char}</span>)}
      </span>
    </h1>

    <div class="mg-hero__figure">
      <Image
        src={portrait}
        alt="Dimitri in a black suit and tie, glancing to the side"
        widths={[420, 640, 900, 1106]}
        sizes="(min-width: 900px) 44vw, 92vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <div class="mg-hero__intro">
      <p class="mg-label mg-label--gold">{hero.role}</p>
      <p class="mg-hero__sentence">{hero.sentence}</p>
      <div class="mg-hero__actions">
        <a class="mg-btn mg-btn--primary" href="#contact">Get in touch <ArrowRight aria-hidden="true" /></a>
        <a class="mg-btn mg-btn--ghost" href="#work">Selected work</a>
      </div>
    </div>

    <nav class="mg-hero__index" aria-label="On this page">
      <p class="mg-label">Contents</p>
      <ol>
        {
          chapters.map((c) => (
            <li>
              <a class="mg-link mg-link--bare" href={c.href}>
                <span class="mg-label__num">{c.n}</span>
                {c.label}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </div>
</section>

<script>
  import { initHero } from "./hero";
  initHero();
</script>
