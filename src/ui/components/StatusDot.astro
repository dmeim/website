---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"span"> {
  status: "live" | "wip" | "archived" | "idle" | "busy" | "success" | "error";
  pulse?: boolean;
  label?: string;
  labelHidden?: boolean;
}

const { status, pulse, label, labelHidden = false, class: className, ...rest } = Astro.props;
const pulsing = pulse ?? (status === "live" || status === "busy");
const showLabel = Boolean(label) && !labelHidden;
const a11y = showLabel ? {} : { role: "img", "aria-label": label || status };
---

<span class:list={["ui-status-dot", className]} data-status={status} data-pulse={pulsing ? "true" : undefined} {...a11y} {...rest}>
  <span class="ui-status-dot__dot" aria-hidden="true"></span>{showLabel && <span class="ui-status-dot__label">{label}</span>}
</span>
