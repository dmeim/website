---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Badge, Container, List, ListRow, PageHeader, Section } from "@/ui/components";
import { projects } from "../content/site";
import "../components/content-pages/projects.css";

const statusLabel = {
  live: "Live",
  wip: "In progress",
  archived: "Archive",
} as const;
---

<BaseLayout
  title="Projects"
  description="Selected projects and experiments from Dimitri / dmeim."
>
  <Container>
    <PageHeader
      title="Projects"
      lede="Selected builds, case studies, and experiments — some live, some still finding their voice."
    />
    <Section>
      <List label="Projects" class="projects-list">
        {
          projects.map((project) => (
            <ListRow
              id={project.slug}
              title={project.title}
              description={project.summary}
              href={project.href}
              status={{ status: project.status, label: statusLabel[project.status] }}
            >
              <img
                slot="media"
                src={project.image}
                alt=""
                width="480"
                height="300"
                loading="lazy"
                decoding="async"
              />
              <span slot="meta" class="projects-list__tags">
                {project.tags.map((tag) => (
                  <Badge size="sm" variant="outline">{tag}</Badge>
                ))}
              </span>
            </ListRow>
          ))
        }
      </List>
    </Section>
  </Container>
</BaseLayout>
