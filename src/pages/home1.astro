---
/**
 * Concept 1 — "Ledger": Swiss editorial grid. Flat, hairline-structured,
 * typographic. Review-only route; the live homepage is untouched.
 */
import ConceptLayout from "../layouts/ConceptLayout.astro";
import "../components/concepts/ledger/ledger.css";
import Header from "../components/concepts/ledger/Header.astro";
import Hero from "../components/concepts/ledger/Hero.astro";
import Marquee from "../components/concepts/ledger/Marquee.astro";
import Now from "../components/concepts/ledger/Now.astro";
import Work from "../components/concepts/ledger/Work.astro";
import Toolbox from "../components/concepts/ledger/Toolbox.astro";
import Principles from "../components/concepts/ledger/Principles.astro";
import Keys from "../components/concepts/ledger/Keys.astro";
import Contact from "../components/concepts/ledger/Contact.astro";
import SystemPreview from "../components/concepts/ledger/SystemPreview.astro";
import Footer from "../components/concepts/ledger/Footer.astro";
---

<ConceptLayout
  title="Ledger"
  description="Concept 1 for dmeim.com — a flat Swiss editorial grid."
  concept={1}
  fontsHref="https://fonts.googleapis.com/css2?family=Geist:wght@300..700&family=Geist+Mono:wght@400;500&display=swap"
>
  <a class="ledger-skip" href="#main">Skip to content</a>
  <div id="top"></div>
  <Header />
  <main id="main">
    <Hero />
    <Marquee />
    <Now />
    <Work />
    <Toolbox />
    <Principles />
    <Keys />
    <Contact />
    <SystemPreview />
  </main>
  <Footer />
</ConceptLayout>

<style is:global>
  .ledger-skip {
    position: fixed;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 100;
    padding: 0.6rem 0.9rem;
    background: var(--l-ink);
    color: var(--l-ground);
    font-size: var(--l-text-sm);
    transform: translateY(-200%);
  }

  .ledger-skip:focus-visible {
    transform: none;
  }
</style>
