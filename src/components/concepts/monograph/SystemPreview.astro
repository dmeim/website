---
import SystemActions from "./SystemActions.astro";
import SystemFields from "./SystemFields.astro";
import SystemPatterns from "./SystemPatterns.astro";

const swatches = [
  { name: "Ground", token: "--mg-ground" },
  { name: "Surface", token: "--mg-surface" },
  { name: "Ink", token: "--mg-ink" },
  { name: "Muted", token: "--mg-ink-muted" },
  { name: "Gold", token: "--mg-gold" },
  { name: "Band", token: "--mg-band-ground" },
];
---

<section class="mg-system mg-section" id="system" aria-labelledby="mg-system-title">
  <div class="mg-container">
    <header class="mg-system__head" data-reveal-group>
      <div class="mg-section-head">
        <p class="mg-label mg-label--gold" data-reveal><span class="mg-label__num">06</span>System — component preview</p>
        <h2 class="mg-display mg-display--md" id="mg-system-title" data-reveal>The <em>Monograph</em> system</h2>
      </div>
      <p class="mg-lede" data-reveal>
        Two typefaces, six colours, sharp edges and one easing curve. Every control below is the real component in
        both themes, keyboard-reachable with a gold focus ring.
      </p>
    </header>

    <ul class="mg-system__swatches" aria-label="Colour tokens" data-reveal>
      {
        swatches.map((s) => (
          <li>
            <span class="mg-system__chip" style={`background: var(${s.token})`} />
            <span class="mg-label">{s.name}</span>
            <code>{s.token}</code>
          </li>
        ))
      }
    </ul>

    <div class="mg-system__sheet">
      <SystemActions />
      <SystemFields />
      <SystemPatterns />
    </div>
  </div>
</section>

<style>
  .mg-system {
    border-top: 1px solid var(--mg-line);
  }

  .mg-system__head {
    display: grid;
    gap: 24px;
    margin-bottom: clamp(40px, 5vw, 72px);
  }

  .mg-system__head .mg-section-head {
    margin-bottom: 0;
  }

  .mg-system__swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    border-top: 1px solid var(--mg-line);
    border-left: 1px solid var(--mg-line);
    margin-bottom: clamp(16px, 2vw, 24px);
  }

  .mg-system__swatches li {
    display: grid;
    gap: 6px;
    padding: 16px;
    border-right: 1px solid var(--mg-line);
    border-bottom: 1px solid var(--mg-line);
  }

  .mg-system__chip {
    height: 56px;
    margin-bottom: 8px;
    box-shadow: inset 0 0 0 1px var(--mg-line);
  }

  .mg-system__swatches code {
    font-family: var(--mg-font-mono);
    font-size: 0.75rem;
    color: var(--mg-ink-muted);
  }

  .mg-system__sheet {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    border-top: 1px solid var(--mg-line);
    border-left: 1px solid var(--mg-line);
  }

  /* Specimen cells live in child components; the grid lines are drawn here. */
  .mg-system__sheet :global(.mg-spec) {
    display: grid;
    align-content: start;
    gap: 24px;
    padding: clamp(20px, 2.4vw, 36px);
    border-right: 1px solid var(--mg-line);
    border-bottom: 1px solid var(--mg-line);
    min-width: 0;
  }

  .mg-system__sheet :global(.mg-spec--wide) {
    grid-column: 1 / -1;
  }

  .mg-system__sheet :global(.mg-spec__name) {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 12px;
  }

  .mg-system__sheet :global(.mg-spec__row) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
  }

  @media (min-width: 900px) {
    .mg-system__head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
  }
</style>
