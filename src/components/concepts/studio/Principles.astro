---
import { Activity, Eye, FileText, Globe, Quote, ShieldCheck } from "@lucide/astro";
import { mentorQuote, pedagogy } from "../../../content/site";
import SectionHead from "./SectionHead.astro";
import Tile from "./Tile.astro";

const icons = [Eye, ShieldCheck, Globe, Activity, FileText];

// Bodies are lorem placeholders for now; two sentences keep cards even.
const trim = (body: string) => body.split(/(?<=\.)\s/).slice(0, 2).join(" ");
---

<section class="section container principles" id="principles" aria-labelledby="principles-title">
  <SectionHead
    index="02"
    eyebrow="Principles"
    title="How the work gets made."
    id="principles-title"
    lede="Five defaults that shape every interface, key and deployment on this site."
  />

  <ol class="principles__grid" data-reveal-group>
    {
      pedagogy.map((item, i) => {
        const Icon = icons[i % icons.length];
        return (
          <Tile as="li" class="principle">
            <div class="principle__top">
              <span class="principle__icon" aria-hidden="true">
                <Icon />
              </span>
              <span class="principle__num mono">{String(i + 1).padStart(2, "0")}</span>
            </div>
            <h3 class="display principle__title">{item.title}</h3>
            <p class="principle__body">{trim(item.body)}</p>
          </Tile>
        );
      })
    }
  </ol>

  <Tile as="figure" class="quote" tone="alt">
    <span class="quote__mark" aria-hidden="true"><Quote /></span>
    <blockquote class="display quote__text">{mentorQuote.text}</blockquote>
    {mentorQuote.attribution && (
      <figcaption class="quote__by mono">— {mentorQuote.attribution}</figcaption>
    )}
  </Tile>
</section>

<style>
  .principles__grid {
    display: grid;
    gap: var(--s-3);
  }

  @media (min-width: 720px) {
    .principles__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s-4);
    }

    .principles__grid > :global(.principle:last-child) {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1100px) {
    .principles__grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .principles__grid > :global(.principle) {
      grid-column: span 2;
    }

    .principles__grid > :global(.principle:nth-child(n + 4)) {
      grid-column: span 3;
    }
  }

  :global(.tile.principle) {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .principle__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--s-5);
  }

  .principle__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--r-control);
    background: var(--gold-soft);
    color: var(--gold-text);
    transition: rotate var(--dur) var(--ease-spring);
  }

  :global(.principle:hover) .principle__icon {
    rotate: -8deg;
  }

  .principle__icon :global(svg) {
    width: 19px;
    height: 19px;
  }

  .principle__num {
    font-size: 12px;
    color: var(--ink-faint);
  }

  .principle__title {
    font-size: 19px;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .principle__body {
    color: var(--ink-muted);
    font-size: 14.5px;
  }

  :global(.tile.quote) {
    position: relative;
    margin: var(--s-4) 0 0;
    padding: var(--s-8) var(--s-6);
    overflow: hidden;
  }

  @media (min-width: 720px) {
    :global(.tile.quote) {
      padding: var(--s-16) var(--s-12);
    }
  }

  .quote__mark {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: var(--s-6);
    border-radius: 50%;
    background: var(--gold);
    color: var(--on-gold);
  }

  .quote__mark :global(svg) {
    width: 20px;
    height: 20px;
    fill: currentColor;
    stroke-width: 0;
  }

  /* Flat gold disc bleeding off the corner echoes the portrait tile. */
  :global(.tile.quote)::before {
    content: "";
    position: absolute;
    right: -120px;
    bottom: -180px;
    width: 420px;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid color-mix(in oklab, var(--gold) 45%, transparent);
    box-shadow: inset 0 0 0 56px var(--gold-soft);
    pointer-events: none;
  }

  .quote__text {
    position: relative;
    max-width: 32ch;
    font-size: clamp(1.5rem, 1.05rem + 1.9vw, 2.6rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .quote__by {
    position: relative;
    margin-top: var(--s-6);
    font-size: 12.5px;
    color: var(--gold-text);
  }
</style>
