---
/**
 * Ledger button. Renders <a> when `href` is set, otherwise <button>.
 * Variants: primary (solid ink), secondary (hairline frame), ghost (text),
 * icon (square, needs `label` for its accessible name).
 */
import { ArrowRight } from "@lucide/astro";
import type { HTMLAttributes } from "astro/types";

type Variant = "primary" | "secondary" | "ghost" | "icon";

interface Props {
  variant?: Variant;
  href?: string;
  label?: string;
  arrow?: boolean;
  disabled?: boolean;
  size?: "md" | "sm";
  type?: "button" | "submit";
  class?: string;
  external?: boolean;
  attrs?: HTMLAttributes<"button">;
}

const {
  variant = "primary",
  href,
  label,
  arrow = false,
  disabled = false,
  size = "md",
  type = "button",
  class: className,
  external = false,
  attrs = {},
} = Astro.props;

const classes = ["btn", `btn--${variant}`, `btn--${size}`, className];
const iconLabel = variant === "icon" ? label : undefined;
---

{
  href && !disabled ? (
    <a
      class:list={classes}
      href={href}
      aria-label={iconLabel}
      target={external ? "_blank" : undefined}
      rel={external ? "noopener noreferrer" : undefined}
    >
      <slot />
      {arrow && <ArrowRight class="btn__arrow" size={16} stroke-width={1.75} aria-hidden="true" />}
    </a>
  ) : (
    <button class:list={classes} type={type} disabled={disabled} aria-label={iconLabel} {...attrs}>
      <slot />
      {arrow && <ArrowRight class="btn__arrow" size={16} stroke-width={1.75} aria-hidden="true" />}
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-height: 3rem;
    padding: 0 1.25rem;
    border: 1px solid transparent;
    border-radius: var(--l-radius);
    background: none;
    font-size: var(--l-text-sm);
    font-weight: 500;
    letter-spacing: -0.005em;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--l-dur-fast) var(--l-ease),
      border-color var(--l-dur-fast) var(--l-ease),
      color var(--l-dur-fast) var(--l-ease);
  }

  .btn--sm {
    min-height: 2.5rem;
    padding: 0 1rem;
    font-size: var(--l-text-xs);
  }

  .btn :global(.btn__arrow) {
    flex: none;
    transition: transform var(--l-dur) var(--l-ease);
  }

  .btn:hover :global(.btn__arrow),
  .btn:focus-visible :global(.btn__arrow) {
    transform: translateX(4px);
  }

  .btn--primary {
    background: var(--l-ink);
    color: var(--l-ground);
  }

  .btn--primary:hover {
    background: color-mix(in srgb, var(--l-ink) 86%, var(--l-gold));
  }

  .btn--secondary {
    border-color: var(--l-line-strong);
    color: var(--l-ink);
  }

  .btn--secondary:hover {
    border-color: var(--l-ink);
    background: var(--l-surface);
  }

  .btn--ghost {
    padding-inline: 0.25rem;
    color: var(--l-ink);
  }

  .btn--ghost:hover {
    color: var(--l-gold-ink);
  }

  .btn--icon {
    width: 3rem;
    padding: 0;
    border-color: var(--l-line-strong);
  }

  .btn--icon.btn--sm {
    width: 2.5rem;
  }

  .btn--icon:hover {
    background: var(--l-surface);
    border-color: var(--l-ink);
  }

  .btn:disabled {
    background: transparent;
    border-color: var(--l-line);
    border-style: dashed;
    color: var(--l-ink-muted);
    cursor: not-allowed;
  }
</style>
