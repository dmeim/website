---
import { ChevronDown } from "@lucide/astro";
import "./system-fields.css";
---

<div class="mg-spec">
  <p class="mg-spec__name mg-label"><span>Text fields</span><span>.mg-field</span></p>
  <div class="mg-field">
    <label class="mg-field__label" for="mg-sys-name">Name</label>
    <input class="mg-field__control" id="mg-sys-name" type="text" placeholder="Your name" aria-describedby="mg-sys-name-hint" />
    <p class="mg-field__hint" id="mg-sys-name-hint">As you'd like to be addressed.</p>
  </div>
  <div class="mg-field" data-invalid>
    <label class="mg-field__label" for="mg-sys-email">Email</label>
    <input
      class="mg-field__control"
      id="mg-sys-email"
      type="email"
      value="hello@dmeim"
      aria-invalid="true"
      aria-describedby="mg-sys-email-error"
    />
    <p class="mg-field__error" id="mg-sys-email-error">Add the domain ending, e.g. name@example.com.</p>
  </div>
</div>

<div class="mg-spec">
  <p class="mg-spec__name mg-label"><span>Textarea &amp; select</span><span>.mg-field</span></p>
  <div class="mg-field">
    <label class="mg-field__label" for="mg-sys-topic">Topic</label>
    <div class="mg-field__select">
      <select class="mg-field__control" id="mg-sys-topic">
        <option>Collaboration</option>
        <option>Key verification</option>
        <option>Just saying hello</option>
      </select>
      <ChevronDown aria-hidden="true" />
    </div>
  </div>
  <div class="mg-field">
    <label class="mg-field__label" for="mg-sys-msg">Message</label>
    <textarea class="mg-field__control" id="mg-sys-msg" rows="3" placeholder="A few lines is plenty."></textarea>
  </div>
</div>

<div class="mg-spec">
  <p class="mg-spec__name mg-label"><span>Choice</span><span>.mg-check · .mg-switch · .mg-seg</span></p>
  <label class="mg-check">
    <input type="checkbox" checked />
    <span>Send me a copy</span>
  </label>
  <label class="mg-check">
    <input type="checkbox" class="mg-switch" role="switch" />
    <span>Notify me about new tools</span>
  </label>
  <fieldset class="mg-seg">
    <legend class="mg-sr-only">Project filter</legend>
    <span class="mg-seg__indicator" aria-hidden="true"></span>
    <label><input type="radio" name="mg-sys-seg" checked /><span>All</span></label>
    <label><input type="radio" name="mg-sys-seg" /><span>Live</span></label>
    <label><input type="radio" name="mg-sys-seg" /><span>Archive</span></label>
  </fieldset>
</div>
