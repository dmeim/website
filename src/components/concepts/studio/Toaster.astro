---
import { CircleCheck, X } from "@lucide/astro";
---

<section class="toaster" aria-label="Notifications">
  <ol class="toaster__list" role="status" aria-live="polite" data-toast-region></ol>
</section>

<template data-toast-template>
  <li class="toast">
    <CircleCheck class="toast__icon" aria-hidden="true" />
    <div class="toast__text">
      <p class="toast__title" data-toast-title></p>
      <p class="toast__body" data-toast-body></p>
    </div>
    <button type="button" class="toast__close" aria-label="Dismiss notification" data-toast-close>
      <X aria-hidden="true" />
    </button>
  </li>
</template>

<style is:global>
  .toaster {
    position: fixed;
    left: 50%;
    bottom: 76px;
    z-index: 60;
    width: min(380px, calc(100vw - 32px));
    translate: -50% 0;
    pointer-events: none;
  }

  @media (min-width: 720px) {
    .toaster {
      bottom: 24px;
    }
  }

  .toaster__list {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .toast {
    display: flex;
    align-items: flex-start;
    gap: var(--s-3);
    padding: 14px 12px 14px 16px;
    border: 1px solid var(--inv-border);
    border-radius: 16px;
    background: var(--inv-bg);
    color: var(--inv-fg);
    box-shadow: var(--elev);
    pointer-events: auto;
    opacity: 0;
    translate: 0 16px;
    scale: 0.96;
    transition:
      opacity var(--dur) var(--ease),
      translate var(--dur-slow) var(--ease-spring),
      scale var(--dur) var(--ease);
  }

  .toast[data-state="open"] {
    opacity: 1;
    translate: 0 0;
    scale: 1;
  }

  .toast[data-state="leaving"] {
    opacity: 0;
    translate: 0 8px;
    scale: 0.97;
    transition-duration: var(--dur-fast);
  }

  .toast__icon {
    width: 18px;
    height: 18px;
    margin-top: 1px;
    flex: none;
    color: var(--gold);
  }

  .toast__text {
    flex: 1;
    min-width: 0;
  }

  .toast__title {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.35;
  }

  .toast__body {
    margin-top: 2px;
    font-size: 13px;
    color: var(--inv-muted);
    overflow-wrap: anywhere;
  }

  .toast__close {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    flex: none;
    border-radius: 8px;
    color: var(--inv-muted);
    transition:
      background-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .toast__close:hover {
    background: var(--inv-border);
    color: var(--inv-fg);
  }

  .toast__close svg {
    width: 15px;
    height: 15px;
  }
</style>
