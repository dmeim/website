---
import { Menu, X } from "@lucide/astro";
import SearchButton from "./SearchButton.astro";
import ThemeSwitch from "./ThemeSwitch.astro";
import { navLinks } from "./nav";
---

<header class="header" data-header>
  <div class="container header__inner">
    <a class="wordmark" href="#top" aria-label="dmeim — back to top">
      <span class="wordmark__mark" aria-hidden="true"></span>
      <span class="wordmark__text">dmeim</span>
    </a>

    <nav class="nav" aria-label="Primary" data-nav>
      <span class="nav__indicator" aria-hidden="true" data-nav-indicator></span>
      {
        navLinks.map((link) => (
          <a class="nav__link" href={link.href}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="header__actions">
      <SearchButton />
      <ThemeSwitch />
      <button
        type="button"
        class="btn btn--ghost btn--icon menu-btn"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Menu"
        data-menu-toggle
      >
        <Menu class="menu-btn__open" aria-hidden="true" />
        <X class="menu-btn__close" aria-hidden="true" />
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" data-mobile-nav hidden>
    <nav class="container" aria-label="Primary (mobile)">
      <ul class="mobile-nav__list">
        {
          navLinks.map((link) => (
            <li>
              <a class="mobile-nav__link" href={link.href}>
                <span>{link.label}</span>
                <span class="mono muted">{link.href}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  import { initHeader } from "./scripts/header";
  initHeader();
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .header[data-scrolled] {
    background: var(--header-bg);
    border-bottom-color: var(--border);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--s-6);
    height: var(--header-h);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border-radius: 8px;
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .wordmark__mark {
    position: relative;
    width: 22px;
    height: 22px;
    border-radius: 7px;
    background: var(--ink);
    overflow: hidden;
  }

  .wordmark__mark::after {
    content: "";
    position: absolute;
    right: -6px;
    bottom: -6px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--gold);
    transition: translate var(--dur-slow) var(--ease-spring);
  }

  .wordmark:hover .wordmark__mark::after {
    translate: -3px -3px;
  }

  .nav {
    position: relative;
    display: none;
    align-items: center;
    gap: 2px;
    isolation: isolate;
  }

  .nav__indicator {
    position: absolute;
    top: 0;
    left: 0;
    z-index: -1;
    height: 100%;
    width: var(--w, 0);
    translate: var(--x, 0) 0;
    border-radius: var(--r-pill);
    background: var(--tile-alt);
    opacity: 0;
    transition:
      translate var(--dur) var(--ease),
      width var(--dur) var(--ease),
      opacity var(--dur-fast) var(--ease);
  }

  .nav__indicator[data-visible="true"] {
    opacity: 1;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    height: 34px;
    padding: 0 14px;
    border-radius: var(--r-pill);
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-muted);
    transition: color var(--dur-fast) var(--ease);
  }

  .nav__link:hover,
  .nav__link:focus-visible {
    color: var(--ink);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin-left: auto;
  }

  .menu-btn {
    --btn-h: 38px;
  }

  .menu-btn :global(.menu-btn__close),
  .menu-btn[aria-expanded="true"] :global(.menu-btn__open) {
    display: none;
  }

  .menu-btn[aria-expanded="true"] :global(.menu-btn__close) {
    display: block;
  }

  .mobile-nav {
    border-top: 1px solid var(--border);
    background: var(--ground);
    opacity: 0;
    translate: 0 -6px;
    transition:
      opacity var(--dur) var(--ease),
      translate var(--dur) var(--ease);
  }

  .mobile-nav[data-open] {
    opacity: 1;
    translate: 0 0;
  }

  .mobile-nav__list {
    display: grid;
    padding-block: var(--s-3) var(--s-5);
  }

  .mobile-nav__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 4px;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .mobile-nav__link .mono {
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0;
  }

  @media (min-width: 860px) {
    .nav {
      display: flex;
    }

    .menu-btn,
    .mobile-nav {
      display: none;
    }

    .header__actions {
      gap: var(--s-3);
    }
  }
</style>
