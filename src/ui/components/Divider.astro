---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  orientation?: "horizontal" | "vertical";
  label?: string;
}

const { orientation = "horizontal", label, class: className, ...rest } = Astro.props;
const classes = ["ui-divider", className];
---

{
  label ? (
    <div class:list={classes} role="separator" aria-label={label} data-orientation={orientation} data-labelled {...rest}>
      <span class="ui-divider__label" aria-hidden="true">{label}</span>
    </div>
  ) : orientation === "vertical" ? (
    <div class:list={classes} role="separator" aria-orientation="vertical" data-orientation="vertical" {...rest} />
  ) : (
    <hr class:list={classes} data-orientation="horizontal" {...rest} />
  )
}
